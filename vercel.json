{
    "headers": [
        {
            "source": "/ads.txt",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "text/plain; charset=utf-8"
                },
                {
                    "key": "Access-Control-Allow-Origin",
                    "value": "*"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=3600"
                }
            ]
        },
        {
            "source": "/sitemap.xml",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/xml; charset=utf-8"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=3600"
                }
            ]
        }
    ],
    "redirects": [
        {
            "source": "/navilgal/writings",
            "destination": "/writings",
            "permanent": true
        },
        {
            "source": "/navilgal/writings/:path*",
            "destination": "/writings/:path*",
            "permanent": true
        },
        {
            "source": "/navilgal/ezhutgal",
            "destination": "/writings",
            "permanent": true
        },
        {
            "source": "/navilgal/ezhutgal/:path*",
            "destination": "/writings/:path*",
            "permanent": true
        },
        {
            "source": "/navilgal/ezhuthugal",
            "destination": "/writings",
            "permanent": true
        },
        {
            "source": "/navilgal/ezhuthugal/:path*",
            "destination": "/writings/:path*",
            "permanent": true
        },
        {
            "source": "/navilgal/arts",
            "destination": "/arts",
            "permanent": true
        },
        {
            "source": "/navilgal/arts/:path*",
            "destination": "/arts/:path*",
            "permanent": true
        },
        {
            "source": "/navilgal/padaippugal",
            "destination": "/arts",
            "permanent": true
        },
        {
            "source": "/navilgal/padaippugal/:path*",
            "destination": "/arts/:path*",
            "permanent": true
        },
        {
            "source": "/privacy-policy",
            "destination": "/privacy",
            "permanent": true
        },
        {
            "source": "/terms-and-conditions",
            "destination": "/terms",
            "permanent": true
        },
        {
            "source": "/tools/teaching",
            "destination": "/teaching",
            "permanent": true
        },
        {
            "source": "/teaching/vocoder",
            "destination": "/tools/vocoder",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/nirvaagi/(.*)",
            "destination": "/nirvaagi/index.html"
        }
    ]
}
