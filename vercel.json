{
    "cleanUrls": true,
    "headers": [
        {
            "source": "/ads.txt",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "text/plain; charset=utf-8"
                },
                {
                    "key": "Access-Control-Allow-Origin",
                    "value": "*"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=3600"
                }
            ]
        },
        {
            "source": "/sitemap.xml",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/xml; charset=utf-8"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=3600"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/nirvaagi(.*)",
            "destination": "/nirvaagi.html"
        },
        {
            "source": "/downloads/nammil",
            "destination": "/downloads-nammil.html"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}