---
import { UI_TA, UI_EN } from '../../i18n';
---

<footer class="global-site-footer">
  <p class="global-footer-copy">
    © 2026 <span data-ui-en="brand.name">{UI_EN.brand.name}</span><span class="footer-brand-ta"> (<span data-ui-ta="brand.name">{UI_TA.brand.name}</span>)</span> • Independent Bilingual Digital Creation Studio
  </p>
  <nav class="global-footer-links" aria-label="Footer navigation">
    <a href="/" data-ui-pair="footer.home" data-ui-sep=" / ">{UI_TA.footer.home} / {UI_EN.footer.home}</a>
    <a href="/writings" data-ui-pair="footer.writings" data-ui-sep=" / ">{UI_TA.footer.writings} / {UI_EN.footer.writings}</a>
    <a href="/arts" data-ui-pair="footer.arts" data-ui-sep=" / ">{UI_TA.footer.arts} / {UI_EN.footer.arts}</a>
    <a href="/tools" data-ui-pair="footer.tools" data-ui-sep=" / ">{UI_TA.footer.tools} / {UI_EN.footer.tools}</a>
    <a href="/downloads/nammil" data-ui-pair="footer.nammil" data-ui-sep=" / ">{UI_TA.footer.nammil} / {UI_EN.footer.nammil}</a>
    <a href="/about" data-ui-pair="footer.about" data-ui-sep=" / ">{UI_TA.footer.about} / {UI_EN.footer.about}</a>
    <a href="/contact" data-ui-pair="footer.contact" data-ui-sep=" / ">{UI_TA.footer.contact} / {UI_EN.footer.contact}</a>
    <a href="/privacy" data-ui-pair="footer.privacy" data-ui-sep=" / ">{UI_TA.footer.privacy} / {UI_EN.footer.privacy}</a>
    <a href="/terms" data-ui-pair="footer.terms" data-ui-sep=" / ">{UI_TA.footer.terms} / {UI_EN.footer.terms}</a>
    <a href="/disclaimer" data-ui-pair="footer.disclaimer" data-ui-sep=" / ">{UI_TA.footer.disclaimer} / {UI_EN.footer.disclaimer}</a>
  </nav>
</footer>

<style>
  .global-site-footer {
    margin-top: 64px;
    padding: 28px 20px 24px;
    border-top: 1px solid var(--border-light);
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-muted);
    max-width: 1200px;
    margin-inline: auto;
  }
  .global-footer-copy {
    margin: 0 0 12px;
    font-weight: 600;
    color: var(--text-main);
    opacity: 0.8;
  }
  .global-footer-links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px 18px;
  }
  .global-footer-links a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .global-footer-links a:hover {
    color: var(--text-main);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
