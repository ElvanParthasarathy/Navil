---
interface Props {
  slot?: string;
  margin?: string;
  label?: string;
}

const { slot = '1749945992', margin = '48px 0', label = 'Advertisement' } = Astro.props;
---

<aside class="elvan-ad-slot-wrapper" style={`--ad-margin: ${margin};`} aria-label={label}>
  <div class="elvan-ad-slot-inner">
    <ins
      class="adsbygoogle"
      style="display:block; width:100%;"
      data-ad-client="ca-pub-5392072917035799"
      data-ad-slot={slot}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
  </div>
</aside>

<style>
  /* Keep width measurable for AdSense push while collapsing unfilled/pending slots */
  .elvan-ad-slot-wrapper {
    width: 100%;
    max-width: 100%;
    display: block;
    clear: both;
    margin: 0;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
    transition: max-height 0.25s ease, opacity 0.25s ease, margin 0.25s ease;
  }
  .elvan-ad-slot-wrapper:has(ins.adsbygoogle[data-ad-status="filled"]) {
    margin: var(--ad-margin, 24px auto);
    max-height: 600px;
    opacity: 1;
    overflow: visible;
    pointer-events: auto;
  }
  .elvan-ad-slot-inner {
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
    background: transparent;
  }
  .elvan-ad-slot-wrapper:has(ins.adsbygoogle[data-ad-status="unfilled"]),
  ins.adsbygoogle[data-ad-status="unfilled"] {
    display: none !important;
  }
</style>
