---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="தொகுப்பு | Portfolio — Elvan Navil"
  description="Selected works and ongoing experiments by Elvan Parthasarathy."
  canonicalPath="/portfolio"
  mobileTitle="தொகுப்பு|portfolio"
  noindex={true}
  includeAdsense={false}
  backUrl="/"
>
  <div class="page-view" style="max-width: 1200px; margin: 0 auto; padding: 10px 20px 40px;">
    <div style="margin-bottom: 24px;">
      <h1 class="title">Portfolio</h1>
      <h2 class="subtitle">Selected works and ongoing experiments.</h2>
    </div>
    <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 48px 20px; background: var(--bg-card); border: 1px solid var(--border-light); border-radius: 24px;">
      <div style="font-size: 3rem; margin-bottom: 16px;">📦</div>
      <div style="font-size: 1.4rem; font-weight: 800; color: var(--text-main); margin-bottom: 8px;">Building Something Cool</div>
      <p style="font-size: 0.95rem; color: var(--text-muted); max-width: 420px; line-height: 1.6; margin: 0;">
        I am currently documenting my projects and case studies. Check back soon to see what I've been working on.
      </p>
    </div>
  </div>
</BaseLayout>
