---
import '../../சிறப்புக்கூறுகள்/படைப்புகள்/படைப்புகள்.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdUnit from '../../components/astro/AdUnit.astro';
import Icon from '../../components/astro/Icon.astro';
import { getActiveWritingCategories } from '../../lib/content';
import type { IconName } from '../../lib/icons';

const categories = await getActiveWritingCategories();

const CATEGORY_ICONS: Record<string, IconName> = {
  poems: 'Pen',
  quotes: 'ChatCircleText',
  blog: 'PencilSimpleLine',
  articles: 'Newspaper',
  stories: 'BookOpen',
  diary: 'MoonStars',
};
---

<BaseLayout
  title="எழுத்துகள் | Writings & Literature — Elvan Navil"
  description="Bilingual literary catalog of original Tamil and English poems, quotes, short stories, essays, and articles by Elvan Parthasarathy."
  canonicalPath="/writings"
  mobileTitle="எழுத்துகள்|writings"
  backUrl="/navilgal"
>
  <div class="writings-page page-view fadeIn">
    <header class="writings-header animate-entry">
      <div style="flex: 1;">
        <h1 class="writings-title">எழுத்துகள்</h1>
        <div class="writings-title-sub">Writings</div>
        <p class="writings-subtitle">சிந்தனைகள், கதைகள் &amp; பட்டறிவுகள்</p>
        <p class="writings-subtitle writings-subtitle-en">Thoughts, Stories &amp; Observations</p>
      </div>
    </header>

    <div class="category-grid animate-entry">
      {categories.map((cat) => (
        <a href={`/writings/${cat.key}`} class="category-card">
          <div class="cat-icon-box">
            <Icon name={CATEGORY_ICONS[cat.key] || 'Pen'} weight="regular" />
          </div>
          <div class="cat-content">
            <div class="cat-title" lang="ta">
              {cat.titleTa}
              <span class="cat-count-badge">{cat.count}</span>
            </div>
            <div class="cat-title-sub">{cat.titleEn}</div>
            <p class="cat-desc" lang="ta">{cat.descTa}</p>
            <p class="cat-desc-sub">{cat.descEn}</p>
          </div>
          <div class="cat-footer">
            {cat.footerTa} <Icon name="ArrowRight" weight="regular" />
          </div>
        </a>
      ))}
    </div>

    <AdUnit margin="48px 0 0" />
  </div>
</BaseLayout>
