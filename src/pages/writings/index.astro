---
import '../../சிறப்புக்கூறுகள்/படைப்புகள்/படைப்புகள்.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdUnit from '../../components/astro/AdUnit.astro';
import Icon from '../../components/astro/Icon.astro';
import { getActiveWritingCategories } from '../../lib/content';
import type { IconName } from '../../lib/icons';
import { UI_TA, UI_EN } from '../../i18n';

const categories = await getActiveWritingCategories();

const CATEGORY_ICONS: Record<string, IconName> = {
  poems: 'Pen',
  quotes: 'ChatCircleText',
  blog: 'PencilSimpleLine',
  articles: 'Newspaper',
  stories: 'BookOpen',
  diary: 'MoonStars',
};
---

<BaseLayout
  title={`${UI_TA.writings.title} | ${UI_EN.writings.title} — ${UI_EN.brand.name}`}
  description="Bilingual literary catalog of original Tamil and English poems, quotes, short stories, essays, and articles by Elvan Parthasarathy."
  canonicalPath="/writings"
  mobileTitle={`${UI_TA.routes.writings.title}|${UI_EN.routes.writings.title}`}
  backUrl="/navilgal"
>
  <div class="writings-page page-view fadeIn">
    <header class="writings-header animate-entry">
      <div style="flex: 1;">
        <h1 class="writings-title" data-ui-ta="writings.title">{UI_TA.writings.title}</h1>
        <div class="writings-title-sub" data-ui-en="writings.title">{UI_EN.writings.title}</div>
        <p class="writings-subtitle" data-ui-ta="writings.subtitle">{UI_TA.writings.subtitle}</p>
        <p class="writings-subtitle writings-subtitle-en" data-ui-en="writings.subtitle">{UI_EN.writings.subtitle}</p>
      </div>
    </header>

    <div class="category-grid animate-entry">
      {categories.map((cat) => (
        <a href={`/writings/${cat.key}`} class="category-card">
          <div class="cat-icon-box">
            <Icon name={CATEGORY_ICONS[cat.key] || 'Pen'} weight="regular" />
          </div>
          <div class="cat-content">
            <div class="cat-title" lang="ta">
              <span data-ui-ta={`writingCategories.${cat.key}.title`}>{cat.titleTa}</span>
              <span class="cat-count-badge">{cat.count}</span>
            </div>
            <div class="cat-title-sub" data-ui-en={`writingCategories.${cat.key}.title`}>{cat.titleEn}</div>
            <p class="cat-desc" lang="ta" data-ui-ta={`writingCategories.${cat.key}.desc`}>{cat.descTa}</p>
            <p class="cat-desc-sub" data-ui-en={`writingCategories.${cat.key}.desc`}>{cat.descEn}</p>
          </div>
          <div class="cat-footer">
            <span data-ui-ta={`writingCategories.${cat.key}.footer`}>{cat.footerTa}</span> <Icon name="ArrowRight" weight="regular" />
          </div>
        </a>
      ))}
    </div>

    <AdUnit margin="48px 0 0" />
  </div>
</BaseLayout>
