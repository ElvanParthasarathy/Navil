---
import '../../../../சிறப்புக்கூறுகள்/படைப்புகள்/படைப்புகள்.css';
import '../../../../சிறப்புக்கூறுகள்/படைப்புகள்/பார்வைகள்/கதைகள்பட்டியல்.css';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import AdUnit from '../../../../components/astro/AdUnit.astro';
import { getStoriesGrouped, getPrimaryTitle, getPrimaryExcerpt, getPostTags } from '../../../../lib/content';
import { getOptimizedImage } from '../../../../நூலகம்/ஊடகம்';

export async function getStaticPaths() {
  const { seriesMap } = await getStoriesGrouped();
  const paths: any[] = [];
  seriesMap.forEach((parts, seriesName) => {
    const sorted = [...parts].sort((a, b) => (a.series_part || 0) - (b.series_part || 0));
    paths.push({
      params: { seriesId: seriesName },
      props: { seriesName, parts: sorted },
    });
  });
  return paths;
}

const { seriesName, parts } = Astro.props;
const firstPart = parts[0];
const coverRaw = parts.find((p: any) => p.cover_image)?.cover_image || null;
const cover = coverRaw ? getOptimizedImage(coverRaw, 'medium') : null;
const classification = parts.find((p: any) => p.classification)?.classification || null;
const genreSet = new Set<string>();
parts.forEach((p: any) => getPostTags(p).forEach((g) => genreSet.add(g)));
const genres = Array.from(genreSet);
const synopsis = getPrimaryExcerpt(firstPart, 220);
---

<BaseLayout
  title={`${seriesName} | Short Stories — Elvan Navil`}
  description={`${seriesName} (${parts.length} episodes): ${synopsis}`}
  canonicalPath={`/writings/stories/series/${encodeURIComponent(seriesName)}`}
  mobileTitle={seriesName}
  backUrl="/writings/stories"
>
  <div class="page-view animate-entry" style="width: 100%; padding: 0 0 60px;">
    {cover && (
      <div class="tv-hero-bg">
        <img src={cover} alt="" />
        <div class="tv-hero-bg-overlay"></div>
      </div>
    )}

    <div class="tv-container">
      <div class="tv-hero-section">
        <div class="tv-hero-left">
          <div class="tv-hero-cover-wrapper">
            {cover ? (
              <img src={cover} alt={seriesName} />
            ) : (
              <div class="tv-cover-placeholder">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.8" aria-hidden="true">
                  <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                  <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
                </svg>
              </div>
            )}
          </div>
        </div>

        <div class="tv-hero-right">
          <h1 class="tv-series-title">{seriesName}</h1>
          <div class="tv-meta-row">
            <span class="tv-ep-count-badge">{parts.length} அத்தியாயங்கள்</span>
            {classification && (
              <span class={`tv-class-badge ${classification === 'அகம்' ? 'agam' : classification === 'புறம்' ? 'puram' : ''}`}>
                {classification}
              </span>
            )}
            {genres.slice(0, 3).map((g) => <span class="tv-genre-badge">{g}</span>)}
          </div>
          {synopsis && <p class="tv-synopsis">{synopsis}</p>}
          <div class="tv-actions">
            <a href={`/writings/stories/${encodeURIComponent(firstPart.slug)}`} class="tv-primary-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="margin-top: 2px;" aria-hidden="true">
                <polygon points="5 3 19 12 5 21 5 3" />
              </svg>
              <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 0; line-height: 1.2;">
                <span style="font-size: 1em;">வாசிக்கத் தொடங்கு</span>
                <span style="font-size: 0.7em; opacity: 0.7; font-weight: 500; letter-spacing: 0.2px;">Start reading (Part 1)</span>
              </div>
            </a>
          </div>
        </div>
      </div>

      <section class="tv-episodes-section">
        <div style="margin-bottom: 24px; padding-bottom: 12px; border-bottom: 1px solid var(--border-light); padding-left: 24px;">
          <h2 class="tv-section-title" style="margin-bottom: 4px; padding-bottom: 0; border-bottom: none;">அத்தியாயங்கள்</h2>
          <span style="font-size: 0.95em; opacity: 0.6; font-weight: 500; letter-spacing: 0.5px;">chapters</span>
        </div>
        <div class="tv-episodes-grid">
          {parts.map((part: any, idx: number) => {
            const pTitle = getPrimaryTitle(part, 'stories');
            const pExcerpt = getPrimaryExcerpt(part, 150);
            const pDate = part.publish_date || part.date;
            const partNumStr = String(part.series_part || idx + 1).padStart(2, '0');
            return (
              <a href={`/writings/stories/${encodeURIComponent(part.slug)}`} class="tv-ep-card">
                <div class="tv-ep-number-bg">{partNumStr}</div>
                <div class="tv-ep-card-body">
                  <div class="tv-ep-meta">
                    <span class="tv-ep-num-pill">பகுதி {part.series_part || idx + 1}</span>
                    {pDate && (
                      <span class="tv-ep-date">
                        {new Date(pDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}
                      </span>
                    )}
                  </div>
                  <h3 class="tv-ep-title">{pTitle}</h3>
                  {pExcerpt && <p class="tv-ep-excerpt">{pExcerpt}</p>}
                  <div class="tv-ep-footer">
                    <span>வாசிக்கத் தொடங்கு</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                      <polyline points="9 18 15 12 9 6" />
                    </svg>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </section>

      <AdUnit margin="48px 0 0" />
    </div>
  </div>
</BaseLayout>

<style>
  .tv-ep-title { font-weight: 700; color: var(--text-main); margin: 0 0 8px; }
  .tv-ep-excerpt { font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; margin: 0; }
</style>
