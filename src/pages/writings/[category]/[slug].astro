---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdUnit from '../../../components/astro/AdUnit.astro';
import Icon from '../../../components/astro/Icon.astro';
import EngagementIsland from '../../../components/islands/EngagementIsland';
import {
  ALL_WRITING_CATEGORIES,
  CATEGORY_META,
  BASE_URL,
  getCategoryPosts,
  getPrimaryTitle,
  getPrimaryExcerpt,
  getPostTags,
  textToHtml,
  type WritingItem,
} from '../../../lib/content';
import { getOptimizedImage } from '../../../நூலகம்/ஊடகம்';
import {
  transliterate,
  capitalizeWords,
  capitalizeWordsHtml,
} from '../../../சிறப்புக்கூறுகள்/கருவிகள்/மொழிமாற்றி/பயன்பாடுகள்/மொழிமாற்றம்';

export async function getStaticPaths() {
  const paths: any[] = [];
  for (const cat of ALL_WRITING_CATEGORIES) {
    const posts = await getCategoryPosts(cat);
    for (const post of posts) {
      paths.push({
        params: { category: cat, slug: post.slug },
        props: { category: cat, post, allPosts: posts },
      });
    }
  }
  return paths;
}

const { category, post, allPosts } = Astro.props as {
  category: string;
  post: WritingItem;
  allPosts: WritingItem[];
};

const meta = CATEGORY_META[category];
const isStory = category === 'stories';
const isMinimal = category === 'thoughts';
const variants = post.variants || [];
const contentObj = post.content || {};
const hasVariants = variants.length > 0;
const primaryTitle = getPrimaryTitle(post, category);
const description = getPrimaryExcerpt(post, 160) || `${primaryTitle} — ${meta.titleEn} by Elvan Parthasarathy.`;
const coverImg = post.cover_image ? getOptimizedImage(post.cover_image, 'medium') : null;
const tags = getPostTags(post);

const LANG_LABELS: Record<string, string> = {
  ta: 'தமிழ்',
  en: 'English',
  ml: 'മലയാളം',
  hi: 'Hindi',
  te: 'Telugu',
  sa: 'Sanskrit',
};
const TRANSL_LABELS: Record<string, string> = {
  en: 'Aa',
  ta: 'த',
  ml: 'മ',
  hi: 'हि',
  te: 'తె',
  sa: 'सं',
};
const INDIC_LANGS = ['ta', 'ml', 'hi', 'sa', 'te'];

function transliterateHtmlContent(html: string): string {
  if (!html) return '';
  const tr = html.replace(/(<[^>]+>)|([^<]+)/g, (_m, tag, text) => {
    if (tag) return tag;
    return transliterate(text);
  });
  return capitalizeWordsHtml(tr);
}

// Precompute variants + their transliteration alternatives at build time
const preparedVariants = variants.map((v, vIndex) => {
  const translObj = v.transliterations || {};
  const translKeys = Object.keys(translObj).filter((k) => Boolean(translObj[k]));
  const isIndic = INDIC_LANGS.includes(v.lang || '');
  const sortedKeys =
    v.lang === 'ml'
      ? ['ta', 'en', ...translKeys.filter((k) => k !== 'ta' && k !== 'en')].filter((k) =>
          translKeys.includes(k)
        )
      : ['en', ...translKeys.filter((k) => k !== 'en')];

  const baseTitle = v.title || post.title || '';
  const baseBodyHtml = textToHtml(v.text) || '<p>No content available.</p>';
  const alternatives: Record<
    string,
    { label: string; title: string; author: string; html: string; lang: string; isBeta?: boolean }
  > = {};

  if (isIndic) {
    sortedKeys.forEach((tLang) => {
      alternatives[tLang] = {
        label: TRANSL_LABELS[tLang] || tLang,
        title: v.titleTransliterations?.[tLang] || post.titleTransliterations?.[tLang] || baseTitle,
        author: v.authorTransliterations?.[tLang] || v.author || '',
        html: textToHtml(translObj[tLang]),
        lang: tLang,
      };
    });
  }

  if (['poems', 'quotes'].includes(category) && v.lang === 'ta') {
    alternatives.navil = {
      label: 'Navil',
      isBeta: true,
      title: capitalizeWords(transliterate(baseTitle)),
      author: v.author ? capitalizeWords(transliterate(v.author)) : '',
      html: transliterateHtmlContent(baseBodyHtml),
      lang: 'en',
    };
  }

  return {
    vIndex,
    lang: v.lang || 'ta',
    label: v.label || '',
    author: v.author || '',
    title: baseTitle,
    bodyHtml: baseBodyHtml,
    alternatives,
  };
});

// Story series prev/next
let prevPart: WritingItem | null = null;
let nextPart: WritingItem | null = null;
if (isStory && post.series_name) {
  const siblings = allPosts
    .filter((p) => p.series_name === post.series_name)
    .sort((a, b) => (a.series_part || 0) - (b.series_part || 0));
  const idx = siblings.findIndex((p) => p.id === post.id);
  if (idx > 0) prevPart = siblings[idx - 1];
  if (idx >= 0 && idx < siblings.length - 1) nextPart = siblings[idx + 1];
}

const isLocked = Boolean(post.isUraiNotesLocked && post.uraiNotesPassword);
const displayDate = post.publish_date || post.date;
const formattedDate = displayDate
  ? new Date(displayDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : '';

const articleJsonLd = {
  '@type': 'Article',
  headline: primaryTitle,
  description,
  datePublished: displayDate || undefined,
  author: {
    '@type': 'Person',
    name: 'Elvan Parthasarathy',
    url: `${BASE_URL}/about`,
  },
  publisher: { '@id': `${BASE_URL}/#organization` },
  mainEntityOfPage: `${BASE_URL}/writings/${category}/${encodeURIComponent(post.slug)}`,
  inLanguage: variants[0]?.lang || 'ta',
};
---

<BaseLayout
  title={`${primaryTitle} | ${meta.titleEn} — Elvan Navil`}
  description={description}
  canonicalPath={`/writings/${category}/${encodeURIComponent(post.slug)}`}
  ogType="article"
  ogImage={coverImg || `${BASE_URL}/favicon.png`}
  mobileTitle={`${meta.titleTa}|${meta.titleEn.toLowerCase()}`}
  backUrl={`/writings/${category}`}
  jsonLd={articleJsonLd}
>
  <div class="page-view fadeIn" id="reading-article-root" style="max-width: 1200px; margin: 0 auto; padding: 10px 20px 60px;">
    <nav aria-label="Breadcrumb" style="margin-bottom: 20px; font-size: 0.88rem; color: var(--text-muted); display: flex; flex-wrap: wrap; gap: 6px;">
      <a href="/" style="color: var(--text-muted); text-decoration: none;">முகப்பு / Home</a>
      <span>›</span>
      <a href="/writings" style="color: var(--text-muted); text-decoration: none;">படைப்புகள் / Writings</a>
      <span>›</span>
      <a href={`/writings/${category}`} style="color: var(--text-muted); text-decoration: none;">{meta.titleTa} • {meta.titleEn}</a>
    </nav>

    <div class="reader-header-area" style="display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 32px; flex-wrap: wrap;">
      <h1
        id="primary-reading-title"
        data-original-title={primaryTitle}
        lang={variants[0]?.lang || 'ta'}
        style="font-size: clamp(1.8rem, 3.5vw, 2.3rem); font-weight: 800; line-height: 1.25; color: var(--text-main); margin: 0; letter-spacing: -0.02em; max-width: 820px;"
      >
        {primaryTitle}
      </h1>
    </div>

    <article class="animate-entry" style="max-width: 800px;">
      {!isMinimal && coverImg && category !== 'poems' && category !== 'quotes' && (
        <div style={`width: 100%; border-radius: ${isStory ? '12px' : '24px'}; overflow: hidden; margin-bottom: 36px;`}>
          <img src={coverImg} alt={primaryTitle} style="width: 100%; height: auto; max-height: 500px; object-fit: cover; display: block;" />
        </div>
      )}

      <header style="margin-bottom: 32px; text-align: left;">
        <div style="display: flex; align-items: center; flex-wrap: wrap; gap: 8px; color: var(--text-muted); font-size: 0.92rem; font-weight: 500;">
          {formattedDate && (
            <span style="display: inline-flex; align-items: center; gap: 6px;">
              <Icon name="CalendarBlank" weight="regular" size={16} />
              {formattedDate}
            </span>
          )}
          {post.classification && (
            <span style="padding: 2px 10px; border-radius: 99px; background: color-mix(in srgb, var(--text-main) 8%, transparent); color: var(--text-main); font-size: 0.8rem; font-weight: 600;">
              {post.classification}
            </span>
          )}
          {post.series_name && (
            <a
              href={`/writings/stories/series/${encodeURIComponent(post.series_name)}`}
              style="color: var(--text-main); font-weight: 600; text-decoration: underline; text-underline-offset: 3px;"
            >
              • {post.series_name} — Part {post.series_part}
            </a>
          )}
          {tags.length > 0 && <span>• {tags.join(', ')}</span>}
        </div>
      </header>

      {hasVariants ? (
        <div style="display: flex; flex-direction: column; gap: 40px;">
          {preparedVariants.map((v) => {
            const isMulti = preparedVariants.length > 1;
            const altKeys = Object.keys(v.alternatives);
            return (
              <div
                class="variant-block"
                data-variant-idx={v.vIndex}
                style={isMulti ? 'padding-bottom: 36px; margin-bottom: 12px; border-bottom: 2px dashed var(--border-light);' : ''}
              >
                {!isStory && (
                  <div class="variant-header-row">
                    <div class="variant-badge">
                      {LANG_LABELS[v.lang] || v.lang.toUpperCase()}
                      {v.label && <span style="margin-left: 4px;">({v.label})</span>}
                    </div>
                    {altKeys.map((k) => {
                      const alt = v.alternatives[k];
                      return (
                        <div style="display: inline-flex; align-items: center; gap: 6px;">
                          <label class="transl-switch" title={alt.label}>
                            <input
                              type="checkbox"
                              class="transl-toggle-input"
                              data-vidx={v.vIndex}
                              data-alt-key={k}
                            />
                            <span class="transl-slider"></span>
                          </label>
                          <span class="transl-switch-label">
                            {alt.label}
                            {alt.isBeta && (
                              <span style="margin-left: 4px; font-size: 0.55rem; font-weight: 700; padding: 1px 4px; border-radius: 4px; background: color-mix(in srgb, var(--text-main) 12%, transparent); color: var(--text-muted);">
                                BETA
                              </span>
                            )}
                          </span>
                        </div>
                      );
                    })}
                  </div>
                )}

                {(isMulti || isStory) && v.title && v.title !== primaryTitle && (
                  <h2
                    class="variant-sub-title"
                    data-vidx={v.vIndex}
                    lang={v.lang}
                    style={`font-size: ${isStory ? '2rem' : '1.6rem'}; font-weight: 700; line-height: 1.3; color: var(--text-main); margin: 0 0 14px;`}
                  >
                    {v.title}
                  </h2>
                )}

                {v.author && (
                  <div
                    class="variant-author"
                    data-vidx={v.vIndex}
                    lang={v.lang}
                    style="font-size: 1rem; color: var(--text-muted); font-style: italic; margin-bottom: 16px;"
                  >
                    — {v.author}
                  </div>
                )}

                <div
                  class={`rich-content-body variant-body ${isStory ? 'story-format' : ''}`}
                  data-vidx={v.vIndex}
                  data-orig-lang={v.lang}
                  lang={v.lang}
                  style="font-size: 1.15rem; line-height: 1.9; color: var(--text-main); white-space: pre-wrap;"
                  set:html={v.bodyHtml}
                />
              </div>
            );
          })}
        </div>
      ) : (
        <div style="display: flex; flex-direction: column; gap: 24px;">
          {Object.keys(contentObj)
            .filter((l) => contentObj[l]?.title || contentObj[l]?.body)
            .map((langCode) => {
              const lContent = contentObj[langCode] || {};
              return (
                <div>
                  {lContent.title && lContent.title !== primaryTitle && (
                    <h2 lang={langCode} style="font-size: 1.8rem; font-weight: 700; color: var(--text-main); margin-bottom: 14px;">
                      {lContent.title}
                    </h2>
                  )}
                  <div
                    lang={langCode}
                    class="rich-content-body"
                    style="font-size: 1.15rem; line-height: 1.9; color: var(--text-main); white-space: pre-wrap;"
                    set:html={textToHtml(lContent.body) || '<p>No content available.</p>'}
                  />
                </div>
              );
            })}
        </div>
      )}

      {!isMinimal && coverImg && (category === 'poems' || category === 'quotes') && (
        <div style="width: 100%; border-radius: 24px; overflow: hidden; margin-top: 40px; background: var(--bg-panel);">
          <img src={coverImg} alt={primaryTitle} style="width: 100%; height: auto; max-height: 500px; object-fit: cover; display: block;" />
        </div>
      )}

      {(post.urai || post.notes) && !post.is_private && (
        <div style="margin-top: 48px; padding-top: 32px; border-top: 1px solid var(--border-light);">
          <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 18px;">
            {post.urai && (
              <button type="button" class="expand-pill" id="btn-toggle-urai">
                <div class="pill-text-stack">
                  <span class="pill-ta">விளக்கம்</span>
                  <span class="pill-en">meaning</span>
                </div>
              </button>
            )}
            {post.notes && (
              <button type="button" class="expand-pill" id="btn-toggle-notes">
                <div class="pill-text-stack">
                  <span class="pill-ta">குறிப்புகள்</span>
                  <span class="pill-en">notes</span>
                </div>
              </button>
            )}
          </div>

          {isLocked ? (
            <div id="urai-lock-box" style="display: none; text-align: center; padding: 20px 0; max-width: 320px; margin: 0 auto;">
              <p style="color: var(--text-muted); margin-bottom: 12px;">This section is locked. Enter password to view.</p>
              {post.uraiNotesPasswordHint && (
                <p style="font-style: italic; font-size: 0.9rem; color: var(--text-main); opacity: 0.8; margin-bottom: 12px;">
                  Hint: {post.uraiNotesPasswordHint}
                </p>
              )}
              <form id="urai-unlock-form" style="display: flex; flex-direction: column; gap: 10px;">
                <input
                  id="urai-pwd-input"
                  type="password"
                  placeholder="Enter Password"
                  style="padding: 12px 16px; border-radius: 12px; border: 1px solid var(--border-light); background: var(--bg-panel); color: var(--text-main);"
                />
                <button type="submit" style="padding: 12px; border-radius: 12px; border: none; background: var(--text-main); color: var(--bg-app); cursor: pointer; font-weight: bold;">
                  Unlock
                </button>
              </form>
              <p id="urai-pwd-error" style="display: none; color: #ff4444; font-size: 0.85rem; margin-top: 10px;">Incorrect password.</p>
            </div>
          ) : null}

          {post.urai && (
            <div id="urai-content-box" style="display: none; font-size: 1.05rem; line-height: 1.8; color: var(--text-muted); padding: 12px 0;" set:html={textToHtml(post.urai)} />
          )}
          {post.notes && (
            <div id="notes-content-box" style="display: none; font-size: 1.05rem; line-height: 1.8; color: var(--text-muted); padding: 12px 0;" set:html={textToHtml(post.notes)} />
          )}
        </div>
      )}

      {isStory && (prevPart || nextPart) && (
        <div style="margin-top: 48px; padding-top: 32px; border-top: 1px solid var(--border-light); display: flex; flex-direction: column; align-items: center; gap: 16px;">
          <h4 style="margin: 0; color: var(--text-muted); font-size: 0.9rem; font-weight: 600;">
            {post.series_name} — Continue Reading
          </h4>
          <div style="display: flex; gap: 12px; align-items: center; justify-content: center;">
            {prevPart && (
              <a href={`/writings/stories/${encodeURIComponent(prevPart.slug)}`} class="page-btn prev-btn" style="text-decoration: none; gap: 6px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6" /></svg>
                பகுதி {prevPart.series_part}
              </a>
            )}
            {nextPart && (
              <a href={`/writings/stories/${encodeURIComponent(nextPart.slug)}`} class="page-btn next-btn" style="text-decoration: none; gap: 6px;">
                பகுதி {nextPart.series_part}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
              </a>
            )}
          </div>
        </div>
      )}

      <!-- Literary context block for rich internal linking -->
      <section style="margin-top: 40px; padding: 20px 24px; background: var(--bg-panel); border-radius: 16px; border: 1px solid var(--border-light); font-size: 0.93rem; line-height: 1.7; color: var(--text-muted);">
        <h3 style="margin: 0 0 8px; font-size: 1.05rem; color: var(--text-main);">இலக்கியப் பார்வை • About This Work</h3>
        <p style="margin: 0 0 10px;">
          Published in <strong>{meta.titleTa} ({meta.titleEn})</strong> on Elvan Navil by <strong>Elvan Parthasarathy</strong>. Explore bilingual Tamil and English literature, stories, and essays across the collection.
        </p>
        <div style="display: flex; gap: 16px; flex-wrap: wrap;">
          <a href={`/writings/${category}`} style="color: var(--text-main); font-weight: 600; text-decoration: underline;">← All {meta.titleEn}</a>
          <a href="/writings" style="color: var(--text-main); font-weight: 600; text-decoration: underline;">Explore All Writings</a>
        </div>
      </section>

      <!-- Live Real-time Likes & Comments React Island -->
      <EngagementIsland postId={post.id} category={category} client:only="react" />
    </article>

    <AdUnit margin="48px 0 0" />
  </div>

  <script
    is:inline
    define:vars={{
      preparedVariants,
      isLocked,
      expectedPwd: isLocked ? post.uraiNotesPassword || '' : '',
    }}
  >
    (function () {
      function initReadingView() {
        var root = document.getElementById('reading-article-root');
        if (!root || root.dataset.bound) return;
        root.dataset.bound = '1';

        var origData = (preparedVariants || []).map(function (v) {
          return { title: v.title, author: v.author, bodyHtml: v.bodyHtml, lang: v.lang, alternatives: v.alternatives || {} };
        });
        var primaryH1 = document.getElementById('primary-reading-title');
        var origPrimaryTitle = primaryH1 ? primaryH1.getAttribute('data-original-title') : '';

        document.querySelectorAll('.transl-toggle-input').forEach(function (inp) {
          inp.addEventListener('change', function () {
            var vIdx = Number(inp.getAttribute('data-vidx'));
            var key = inp.getAttribute('data-alt-key');
            var checked = inp.checked;

            document.querySelectorAll('.transl-toggle-input[data-vidx="' + vIdx + '"]').forEach(function (other) {
              if (other !== inp) other.checked = false;
            });

            var vData = origData[vIdx];
            if (!vData) return;
            var bodyEl = document.querySelector('.variant-body[data-vidx="' + vIdx + '"]');
            var subTitleEl = document.querySelector('.variant-sub-title[data-vidx="' + vIdx + '"]');
            var authorEl = document.querySelector('.variant-author[data-vidx="' + vIdx + '"]');

            if (checked && vData.alternatives[key]) {
              var alt = vData.alternatives[key];
              if (bodyEl) { bodyEl.innerHTML = alt.html; bodyEl.setAttribute('lang', alt.lang); }
              if (subTitleEl && alt.title) subTitleEl.textContent = alt.title;
              if (authorEl && alt.author) authorEl.textContent = '— ' + alt.author;
              if (vIdx === 0 && primaryH1 && alt.title) primaryH1.textContent = alt.title;
            } else {
              if (bodyEl) { bodyEl.innerHTML = vData.bodyHtml; bodyEl.setAttribute('lang', vData.lang); }
              if (subTitleEl) subTitleEl.textContent = vData.title;
              if (authorEl) authorEl.textContent = '— ' + vData.author;
              if (vIdx === 0 && primaryH1 && origPrimaryTitle) primaryH1.textContent = origPrimaryTitle;
            }
          });
        });

        var unlocked = !isLocked;
        var activeSec = null;
        var btnUrai = document.getElementById('btn-toggle-urai');
        var btnNotes = document.getElementById('btn-toggle-notes');
        var boxUrai = document.getElementById('urai-content-box');
        var boxNotes = document.getElementById('notes-content-box');
        var lockBox = document.getElementById('urai-lock-box');

        function renderSection() {
          if (btnUrai) btnUrai.classList.toggle('active', activeSec === 'urai');
          if (btnNotes) btnNotes.classList.toggle('active', activeSec === 'notes');
          if (!activeSec) {
            if (lockBox) lockBox.style.display = 'none';
            if (boxUrai) boxUrai.style.display = 'none';
            if (boxNotes) boxNotes.style.display = 'none';
            return;
          }
          if (!unlocked && lockBox) {
            lockBox.style.display = 'block';
            if (boxUrai) boxUrai.style.display = 'none';
            if (boxNotes) boxNotes.style.display = 'none';
          } else {
            if (lockBox) lockBox.style.display = 'none';
            if (boxUrai) boxUrai.style.display = activeSec === 'urai' ? 'block' : 'none';
            if (boxNotes) boxNotes.style.display = activeSec === 'notes' ? 'block' : 'none';
          }
        }

        if (btnUrai) btnUrai.addEventListener('click', function () { activeSec = activeSec === 'urai' ? null : 'urai'; renderSection(); });
        if (btnNotes) btnNotes.addEventListener('click', function () { activeSec = activeSec === 'notes' ? null : 'notes'; renderSection(); });

        var unlockForm = document.getElementById('urai-unlock-form');
        if (unlockForm) {
          unlockForm.addEventListener('submit', function (e) {
            e.preventDefault();
            var val = (document.getElementById('urai-pwd-input').value || '').trim();
            var errEl = document.getElementById('urai-pwd-error');
            if (val === expectedPwd) {
              unlocked = true;
              if (errEl) errEl.style.display = 'none';
              renderSection();
            } else {
              if (errEl) errEl.style.display = 'block';
            }
          });
        }
      }
      initReadingView();
      document.addEventListener('astro:page-load', initReadingView);
    })();
  </script>
</BaseLayout>

<style>
  .transl-switch { position: relative; display: inline-block; width: 36px; height: 20px; flex-shrink: 0; }
  .transl-switch input { opacity: 0; width: 0; height: 0; }
  .transl-slider {
    position: absolute; cursor: pointer; inset: 0;
    background: color-mix(in srgb, var(--text-main) 15%, transparent); border-radius: 20px; transition: background 0.25s ease;
  }
  .transl-slider::before {
    content: ''; position: absolute; height: 16px; width: 16px; left: 2px; bottom: 2px;
    background: var(--bg-app); border-radius: 50%; transition: transform 0.25s ease;
  }
  .transl-switch input:checked + .transl-slider { background: var(--text-main); }
  .transl-switch input:checked + .transl-slider::before { transform: translateX(16px); }
  .transl-switch-label { font-size: 0.72rem; font-weight: 600; color: var(--text-muted); user-select: none; }
  .variant-header-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-bottom: 14px; }
  .variant-badge {
    font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; color: var(--text-muted); opacity: 0.75;
  }
  .expand-pill {
