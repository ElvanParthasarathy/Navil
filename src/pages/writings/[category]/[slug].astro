---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdUnit from '../../../components/astro/AdUnit.astro';
import Icon from '../../../components/astro/Icon.astro';
import EngagementIsland from '../../../components/islands/EngagementIsland';
import {
  ALL_WRITING_CATEGORIES,
  CATEGORY_META,
  BASE_URL,
  getCategoryPosts,
  getPrimaryTitle,
  getPrimaryExcerpt,
  getPostTags,
  textToHtml,
  type WritingItem,
} from '../../../lib/content';
import { getOptimizedImage } from '../../../நூலகம்/ஊடகம்';
import {
  transliterate,
  capitalizeWords,
  capitalizeWordsHtml,
} from '../../../சிறப்புக்கூறுகள்/கருவிகள்/மொழிமாற்றி/பயன்பாடுகள்/மொழிமாற்றம்';
import { UI_TA, UI_EN } from '../../../i18n';

export async function getStaticPaths() {
  const paths: any[] = [];
  for (const cat of ALL_WRITING_CATEGORIES) {
    const posts = await getCategoryPosts(cat);
    for (const post of posts) {
      paths.push({
        params: { category: cat, slug: post.slug },
        props: { category: cat, post, allPosts: posts },
      });
    }
  }
  return paths;
}

const { category, post, allPosts } = Astro.props as {
  category: string;
  post: WritingItem;
  allPosts: WritingItem[];
};

const meta = CATEGORY_META[category];
const isStory = category === 'stories';
const isMinimal = category === 'thoughts';
const variants = post.variants || [];
const contentObj = post.content || {};
const hasVariants = variants.length > 0;
const primaryTitle = getPrimaryTitle(post, category);
const description = getPrimaryExcerpt(post, 160) || `${primaryTitle} — ${meta.titleEn} by Elvan Parthasarathy.`;
const coverImg = post.cover_image ? getOptimizedImage(post.cover_image, 'medium') : null;
const tags = getPostTags(post);

const LANG_LABELS: Record<string, string> = UI_TA.reader.langLabels;
const TRANSL_LABELS: Record<string, string> = {
  en: 'Aa',
  ta: 'த',
  ml: 'മ',
  hi: 'हि',
  te: 'తె',
  sa: 'सं',
};
const INDIC_LANGS = ['ta', 'ml', 'hi', 'sa', 'te'];

function transliterateHtmlContent(html: string): string {
  if (!html) return '';
  const tr = html.replace(/(<[^>]+>)|([^<]+)/g, (_m, tag, text) => {
    if (tag) return tag;
    return transliterate(text);
  });
  return capitalizeWordsHtml(tr);
}

// Precompute variants + their transliteration alternatives at build time
const preparedVariants = variants.map((v, vIndex) => {
  const translObj = v.transliterations || {};
  const translKeys = Object.keys(translObj).filter((k) => Boolean(translObj[k]));
  const isIndic = INDIC_LANGS.includes(v.lang || '');
  const sortedKeys =
    v.lang === 'ml'
      ? ['ta', 'en', ...translKeys.filter((k) => k !== 'ta' && k !== 'en')].filter((k) =>
          translKeys.includes(k)
        )
      : ['en', ...translKeys.filter((k) => k !== 'en')];

  const baseTitle = v.title || post.title || '';
  const baseBodyHtml = textToHtml(v.text) || '<p>No content available.</p>';
  const alternatives: Record<
    string,
    { label: string; title: string; author: string; html: string; lang: string; isBeta?: boolean }
  > = {};

  if (isIndic) {
    sortedKeys.forEach((tLang) => {
      alternatives[tLang] = {
        label: TRANSL_LABELS[tLang] || tLang,
        title: v.titleTransliterations?.[tLang] || post.titleTransliterations?.[tLang] || baseTitle,
        author: v.authorTransliterations?.[tLang] || v.author || '',
        html: textToHtml(translObj[tLang]),
        lang: tLang,
      };
    });
  }

  if (['poems', 'quotes'].includes(category) && v.lang === 'ta') {
    alternatives.navil = {
      label: 'Navil',
      isBeta: true,
      title: capitalizeWords(transliterate(baseTitle)),
      author: v.author ? capitalizeWords(transliterate(v.author)) : '',
      html: transliterateHtmlContent(baseBodyHtml),
      lang: 'en',
    };
  }

  return {
    vIndex,
    lang: v.lang || 'ta',
    label: v.label || '',
    author: v.author || '',
    title: baseTitle,
    bodyHtml: baseBodyHtml,
    alternatives,
  };
});

// Story series prev/next
let prevPart: WritingItem | null = null;
let nextPart: WritingItem | null = null;
if (isStory && post.series_name) {
  const siblings = allPosts
    .filter((p) => p.series_name === post.series_name)
    .sort((a, b) => (a.series_part || 0) - (b.series_part || 0));
  const idx = siblings.findIndex((p) => p.id === post.id);
  if (idx > 0) prevPart = siblings[idx - 1];
  if (idx >= 0 && idx < siblings.length - 1) nextPart = siblings[idx + 1];
}

const isLocked = Boolean(post.isUraiNotesLocked && post.uraiNotesPassword);
const displayDate = post.publish_date || post.date;
const formattedDate = displayDate
  ? new Date(displayDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : '';

const articleJsonLd = {
  '@type': 'Article',
  headline: primaryTitle,
  description,
  datePublished: displayDate || undefined,
  author: {
    '@type': 'Person',
    name: 'Elvan Parthasarathy',
    url: `${BASE_URL}/about`,
  },
  publisher: { '@id': `${BASE_URL}/#organization` },
  mainEntityOfPage: `${BASE_URL}/writings/${category}/${encodeURIComponent(post.slug)}`,
  inLanguage: variants[0]?.lang || 'ta',
};
---

<BaseLayout
  title={`${primaryTitle} | ${meta.titleEn} — Elvan Navil`}
  description={description}
  canonicalPath={`/writings/${category}/${encodeURIComponent(post.slug)}`}
  ogType="article"
  ogImage={coverImg || `${BASE_URL}/favicon.png`}
  mobileTitle={`${meta.titleTa}|${meta.titleEn.toLowerCase()}`}
  backUrl={`/writings/${category}`}
  jsonLd={articleJsonLd}
>
  <div class="page-view fadeIn" id="reading-article-root" style="max-width: 1200px; margin: 0 auto; padding: 10px 20px 100px;">

    <div class="reader-header-area" style="display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 40px; flex-wrap: wrap;">
      <h1
        id="primary-reading-title"
        data-original-title={primaryTitle}
        lang={variants[0]?.lang || 'ta'}
        style="font-size: 2rem; font-weight: 700; line-height: 1.2; color: var(--text-main); margin: 0; letter-spacing: normal; max-width: 80%;"
      >
        {primaryTitle}
      </h1>
    </div>

    <article class="animate-entry" style="max-width: 800px;">
      {!isMinimal && coverImg && category !== 'poems' && category !== 'quotes' && (
        <div style={`width: 100%; border-radius: ${isStory ? '0' : '24px'}; overflow: hidden; margin-bottom: 40px;`}>
          <img src={coverImg} alt={primaryTitle} referrerpolicy="no-referrer" style="width: 100%; height: auto; max-height: 500px; object-fit: cover; display: block;" onerror="var w=this.parentElement;if(w)w.style.display='none';" />
        </div>
      )}

      <header style="margin-bottom: 40px; text-align: left;">
        <div style="display: flex; align-items: center; justify-content: flex-start; flex-wrap: wrap; gap: 8px; color: var(--text-muted); font-size: 0.95rem; margin-bottom: 16px; font-weight: 500;">
          {formattedDate && (
            <>
              <Icon name="CalendarBlank" weight="regular" />
              <span>{formattedDate}</span>
            </>
          )}
          {post.series_name && (
            <span style="color: var(--text-main);">
              • <a href={`/writings/stories/series/${encodeURIComponent(post.series_name)}`} style="color: inherit; text-decoration: none;">{post.series_name} — Part {post.series_part}</a>
            </span>
          )}
          {tags.length > 0 && <span>• {tags.join(', ')}</span>}
        </div>
      </header>

      {hasVariants ? (
        <div style="display: flex; flex-direction: column; gap: 40px;">
          {preparedVariants.map((v) => {
            const isMulti = preparedVariants.length > 1;
            const hasNextVariant = isMulti && v.vIndex < preparedVariants.length - 1;
            const altKeys = Object.keys(v.alternatives);
            const bodyFormatClass = isStory
              ? 'story-format'
              : (category === 'poems' || category === 'quotes' ? 'verse-format' : 'prose-format');
            return (
              <div
                class="variant-block"
                data-variant-idx={v.vIndex}
                style={hasNextVariant ? 'padding-bottom: 40px; border-bottom: 2px dashed var(--border-light);' : ''}
              >
                {!isStory && (
                  <div class="variant-header-slot" data-vidx={v.vIndex}>
                    <div class="variant-header-row" data-reader-sticky={altKeys.length > 0 ? '' : undefined} data-vidx={v.vIndex}>
                      <div class="variant-badge">
                        <span class="variant-badge-lang">{LANG_LABELS[v.lang] || v.lang.toUpperCase()}</span>
                        {v.label && <span class="variant-badge-mode">({v.label})</span>}
                      </div>
                      {altKeys.map((k) => {
                        const alt = v.alternatives[k];
                        return (
                          <label class="variant-switch-option">
                            <span class="transl-switch">
                              <input
                                type="checkbox"
                                class="transl-toggle-input"
                                data-vidx={v.vIndex}
                                data-alt-key={k}
                              />
                              <span class="transl-slider"></span>
                            </span>
                            <span class="transl-switch-label" style={alt.isBeta ? 'display: inline-flex; align-items: center; gap: 4px;' : ''}>
                              {alt.label}
                              {alt.isBeta && (
                                <span style="font-size: 0.55rem; font-weight: 700; letter-spacing: 0.5px; padding: 1px 4px; border-radius: 4px; background: color-mix(in srgb, var(--text-main) 12%, transparent); color: var(--text-muted); line-height: 1.1; text-transform: uppercase;">
                                  BETA
                                </span>
                              )}
                            </span>
                          </label>
                        );
                      })}
                    </div>
                  </div>
                )}

                {(isMulti || isStory) && v.title && v.title !== primaryTitle && (
                  <h2
                    class="variant-sub-title"
                    data-vidx={v.vIndex}
                    lang={v.lang}
                    style={`font-size: ${isStory ? '2.5rem' : '2rem'}; font-weight: ${isStory ? '800' : '700'}; font-family: ${isStory ? 'serif' : 'inherit'}; line-height: 1.2; color: var(--text-main); margin: 0 0 16px;`}
                  >
                    {v.title}
                  </h2>
                )}

                {v.author && (
                  <div
                    class="reader-variant-author"
                    data-vidx={v.vIndex}
                    lang={v.lang}
                    style="font-size: 1rem; color: var(--text-muted); font-style: italic; margin-bottom: 16px; text-align: left;"
                  >
                    — {v.author}
                  </div>
                )}

                <div
                  class={`rich-content-body variant-body ${bodyFormatClass}`}
                  data-vidx={v.vIndex}
                  data-orig-lang={v.lang}
                  lang={v.lang}
                  style="font-size: 1.15rem; line-height: 1.9; color: var(--text-main); white-space: pre-wrap;"
                  set:html={v.bodyHtml}
                />
              </div>
            );
          })}
        </div>
      ) : (
        <div style="display: flex; flex-direction: column; gap: 24px;">
          {Object.keys(contentObj)
            .filter((l) => contentObj[l]?.title || contentObj[l]?.body)
            .map((langCode) => {
              const lContent = contentObj[langCode] || {};
              const fallbackFormatClass = isStory
                ? 'story-format'
                : (category === 'poems' || category === 'quotes' ? 'verse-format' : 'prose-format');
              return (
                <div>
                  {lContent.title && lContent.title !== primaryTitle && (
                    <h2 lang={langCode} style="font-size: 2.5rem; font-weight: 700; line-height: 1.2; color: var(--text-main); margin: 0 0 16px;">
                      {lContent.title}
                    </h2>
                  )}
                  <div
                    lang={langCode}
                    class={`rich-content-body ${fallbackFormatClass}`}
                    style="font-size: 1.15rem; line-height: 1.9; color: var(--text-main); white-space: pre-wrap;"
                    set:html={textToHtml(lContent.body) || '<p>No content available.</p>'}
                  />
                </div>
              );
            })}
        </div>
      )}

      {!isMinimal && coverImg && (category === 'poems' || category === 'quotes') && (
        <div style="width: 100%; border-radius: 24px; overflow: hidden; margin-top: 40px; background: var(--bg-panel);">
          <img src={coverImg} alt={primaryTitle} referrerpolicy="no-referrer" style="width: 100%; height: auto; max-height: 500px; object-fit: cover; display: block;" onerror="var w=this.parentElement;if(w)w.style.display='none';" />
        </div>
      )}

      {(post.urai || post.notes) && !post.is_private && (
        <div style="margin-top: 60px; padding-top: 40px; border-top: 1px solid var(--border-light);">
          <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 24px;">
            {post.urai && (
              <button type="button" class="expand-pill" id="btn-toggle-urai">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {isLocked ? (
                    <path d="M7 11V7a5 5 0 0 1 9.9-1 M5 11h14v10H5z" />
                  ) : (
                    <>
                      <line class="pill-plus-v" x1="12" y1="5" x2="12" y2="19" />
                      <line x1="5" y1="12" x2="19" y2="12" />
                    </>
                  )}
                </svg>
                <div class="pill-text-stack">
                  <span class="pill-ta" data-ui-ta="reader.meaning">{UI_TA.reader.meaning}</span>
                  <span class="pill-en en-sub-inline" data-ui-en="reader.meaning">{UI_EN.reader.meaning}</span>
                </div>
              </button>
            )}
            {post.notes && (
              <button type="button" class="expand-pill" id="btn-toggle-notes">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {isLocked ? (
                    <path d="M7 11V7a5 5 0 0 1 9.9-1 M5 11h14v10H5z" />
                  ) : (
                    <>
                      <line class="pill-plus-v" x1="12" y1="5" x2="12" y2="19" />
                      <line x1="5" y1="12" x2="19" y2="12" />
                    </>
                  )}
                </svg>
                <div class="pill-text-stack">
                  <span class="pill-ta" data-ui-ta="reader.notes">{UI_TA.reader.notes}</span>
                  <span class="pill-en en-sub-inline" data-ui-en="reader.notes">{UI_EN.reader.notes}</span>
                </div>
              </button>
            )}
          </div>

          {isLocked ? (
            <div id="urai-lock-box" style="display: none; text-align: center; padding: 30px 0; max-width: 300px; margin: 0 auto;">
              <p style="color: var(--text-muted); margin-bottom: 20px;">
                This section is locked. Enter password to view.
              </p>
              {post.uraiNotesPasswordHint && (
                <p style="font-style: italic; font-size: 0.9rem; color: var(--text-main); opacity: 0.8; margin-bottom: 12px;">
                  Hint: {post.uraiNotesPasswordHint}
                </p>
              )}
              <form id="urai-unlock-form" style="display: flex; flex-direction: column; gap: 12px;">
                <input
                  id="urai-pwd-input"
                  type="password"
                  class="pwd-input"
                  placeholder="Enter Password"
                  style="padding: 12px 16px; border-radius: 12px; border: 1px solid var(--border-light); background: var(--bg-panel); color: var(--text-main); outline: none; width: 100%;"
                />
                <button type="submit" style="padding: 12px; border-radius: 12px; border: none; background: var(--text-main); color: var(--bg-app); cursor: pointer; font-weight: bold; width: 100%;">
                  Unlock
                </button>
              </form>
              <p id="urai-pwd-error" style="display: none; color: #ff4444; font-size: 0.85rem; margin-top: 12px;">Incorrect password.</p>
            </div>
          ) : null}

          {post.urai && (
            <div id="urai-content-box" style="display: none; font-size: 1.05rem; line-height: 1.8; color: var(--text-muted); padding: 12px 0;" set:html={textToHtml(post.urai)} />
          )}
          {post.notes && (
            <div id="notes-content-box" style="display: none; font-size: 1.05rem; line-height: 1.8; color: var(--text-muted); padding: 12px 0;" set:html={textToHtml(post.notes)} />
          )}
        </div>
      )}

      {isStory && (prevPart || nextPart) && (
        <div style="margin-top: 60px; padding-top: 40px; border-top: 1px solid var(--border-light); display: flex; flex-direction: column; align-items: center; gap: 16px;">
          <h4 style="margin: 0; color: var(--text-muted); font-size: 0.9rem; font-weight: 600; letter-spacing: 0.5px;">
            {post.series_name} — Continue Reading
          </h4>
          <div class="pagination-nav-pill" style="display: flex; gap: 12px; align-items: center; justify-content: center; width: auto;">
            {prevPart && (
              <a href={`/writings/stories/${encodeURIComponent(prevPart.slug)}`} class="page-btn prev-btn" style="text-decoration: none; display: inline-flex; align-items: center;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;" aria-hidden="true"><polyline points="15 18 9 12 15 6" /></svg>
                <span data-ui-ta="common.partLabel">{UI_TA.common.partLabel}</span> {prevPart.series_part}
              </a>
            )}
            {nextPart && (
              <a href={`/writings/stories/${encodeURIComponent(nextPart.slug)}`} class="page-btn next-btn" style="text-decoration: none; display: inline-flex; align-items: center;">
                <span data-ui-ta="common.partLabel">{UI_TA.common.partLabel}</span> {nextPart.series_part}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-left: 6px;" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
              </a>
            )}
          </div>
        </div>
      )}


      <!-- Live Real-time Likes & Comments React Island -->
      <EngagementIsland postId={post.id} category={category} client:only="react" />
    </article>

    <AdUnit margin="48px 0 0" />
  </div>

  <script
    is:inline
    define:vars={{
      preparedVariants,
      isLocked,
      expectedPwd: isLocked ? post.uraiNotesPassword || '' : '',
    }}
  >
    (function () {
      function initReadingView() {
        var root = document.getElementById('reading-article-root');
        if (!root || root.dataset.bound) return;
        root.dataset.bound = '1';

        var origData = (preparedVariants || []).map(function (v) {
          return { title: v.title, author: v.author, bodyHtml: v.bodyHtml, lang: v.lang, alternatives: v.alternatives || {} };
        });
        var primaryH1 = document.getElementById('primary-reading-title');
        var origPrimaryTitle = primaryH1 ? primaryH1.getAttribute('data-original-title') : '';
        var switchRows = Array.from(root.querySelectorAll('[data-reader-sticky]'));
        var shell = document.getElementById('app-shell');

        if (switchRows.length > 0) {
          var mobileQuery = window.matchMedia('(max-width: 768px)');
          var rowMeta = switchRows.map(function (row) {
            return {
              row: row,
              slot: row.closest('.variant-header-slot'),
              block: row.closest('.variant-block'),
              pinned: false,
              leaveTimer: 0,
            };
          });
          var frame = 0;

          function clearLeaveTimer(meta) {
            if (meta && meta.leaveTimer) {
              clearTimeout(meta.leaveTimer);
              meta.leaveTimer = 0;
            }
          }

          function restoreRowImmediately(meta) {
            if (!meta || !meta.slot) return;
            clearLeaveTimer(meta);
            meta.row.removeAttribute('data-reader-pinned');
            meta.row.removeAttribute('data-reader-entering');
            meta.row.removeAttribute('data-reader-leaving');
            if (meta.row.parentElement !== meta.slot) {
              meta.slot.appendChild(meta.row);
            }
            meta.slot.style.minHeight = '';
            meta.pinned = false;
          }

          function pinRowSmoothly(meta) {
            if (!meta || !shell) return;
            clearLeaveTimer(meta);
            meta.row.removeAttribute('data-reader-leaving');
            if (meta.pinned && meta.row.parentElement === shell) {
              return;
            }
            if (meta.slot && !meta.slot.style.minHeight) {
              meta.slot.style.minHeight = Math.max(meta.row.offsetHeight, 38) + 'px';
            }
            meta.row.setAttribute('data-reader-pinned', '');
            meta.row.setAttribute('data-reader-entering', '');
            if (meta.row.parentElement !== shell) {
              shell.appendChild(meta.row);
            }
            meta.pinned = true;
            void meta.row.offsetWidth;
            requestAnimationFrame(function () {
              if (meta.pinned) meta.row.removeAttribute('data-reader-entering');
            });
          }

          function unpinRowSmoothly(meta) {
            if (!meta || !meta.slot) return;
            if (!meta.pinned || meta.row.parentElement !== shell) {
              restoreRowImmediately(meta);
              return;
            }
            if (meta.leaveTimer) return;
            meta.row.removeAttribute('data-reader-entering');
            meta.row.setAttribute('data-reader-leaving', '');
            meta.pinned = false;
            meta.leaveTimer = window.setTimeout(function () {
              meta.leaveTimer = 0;
              if (!meta.pinned) {
                restoreRowImmediately(meta);
              }
            }, 185);
          }

          function syncStickySwitches() {
            frame = 0;
            var isMobile = mobileQuery.matches;

            if (!isMobile) {
              if (shell) shell.removeAttribute('data-reader-switch-pinned');
              var desktopStates = rowMeta.map(function (meta) {
                if (meta.row.parentElement !== meta.slot || meta.leaveTimer) {
                  restoreRowImmediately(meta);
                }
                var ceiling = parseFloat(getComputedStyle(meta.row).top) || 64;
                var slotTop = meta.slot ? meta.slot.getBoundingClientRect().top : meta.row.getBoundingClientRect().top;
                var blockBottom = meta.block ? meta.block.getBoundingClientRect().bottom : Infinity;
                return slotTop <= ceiling + 0.5 && meta.row.getBoundingClientRect().top <= ceiling + 2 && blockBottom > ceiling + meta.row.offsetHeight;
              });
              rowMeta.forEach(function (meta, idx) {
                meta.row.toggleAttribute('data-reader-pinned', desktopStates[idx]);
              });
              return;
            }

            var activeIdx = -1;
            rowMeta.forEach(function (meta, idx) {
              if (!meta.slot) return;
              var slotTop = meta.slot.getBoundingClientRect().top;
              var blockBottom = meta.block ? meta.block.getBoundingClientRect().bottom : Infinity;
              var shouldPin = slotTop <= 56 && blockBottom > 96;
              if (shouldPin) activeIdx = idx;
            });

            rowMeta.forEach(function (meta, idx) {
              if (idx === activeIdx) {
                pinRowSmoothly(meta);
              } else {
                unpinRowSmoothly(meta);
              }
            });

            if (shell) {
              shell.toggleAttribute('data-reader-switch-pinned', activeIdx !== -1);
            }
          }

          function queueStickySwitchCheck() {
            if (!frame) frame = requestAnimationFrame(syncStickySwitches);
          }
          window.addEventListener('scroll', queueStickySwitchCheck, { passive: true });
          window.addEventListener('scrollend', syncStickySwitches, { passive: true });
          window.addEventListener('resize', queueStickySwitchCheck);
          mobileQuery.addEventListener('change', queueStickySwitchCheck);
          document.addEventListener('astro:before-swap', function () {
            window.removeEventListener('scroll', queueStickySwitchCheck);
            window.removeEventListener('scrollend', syncStickySwitches);
            window.removeEventListener('resize', queueStickySwitchCheck);
            mobileQuery.removeEventListener('change', queueStickySwitchCheck);
            if (frame) cancelAnimationFrame(frame);
            rowMeta.forEach(restoreRowImmediately);
            if (shell) shell.removeAttribute('data-reader-switch-pinned');
          }, { once: true });
          queueStickySwitchCheck();
        }

        document.querySelectorAll('.transl-toggle-input').forEach(function (inp) {
          inp.addEventListener('change', function () {
            var vIdx = Number(inp.getAttribute('data-vidx'));
            var key = inp.getAttribute('data-alt-key');
            var checked = inp.checked;

            document.querySelectorAll('.transl-toggle-input[data-vidx="' + vIdx + '"]').forEach(function (other) {
              if (other !== inp) other.checked = false;
            });

            var vData = origData[vIdx];
            if (!vData) return;
            var bodyEl = document.querySelector('.variant-body[data-vidx="' + vIdx + '"]');
            var subTitleEl = document.querySelector('.variant-sub-title[data-vidx="' + vIdx + '"]');
            var authorEl = document.querySelector('.reader-variant-author[data-vidx="' + vIdx + '"]');

            if (checked && vData.alternatives[key]) {
              var alt = vData.alternatives[key];
              if (bodyEl) { bodyEl.innerHTML = alt.html; bodyEl.setAttribute('lang', alt.lang); }
              if (subTitleEl && alt.title) { subTitleEl.textContent = alt.title; subTitleEl.setAttribute('lang', alt.lang); }
              if (authorEl && alt.author) { authorEl.textContent = '— ' + alt.author; authorEl.setAttribute('lang', alt.lang); }
              if (vIdx === 0 && primaryH1 && alt.title) { primaryH1.textContent = alt.title; primaryH1.setAttribute('lang', alt.lang); }
            } else {
              if (bodyEl) { bodyEl.innerHTML = vData.bodyHtml; bodyEl.setAttribute('lang', vData.lang); }
              if (subTitleEl) { subTitleEl.textContent = vData.title; subTitleEl.setAttribute('lang', vData.lang); }
              if (authorEl) { authorEl.textContent = '— ' + vData.author; authorEl.setAttribute('lang', vData.lang); }
              if (vIdx === 0 && primaryH1 && origPrimaryTitle) { primaryH1.textContent = origPrimaryTitle; primaryH1.setAttribute('lang', vData.lang); }
            }
            if (switchRows.length > 0) queueStickySwitchCheck();
          });
        });

        var unlocked = !isLocked;
        var activeSec = null;
        var btnUrai = document.getElementById('btn-toggle-urai');
        var btnNotes = document.getElementById('btn-toggle-notes');
        var boxUrai = document.getElementById('urai-content-box');
        var boxNotes = document.getElementById('notes-content-box');
        var lockBox = document.getElementById('urai-lock-box');

        function renderSection() {
          if (btnUrai) btnUrai.classList.toggle('active', activeSec === 'urai');
          if (btnNotes) btnNotes.classList.toggle('active', activeSec === 'notes');
          if (!activeSec) {
            if (lockBox) lockBox.style.display = 'none';
            if (boxUrai) boxUrai.style.display = 'none';
            if (boxNotes) boxNotes.style.display = 'none';
            return;
          }
          if (!unlocked && lockBox) {
            lockBox.style.display = 'block';
            if (boxUrai) boxUrai.style.display = 'none';
            if (boxNotes) boxNotes.style.display = 'none';
          } else {
            if (lockBox) lockBox.style.display = 'none';
            if (boxUrai) boxUrai.style.display = activeSec === 'urai' ? 'block' : 'none';
            if (boxNotes) boxNotes.style.display = activeSec === 'notes' ? 'block' : 'none';
          }
        }

        if (btnUrai) btnUrai.addEventListener('click', function () { activeSec = activeSec === 'urai' ? null : 'urai'; renderSection(); });
        if (btnNotes) btnNotes.addEventListener('click', function () { activeSec = activeSec === 'notes' ? null : 'notes'; renderSection(); });

        var unlockForm = document.getElementById('urai-unlock-form');
        if (unlockForm) {
          unlockForm.addEventListener('submit', function (e) {
            e.preventDefault();
            var val = (document.getElementById('urai-pwd-input').value || '').trim();
            var errEl = document.getElementById('urai-pwd-error');
            if (val === expectedPwd) {
              unlocked = true;
              if (errEl) errEl.style.display = 'none';
              renderSection();
            } else {
              if (errEl) errEl.style.display = 'block';
            }
          });
        }
      }
      initReadingView();
      document.addEventListener('astro:page-load', initReadingView);
    })();
  </script>
</BaseLayout>

