---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdUnit from '../../components/astro/AdUnit.astro';
import PianoIsland from '../../components/islands/PianoIsland';
import { UI_TA, UI_EN } from '../../i18n';
---

<BaseLayout
  title={`${UI_TA.routes.piano.title} | ${UI_EN.tools.pianoGuideTitle} — ${UI_EN.brand.name}`}
  description="Play multi-octave scales and chords directly in your browser using Elvan Navil's Web Audio synthesizer piano keyboard."
  canonicalPath="/tools/piano"
  mobileTitle={`${UI_TA.routes.piano.title}|${UI_EN.routes.piano.title}`}
  isBeta={true}
  backUrl="/tools"
>
  <div class="tool-astro-page">
    <PianoIsland client:only="react" />

    <section class="tool-editorial-guide" aria-label="Keyboard Synthesizer Notes">
      <h1 class="tool-guide-title" lang="ta">
        <span data-ui-pair="tools.pianoGuideTitle">{UI_TA.tools.pianoGuideTitle} • {UI_EN.tools.pianoGuideTitle}</span>
      </h1>
      <p lang="ta">
        உலாவியிலேயே சுரங்களையும் மேலைத்தேய இசைக் குறிப்புகளையும் (Octaves, Chords &amp; Harmonies)
        நேரடியாக இசைத்துப் பயிற்சி செய்ய உதவும் இலவச இணையப் பியானோ கருவி.
      </p>
      <p>
        Built with Web Audio API oscillators and soundfont synthesis for zero-install ear training,
        chord exploration, and musical prototyping across desktop keyboards and touch devices.
      </p>
    </section>

    <AdUnit margin="36px 0 0" />
  </div>
</BaseLayout>

<style>
  .tool-astro-page {
    max-width: 1200px;
    margin: 0 auto;
    padding-bottom: 32px;
  }
  .tool-editorial-guide {
    margin-top: 12px;
    padding: 24px 28px;
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: 16px;
  }
  @media (max-width: 768px) {
    .tool-editorial-guide {
      margin: 12px 18px 0;
      padding: 20px 18px;
    }
  }
  .tool-guide-title {
    margin: 0 0 12px;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-main);
  }
  .tool-editorial-guide p {
    margin: 0 0 12px;
    color: var(--text-muted);
    line-height: 1.7;
  }
</style>
