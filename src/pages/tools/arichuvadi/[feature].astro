---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdUnit from '../../../components/astro/AdUnit.astro';
import ArichuvadiIsland from '../../../components/islands/ArichuvadiIsland';
import { UI_TA, UI_EN } from '../../../i18n';

const MODULE_KEYS = ['editor', 'learn', 'practice', 'match', 'memorize', 'books', 'image', 'downloads', 'about'] as const;
type ModuleKey = (typeof MODULE_KEYS)[number];

export async function getStaticPaths() {
  return ['editor', 'learn', 'practice', 'match', 'memorize', 'books', 'image', 'downloads', 'about'].map((feature) => ({
    params: { feature },
  }));
}

const rawFeature = Astro.params.feature || 'editor';
const feature: ModuleKey = (MODULE_KEYS as readonly string[]).includes(rawFeature)
  ? (rawFeature as ModuleKey)
  : 'editor';

const metaTa = UI_TA.arichuvadiModules[feature];
const metaEn = UI_EN.arichuvadiModules[feature];
---

<BaseLayout
  title={`${metaTa.title} | ${metaEn.title} — Arichuvadi | ${UI_EN.brand.name}`}
  description={metaEn.desc}
  canonicalPath={`/tools/arichuvadi/${feature}`}
  mobileTitle={`${metaTa.title}|${UI_EN.routes.arichuvadi.title}`}
  isBeta={true}
  backUrl="/tools/arichuvadi"
>
  <div class="tool-astro-page">
    <ArichuvadiIsland feature={feature} client:only="react" />

    <section class="tool-editorial-guide" aria-label="Module Overview">
      <h1 class="tool-guide-title" lang="ta">
        <span data-ui-pair={`arichuvadiModules.${feature}.title`}>{metaTa.title} • {metaEn.title}</span>
      </h1>
      <p lang="ta" data-ui-ta={`arichuvadiModules.${feature}.desc`}>{metaTa.desc}</p>
      <p data-ui-en={`arichuvadiModules.${feature}.desc`}>{metaEn.desc}</p>
      <div class="tool-guide-links">
        <a href="/tools/arichuvadi">← All Arichuvadi Modules</a>
        <a href="/tools/transliterator">Open Full Script Transliterator →</a>
      </div>
    </section>

    <AdUnit margin="36px 0 0" />
  </div>
</BaseLayout>

<style>
  .tool-astro-page {
    max-width: 1200px;
    margin: 0 auto;
    padding-bottom: 32px;
  }
  .tool-editorial-guide {
    margin-top: 12px;
    padding: 24px 28px;
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: 16px;
  }
  @media (max-width: 768px) {
    .tool-editorial-guide {
      margin: 12px 18px 0;
      padding: 20px 18px;
    }
  }
  .tool-guide-title {
    margin: 0 0 12px;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-main);
  }
  .tool-editorial-guide p {
    margin: 0 0 12px;
    color: var(--text-muted);
    line-height: 1.7;
  }
  .tool-guide-links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 16px;
  }
  .tool-guide-links a {
    color: var(--accent-primary);
    font-weight: 600;
    text-decoration: none;
  }
  .tool-guide-links a:hover {
    text-decoration: underline;
  }
</style>
