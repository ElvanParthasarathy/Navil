---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdUnit from '../../../components/astro/AdUnit.astro';
import ArichuvadiIsland from '../../../components/islands/ArichuvadiIsland';
import { UI_TA, UI_EN } from '../../../i18n';

const FEATURES = (['editor', 'learn', 'practice', 'match', 'memorize', 'books', 'image', 'downloads', 'about'] as const).map((key) => ({
  key,
  titleTa: UI_TA.arichuvadiModules[key].title,
  titleEn: UI_EN.arichuvadiModules[key].title,
}));
---

<BaseLayout
  title={`${UI_TA.routes.arichuvadi.title} | Learn & Write Thamizhi (Tamil-Brahmi) & Vatteluttu — ${UI_EN.brand.name}`}
  description="Interactive Arichuvadi suite to learn, draw, match, type, and render classical Thamizhi (Tamil-Brahmi) and Vatteluttu ancient Tamil scripts."
  canonicalPath="/tools/arichuvadi"
  mobileTitle={`${UI_TA.routes.arichuvadi.title}|${UI_EN.routes.arichuvadi.title}`}
  isBeta={true}
  backUrl="/tools"
>
  <div class="tool-astro-page">
    <ArichuvadiIsland client:only="react" />

    <section class="tool-editorial-guide" aria-label="Arichuvadi Guide and Modules">
      <h1 class="tool-guide-title" lang="ta">
        <span data-ui-pair="tools.arichuvadiGuideTitle">{UI_TA.tools.arichuvadiGuideTitle} • {UI_EN.tools.arichuvadiGuideTitle}</span>
      </h1>
      <p lang="ta">
        தமிழர்களின் தொன்மையான எழுத்து முறைகளான <strong>தமிழி (Tamil-Brahmi)</strong> மற்றும்
        <strong>வட்டெழுத்து</strong> ஆகியவற்றை எளிய முறையில் கற்கவும், கையால் எழுதிப் பழகவும்,
        தமிழ்-தமிழி படங்களாக உருவாக்கவும் <strong>அரிச்சுவடி</strong> உதவுகிறது.
      </p>
      <p>
        Explore all 9 interactive modules below—from guided stroke-by-stroke tracing and vowel-consonant
        ligature tables to epigraphic reference books and downloadable vector script cards.
      </p>
      <nav class="arichuvadi-module-links" aria-label="Arichuvadi Modules">
        {FEATURES.map((f) => (
          <a href={`/tools/arichuvadi/${f.key}`} class="arichuvadi-chip">
            <span lang="ta" data-ui-ta={`arichuvadiModules.${f.key}.title`}>{f.titleTa}</span><span class="en-sub-inline" data-ui-en={`arichuvadiModules.${f.key}.title`}> · {f.titleEn}</span>
          </a>
        ))}
      </nav>
    </section>

    <AdUnit margin="36px 0 0" />
  </div>
</BaseLayout>

<style>
  .tool-astro-page {
    max-width: 1200px;
    margin: 0 auto;
    padding-bottom: 32px;
  }
  .tool-editorial-guide {
    margin-top: 12px;
    padding: 24px 28px;
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: 16px;
  }
  @media (max-width: 768px) {
    .tool-editorial-guide {
      margin: 12px 18px 0;
      padding: 20px 18px;
    }
  }
  .tool-guide-title {
    margin: 0 0 12px;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-main);
  }
  .tool-editorial-guide p {
    margin: 0 0 12px;
    color: var(--text-muted);
    line-height: 1.7;
  }
  .arichuvadi-module-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }
  .arichuvadi-chip {
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--bg-soft, rgba(128, 128, 128, 0.08));
    border: 1px solid var(--border-light);
    color: var(--text-main);
    font-size: 0.85rem;
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .arichuvadi-chip:hover {
    border-color: var(--accent-primary);
  }
</style>
