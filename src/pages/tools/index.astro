---
import '../../சிறப்புக்கூறுகள்/படைப்புகள்/படைப்புகள்.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdUnit from '../../components/astro/AdUnit.astro';
import Icon from '../../components/astro/Icon.astro';
---

<BaseLayout
  title="கருவிகள் | Tools — Elvan Navil"
  description="Interactive web tools by Elvan Navil: Tolkappiyam Tamil script transliterator (Thamizhi, Vatteluttu, IAST), Arichuvadi classical script trainer, Web Audio piano, and Formant Vocoder."
  canonicalPath="/tools"
  mobileTitle="கருவிகள்|tools"
  isBeta={true}
  backUrl="/"
>
  <div class="writings-page page-view fadeIn">
    <header class="writings-header animate-entry">
      <div style="flex: 1;">
        <h1 class="writings-title" lang="ta">
          கருவிகள்
          <span
            style="font-size: 0.75rem; background: color-mix(in srgb, var(--text-main) 12%, transparent); color: var(--text-main); padding: 3px 9px; border-radius: 100px; font-weight: 700; letter-spacing: 0.5px; line-height: 1;"
          >
            BETA
          </span>
        </h1>
        <div class="writings-title-sub">Tools</div>
        <p class="writings-subtitle" lang="ta">இசை, மொழி &amp; பயன்பாடுகள்</p>
        <p class="writings-subtitle writings-subtitle-en">Music, Language &amp; Productivity</p>
      </div>
    </header>

    <div class="category-grid tools-category-grid animate-entry">
      <a href="/tools/transliterator" class="category-card">
        <div class="cat-icon-box">
          <Icon name="Translate" weight="regular" />
        </div>
        <div class="cat-content">
          <div class="cat-title" lang="ta">
            நவில் மொழிமாற்றி
            <span class="cat-beta-badge">BETA</span>
          </div>
          <div class="cat-title-sub">Navil Transliterator</div>
          <p class="cat-desc" lang="ta">தொல்காப்பிய இலக்கண ஒலிபெயர்ப்பு முறைமை.</p>
          <p class="cat-desc-sub">Phonetic Latin-to-Tamil typing engine.</p>
        </div>
        <div class="cat-footer">
          மொழிமாற்றியைத் தொடங்க <Icon name="ArrowRight" weight="regular" />
        </div>
      </a>

      <a href="/tools/arichuvadi" class="category-card">
        <div class="cat-icon-box">
          <Icon name="Scroll" weight="regular" />
        </div>
        <div class="cat-content">
          <div class="cat-title" lang="ta">
            நவில் அரிச்சுவடி
            <span class="cat-beta-badge">BETA</span>
          </div>
          <div class="cat-title-sub">Navil Arichuvadi</div>
          <p class="cat-desc" lang="ta">பண்டைய தமிழ் எழுத்து வடிவமாற்றி.</p>
          <p class="cat-desc-sub">Convert modern Tamil into ancient Thamizhi and Vatteluttu.</p>
        </div>
        <div class="cat-footer">
          அரிச்சுவடியைத் திறக்க <Icon name="ArrowRight" weight="regular" />
        </div>
      </a>

      <a href="/tools/piano" class="category-card desktop-only">
        <div class="cat-icon-box">
          <Icon name="PianoKeys" weight="regular" />
        </div>
        <div class="cat-content">
          <div class="cat-title" lang="ta">
            கின்னரப்பெட்டி
            <span class="cat-beta-badge">BETA</span>
          </div>
          <div class="cat-title-sub">Navil Piano</div>
          <p class="cat-desc" lang="ta">மெய்நிகர் கின்னரப்பெட்டி மற்றும் இசையமைப்புக் கருவி.</p>
          <p class="cat-desc-sub">Virtual piano synthesizer with keyboard mapping.</p>
        </div>
        <div class="cat-footer">
          கின்னரப்பெட்டியைத் தொடங்க <Icon name="ArrowRight" weight="regular" />
        </div>
      </a>

      <a href="/teaching" class="category-card">
        <div class="cat-icon-box">
          <Icon name="Monitor" weight="regular" />
        </div>
        <div class="cat-content">
          <div class="cat-title" lang="ta">பயிற்றுவிப்பு</div>
          <div class="cat-title-sub">Teaching &amp; Presentations</div>
          <p class="cat-desc" lang="ta">கற்றல் கற்பித்தல் மற்றும் தொழில்நுட்ப விளக்கக்காட்சிகள்.</p>
          <p class="cat-desc-sub">Interactive teaching materials, slides, and educational resources.</p>
        </div>
        <div class="cat-footer">
          பயிற்றுவிப்பைக் காண <Icon name="ArrowRight" weight="regular" />
        </div>
      </a>
    </div>

    <section class="tools-overview-guide animate-entry">
      <h2>About Elvan Navil Web Utilities • கருவிகளின் நோக்கம்</h2>
      <p lang="ta">
        தமிழ் மொழியியல் மரபையும் நவீன வலைத் தொழில்நுட்பத்தையும் இணைக்கும் வகையில் இக்கருவிகள் உருவாக்கப்பட்டுள்ளன. தொல்காப்பிய எழுத்திலக்கண அடிப்படையில் பழங்கால எழுத்து வடிவங்களான தமிழி மற்றும் வட்டெழுத்துகளை உடனுக்குடன் மாற்றிப் பார்க்கவும் கற்கவும் முடியும்.
      </p>
      <p>
        Every tool runs directly inside your browser using client-side computational linguistics and Web Audio APIs—requiring no uploads or external server round-trips for text processing or sound synthesis.
      </p>
    </section>

    <AdUnit margin="48px 0 0" />
  </div>
</BaseLayout>

<style>
  .tools-overview-guide {
    margin-top: 40px;
    padding: 24px 26px;
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: 20px;
  }
  .tools-overview-guide h2 {
    margin: 0 0 12px;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-main);
  }
  .tools-overview-guide p {
    margin: 0 0 10px;
    color: var(--text-muted);
    line-height: 1.7;
    font-size: 0.94rem;
  }
  .tools-overview-guide p:last-child {
    margin-bottom: 0;
  }
</style>
