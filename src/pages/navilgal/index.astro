---
import '../../சிறப்புக்கூறுகள்/முகப்பு/முகப்பு.css';
import '../../சிறப்புக்கூறுகள்/படைப்புகள்/படைப்புகள்.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdUnit from '../../components/astro/AdUnit.astro';
import {
  getCategoryPosts,
  getAllArts,
  formatPlayerPoem,
  formatPlayerQuote,
} from '../../lib/content';

const [poems, quotes, articles, stories, diary, blog, arts] = await Promise.all([
  getCategoryPosts('poems'),
  getCategoryPosts('quotes'),
  getCategoryPosts('articles'),
  getCategoryPosts('stories'),
  getCategoryPosts('diary'),
  getCategoryPosts('blog'),
  getAllArts(),
]);

const totalWritings =
  poems.length + quotes.length + articles.length + stories.length + diary.length + blog.length;
const totalArts = arts.length;

const initialPoem = formatPlayerPoem(poems[0] || null);
const initialQuote = formatPlayerQuote(quotes[0] || null);
const poemsPool = poems.map((p) => formatPlayerPoem(p));
const quotesPool = quotes.map((q) => formatPlayerQuote(q));
---

<BaseLayout
  title="நவில்கள் | Navilgal — Elvan Navil Literary & Art Archive"
  description="Welcome to Elvanin Navilgal — a creative sanctuary for Tamil and English poetry, philosophical quotes, short stories, essays, and digital art."
  canonicalPath="/navilgal"
  mobileTitle="நவில்கள்|navilgal"
  backUrl="/"
>
  <div class="writings-page navilgal-page page-view fadeIn">
    <header class="writings-header animate-entry">
      <div style="flex: 1;">
        <h1 class="writings-title" lang="ta">எல்வனின் நவில்கள்</h1>
        <div class="writings-title-sub">Elvanin Navilgal</div>
        <p class="writings-subtitle" lang="ta">
          சிந்தனைகள், கதைகள், கலைகள் &amp; இலக்கியப் பெட்டகம்
        </p>
        <p class="writings-subtitle" style="font-size: 0.9rem; color: #888888; margin-top: 4px;">
          Literature, Visual Arts &amp; Creative Expressions
        </p>
      </div>
    </header>

    <div class="bento-grid animate-entry">
      <a href="/writings" class="category-card span-6">
        <div class="cat-icon-box">
          <svg width="24" height="24" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
            <path d="M221.28,34.75A64,64,0,0,0,120,64v7.59L63.59,128a15.9,15.9,0,0,0-4.68,11.31V192H40a8,8,0,0,0,0,16H92.69a15.9,15.9,0,0,0,11.31-4.69l91.41-91.41a64,64,0,0,0,25.87-77.15ZM92.69,192H74.91V139.31L131.31,82.9l52.69,52.69Zm111.79-91.31L151.8,48a48,48,0,0,1,52.68,52.68Z" />
          </svg>
        </div>
        <div class="cat-content">
          <div class="cat-title" lang="ta">
            எழுத்துகள்
            {totalWritings > 0 && <span class="cat-count-badge">{totalWritings}</span>}
          </div>
          <div class="cat-title-sub">Writings &amp; Literature</div>
          <p class="cat-desc" lang="ta">
            நவில் மிழிகள், நவில் மொழிகள், சிறுகதைகள், கட்டுரைகள் &amp; நாளேடு.
          </p>
          <p class="cat-desc-sub">
            Navil poems, quotes, short stories, articles &amp; personal diary.
          </p>
        </div>
        <div class="cat-footer">எழுத்துகளை வாசிக்க →</div>
      </a>

      <a href="/arts" class="category-card span-6">
        <div class="cat-icon-box">
          <svg width="24" height="24" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
            <path d="M200.77,53.89A103.27,103.27,0,0,0,128,24h-1.07A104,104,0,0,0,24,128c0,43,26.58,79.06,69.36,94.17A32,32,0,0,0,136,192a16,16,0,0,1,16-16h46.21a31.81,31.81,0,0,0,31.2-24.88,104.43,104.43,0,0,0,2.59-24A103.28,103.28,0,0,0,200.77,53.89ZM198.21,160H152a32,32,0,0,0-32,32,16,16,0,0,1-21.31,15.07C62.49,194.3,40,164,40,128a88,88,0,0,1,87.09-88h.9a88.35,88.35,0,0,1,88,87.25A88.86,88.86,0,0,1,213.81,147,15.86,15.86,0,0,1,198.21,160Z" />
          </svg>
        </div>
        <div class="cat-content">
          <div class="cat-title" lang="ta">
            படைப்புகள்
            {totalArts > 0 && <span class="cat-count-badge">{totalArts}</span>}
          </div>
          <div class="cat-title-sub">Arts &amp; Gallery</div>
          <p class="cat-desc" lang="ta">
            கரிக்கோல் ஓவியங்கள், சுவரொட்டிகள், ஓவியங்கள் &amp; எண்மக்கலைகள்.
          </p>
          <p class="cat-desc-sub">
            Pencil drawings, posters, paintings &amp; digital art creations.
          </p>
        </div>
        <div class="cat-footer">படைப்புகளைக் காண →</div>
      </a>

      <section class="bento-card span-6 quote-bento clickable-card" id="nav-poem-card" data-href={(initialPoem.slug || initialPoem.id) ? `/writings/poems/${encodeURIComponent(initialPoem.slug || initialPoem.id)}` : '/writings/poems'}>
        <div class="quote-header-row">
          <span class="quote-tag-badge" lang="ta">நவில் மிழிகள் • Navil Poems</span>
          <button type="button" id="nav-refresh-poem" class="quote-refresh-btn" title="Read another poem" aria-label="Read another poem">
            ↻
          </button>
        </div>
        <div class="player-display">
          <p class="player-main-text" id="nav-poem-main" lang={initialPoem.main.lang}>{initialPoem.main.text}</p>
          {initialPoem.sub && (
            <div class="player-sub-display" id="nav-poem-sub-wrap">
              <p class="player-sub-text" id="nav-poem-sub" lang={initialPoem.sub.lang}>{initialPoem.sub.text}</p>
            </div>
          )}
          <div class="player-read-more-container">
            <a id="nav-poem-link" href={(initialPoem.slug || initialPoem.id) ? `/writings/poems/${encodeURIComponent(initialPoem.slug || initialPoem.id)}` : '/writings/poems'} class="player-read-more-btn" style="text-decoration:none;">
              Click here to read more →
            </a>
          </div>
        </div>
      </section>

      <section class="bento-card span-6 quote-bento clickable-card" id="nav-quote-card" data-href={(initialQuote.slug || initialQuote.id) ? `/writings/quotes/${encodeURIComponent(initialQuote.slug || initialQuote.id)}` : '/writings/quotes'}>
        <div class="quote-header-row">
          <span class="quote-tag-badge" lang="ta">நவில் மொழிகள் • Navil Quotes</span>
          <button type="button" id="nav-refresh-quote" class="quote-refresh-btn" title="Read another quote" aria-label="Read another quote">
            ↻
          </button>
        </div>
        <div class="player-display">
          <blockquote class="player-main-text" id="nav-quote-main" lang={initialQuote.mainLang}>“{initialQuote.main}”</blockquote>
          {initialQuote.sub && (
            <div class="player-sub-display" id="nav-quote-sub-wrap">
              <p class="player-sub-text" id="nav-quote-sub" lang={initialQuote.subLang}>{initialQuote.sub}</p>
            </div>
          )}
          <div class="player-read-more-container">
            <a id="nav-quote-link" href={(initialQuote.slug || initialQuote.id) ? `/writings/quotes/${encodeURIComponent(initialQuote.slug || initialQuote.id)}` : '/writings/quotes'} class="player-read-more-btn" style="text-decoration:none;">
              Click here to read more →
            </a>
          </div>
        </div>
      </section>
    </div>

    <AdUnit margin="48px 0 0" />
  </div>

  <script is:inline define:vars={{ poemsPool, quotesPool }}>
    (function () {
      var pIdx = 0;
      var qIdx = 0;
      var pBtn = document.getElementById('nav-refresh-poem');
      var qBtn = document.getElementById('nav-refresh-quote');
      var pCard = document.getElementById('nav-poem-card');
      var qCard = document.getElementById('nav-quote-card');
      if (pCard) pCard.addEventListener('click', function (e) { if (!e.target.closest('button') && !e.target.closest('a')) window.location.href = pCard.getAttribute('data-href'); });
      if (qCard) qCard.addEventListener('click', function (e) { if (!e.target.closest('button') && !e.target.closest('a')) window.location.href = qCard.getAttribute('data-href'); });
      if (pBtn && poemsPool && poemsPool.length > 1) {
        pBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          pIdx = (pIdx + 1) % poemsPool.length;
          var p = poemsPool[pIdx];
          var pTarget = p.slug || p.id;
          var url = pTarget ? '/writings/poems/' + encodeURIComponent(pTarget) : '/writings/poems';
          document.getElementById('nav-poem-main').textContent = p.main.text;
          var sub = document.getElementById('nav-poem-sub');
          var subWrap = document.getElementById('nav-poem-sub-wrap');
          if (sub && subWrap) {
            if (p.sub && p.sub.text) { subWrap.style.display = ''; sub.textContent = p.sub.text; } else { subWrap.style.display = 'none'; }
          }
          document.getElementById('nav-poem-link').setAttribute('href', url);
          pCard.setAttribute('data-href', url);
        });
      }
      if (qBtn && quotesPool && quotesPool.length > 1) {
        qBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          qIdx = (qIdx + 1) % quotesPool.length;
          var q = quotesPool[qIdx];
          var qTarget = q.slug || q.id;
          var url = qTarget ? '/writings/quotes/' + encodeURIComponent(qTarget) : '/writings/quotes';
          document.getElementById('nav-quote-main').textContent = '“' + q.main + '”';
          var sub = document.getElementById('nav-quote-sub');
          var subWrap = document.getElementById('nav-quote-sub-wrap');
          if (sub && subWrap) {
            if (q.sub) { subWrap.style.display = ''; sub.textContent = q.sub; } else { subWrap.style.display = 'none'; }
          }
          document.getElementById('nav-quote-link').setAttribute('href', url);
          qCard.setAttribute('data-href', url);
        });
      }
    })();
  </script>
</BaseLayout>
