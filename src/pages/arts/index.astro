---
import '../../சிறப்புக்கூறுகள்/படைப்புகள்/படைப்புகள்.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdUnit from '../../components/astro/AdUnit.astro';
import Icon from '../../components/astro/Icon.astro';
import { getArtsCounts } from '../../lib/content';
import { UI_TA, UI_EN } from '../../i18n';

const counts = await getArtsCounts();

const ARTS_CATEGORIES = (['pencil', 'illustrations', 'poster', 'editing', 'poems', 'quotes', 'painting', 'digital_arts'] as const).map((key) => ({
  key,
  titleTa: UI_TA.artCategories[key].title,
  titleEn: UI_EN.artCategories[key].title,
  descTa: UI_TA.artCategories[key].desc,
  descEn: UI_EN.artCategories[key].desc,
  footerTa: UI_TA.artCategories[key].footer,
}));
---

<BaseLayout
  title={`${UI_TA.arts.title} | ${UI_EN.arts.title} — ${UI_EN.brand.name}`}
  description="Visual art gallery featuring pencil sketches, illustrations, posters, paintings, and digital creations by Elvan Parthasarathy."
  canonicalPath="/arts"
  mobileTitle={`${UI_TA.routes.arts.title}|${UI_EN.routes.arts.title}`}
  backUrl="/navilgal"
>
  <div class="writings-page arts-hub-page page-view fadeIn">
    <header class="writings-header animate-entry">
      <div style="flex: 1;">
        <h1 class="writings-title" data-ui-ta="arts.title">{UI_TA.arts.title}</h1>
        <div class="writings-title-sub" data-ui-en="arts.title">{UI_EN.arts.title}</div>
        <p class="writings-subtitle" data-ui-ta="arts.subtitle">{UI_TA.arts.subtitle}</p>
        <p class="writings-subtitle writings-subtitle-en" data-ui-en="arts.subtitle">{UI_EN.arts.subtitle}</p>
      </div>
    </header>

    <div class="category-grid animate-entry">
      {ARTS_CATEGORIES.map((cat) => (
        <a href={`/arts/${cat.key}`} class="category-card">
          <div class="cat-icon-box">
            {cat.key === 'pencil' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" />
                <path d="m15 5 4 4" />
              </svg>
            )}
            {cat.key === 'illustrations' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20.71 3.29c-.78-.78-2.05-.78-2.83 0l-3.3 3.3a3 3 0 1 0 4.24 4.24l3.3-3.3c.78-.78.78-2.05 0-2.83Z" />
                <path d="M16 11l-8 8H4v-4l8-8" />
                <path d="M3 21l3-3" />
              </svg>
            )}
            {cat.key === 'poster' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="18" height="18" x="3" y="3" rx="2" ry="2" />
                <circle cx="9" cy="9" r="2" />
                <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
              </svg>
            )}
            {cat.key === 'editing' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                <path d="M18.375 2.625a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4Z" />
              </svg>
            )}
            {cat.key === 'poems' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M17 6.1H3" />
                <path d="M21 12.1H3" />
                <path d="M15.1 18H3" />
              </svg>
            )}
            {cat.key === 'quotes' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V21" />
                <path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3" />
              </svg>
            )}
            {cat.key === 'painting' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="13.5" cy="6.5" r=".5" fill="currentColor" />
                <circle cx="17.5" cy="10.5" r=".5" fill="currentColor" />
                <circle cx="8.5" cy="7.5" r=".5" fill="currentColor" />
                <circle cx="6.5" cy="12.5" r=".5" fill="currentColor" />
                <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2Z" />
              </svg>
            )}
            {cat.key === 'digital_arts' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
                <line x1="8" y1="21" x2="16" y2="21" />
                <line x1="12" y1="17" x2="12" y2="21" />
                <path d="M7 11l2 2 4-4" />
              </svg>
            )}
          </div>
          <div class="cat-content">
            <div class="cat-title">
              <span data-ui-ta={`artCategories.${cat.key}.title`}>{cat.titleTa}</span>
              {(counts[cat.key] || 0) > 0 && <span class="arts-count-badge">{counts[cat.key]}</span>}
            </div>
            <div class="cat-title-sub" data-ui-en={`artCategories.${cat.key}.title`}>{cat.titleEn}</div>
            <p class="cat-desc" data-ui-ta={`artCategories.${cat.key}.desc`}>{cat.descTa}</p>
            <p class="cat-desc-sub" data-ui-en={`artCategories.${cat.key}.desc`}>{cat.descEn}</p>
          </div>
          <div class="cat-footer">
            <span data-ui-ta={`artCategories.${cat.key}.footer`}>{cat.footerTa}</span> <Icon name="ArrowRight" weight="regular" />
          </div>
        </a>
      ))}
    </div>

    <AdUnit margin="48px 0 0" />
  </div>
</BaseLayout>

<style>
  .arts-hub-page .category-grid {
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }
  .arts-count-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    height: 24px;
    padding: 0 8px;
    border-radius: 100px;
    background: color-mix(in srgb, var(--text-main) 8%, transparent);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    margin-left: 8px;
    vertical-align: middle;
  }
</style>
