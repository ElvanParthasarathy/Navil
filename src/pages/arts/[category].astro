    descEn: 'Color paintings, brushwork studies, and expressive mixed media canvases.',
    editorialTa:
      'வண்ணக் கலவைகளாலும் தூரிகை அசைவுகளாலும் உயிர்ப்பிக்கப்பட்ட ஓவியப் படைப்புகள்.',
    editorialEn:
      'Expressive color studies created across watercolor, acrylic, and mixed physical mediums.',
  },
  digital_arts: {
    key: 'digital_arts',
    titleTa: 'எண்மக்கலைகள்',
    titleEn: 'Digital Arts',
    descTa: 'கணினி மென்பொருளில் உருவாக்கிய கலைப்படைப்புகள்.',
    descEn: 'Digital paintings and experimental graphic works created on screen.',
    editorialTa:
      'மின்னணுத் தூரிகைகளும் வடிவமைப்புக் கருவிகளும் கொண்டு உருவாக்கிய கலைத்தொகுப்பு.',
    editorialEn:
      'Contemporary digital artworks experimenting with texture brushes, symmetry, and mood.',
  },
};

export async function getStaticPaths() {
  const keys = ['pencil', 'illustrations', 'poster', 'editing', 'poems', 'quotes', 'painting', 'digital_arts'];
  return keys.map((category) => ({ params: { category } }));
}

const { category = 'pencil' } = Astro.params;
const meta = ART_CATEGORIES[category] || ART_CATEGORIES.pencil;

const allArts = await getAllArts();
const items = allArts.filter((item) => item?.category === category && !item?.is_private);

function resolveArtThumb(rawUrl: string | undefined): string {
  if (!rawUrl) return '/favicon.png';
  const match = rawUrl.match(/(?:drive\.google\.com\/(?:file\/d\/|open\?id=|thumbnail\?id=)|lh3\.googleusercontent\.com\/d\/)([a-zA-Z0-9_-]+)/i);
  if (match && match[1]) {
    return `https://drive.google.com/thumbnail?id=${match[1]}&sz=w600`;
  }
  return rawUrl;
}
---

<BaseLayout
  title={`${meta.titleTa} | ${meta.titleEn} — Elvan Navil`}
  description={`${meta.descEn} Browse ${items.length} visual works by Elvan Parthasarathy in the Elvan Navil Arts Gallery.`}
  canonicalPath={`/arts/${category}`}
  mobileTitle={`${meta.titleTa}|${meta.titleEn.toLowerCase()}`}
  backUrl="/arts"
>
  <div class="writings-page arts-category-page page-view fadeIn">
    <header class="writings-header animate-entry">
      <div style="flex: 1;">
        <h1 class="writings-title" lang="ta">
          {meta.titleTa}
          {items.length > 0 && <span class="cat-count-badge">{items.length}</span>}
        </h1>
        <div class="writings-title-sub">{meta.titleEn}</div>
        <p class="writings-subtitle" lang="ta">{meta.descTa}</p>
        <p class="writings-subtitle writings-subtitle-en">{meta.descEn}</p>
      </div>
    </header>

    <div class="arts-interactive-shell animate-entry">
      <ArtsGalleryIsland category={category} client:only="react" />
    </div>

    <AdUnit margin="40px 0" />

    <section class="art-collection-guide" aria-label="Collection Overview and Catalog Index">
      <div class="art-guide-intro">
        <h2 lang="ta">தொகுப்பு அறிமுகம் • About this Collection</h2>
        <p lang="ta">{meta.editorialTa}</p>
        <p>{meta.editorialEn}</p>
      </div>

      {items.length > 0 ? (
        <div class="art-archive-grid">
          {items.map((art) => (
            <article class="art-archive-card">
              {art.image_url && (
                <div class="art-archive-thumb-wrap">
                  <img
                    src={resolveArtThumb(art.image_url)}
                    alt={art.title || meta.titleEn}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )}
              <div class="art-archive-body">
                <h3>{art.title || 'Untitled Artwork'}</h3>
                {(art.date || art.medium || art.classification) && (
                  <p class="art-archive-meta">
                    {[art.medium, art.classification, art.date].filter(Boolean).join(' • ')}
                  </p>
                )}
                {art.description && <p class="art-archive-desc">{art.description}</p>}
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="art-archive-empty">
          புதிய படைப்புகள் விரைவில் சேர்க்கப்படும். New artworks are being curated for this category.
        </p>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .arts-interactive-shell {
    min-height: 260px;
  }
  .art-collection-guide {
    margin-top: 24px;
    padding-top: 28px;
    border-top: 1px solid var(--border-light);
  }
  .art-guide-intro h2 {
    margin: 0 0 10px;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-main);
  }
  .art-guide-intro p {
    margin: 0 0 8px;
    color: var(--text-muted);
    line-height: 1.65;
  }
  .art-archive-grid {
    margin-top: 24px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 18px;
  }
  .art-archive-card {
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .art-archive-thumb-wrap {
    aspect-ratio: 4 / 3;
    background: var(--bg-soft, rgba(128, 128, 128, 0.08));
    overflow: hidden;
  }
  .art-archive-thumb-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .art-archive-body {
    padding: 14px;
  }
  .art-archive-body h3 {
    margin: 0 0 6px;
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--text-main);
  }
  .art-archive-meta {
    margin: 0 0 6px;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .art-archive-desc {
    margin: 0;
    font-size: 0.86rem;
    color: var(--text-muted);
    line-height: 1.5;
  }
  .art-archive-empty {
    margin-top: 16px;
    color: var(--text-muted);
  }
</style>
