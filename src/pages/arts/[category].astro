    descEn: 'Digital illustrations, brand logos, character concepts, and vector art.',
    editorialTa:
      'சின்னங்கள், எழுத்துரு வடிவங்கள் மற்றும் கதைசொல்லும் டிஜிட்டல் சித்திரங்களின் தொகுப்பு.',
    editorialEn:
      'A curated showcase of minimal icons, bespoke Tamil typographic emblems, and vector concept illustrations.',
  },
  poster: {
    key: 'poster',
    titleTa: 'சுவரொட்டிகள்',
    titleEn: 'Posters',
    descTa: 'நிகழ்வுகளுக்கான சுவரொட்டிகள் மற்றும் படைப்பு வடிவமைப்புகள்.',
    descEn: 'Event banners, typographic layouts, and creative poster compositions.',
    editorialTa:
      'கல்லூரி விழாக்கள், பண்பாட்டு நிகழ்வுகள் மற்றும் காட்சித் தொடர்புக்கான சுவரொட்டி வடிவமைப்புகள்.',
    editorialEn:
      'Poster compositions pairing modern visual hierarchy with expressive Tamil and English typography.',
  },
