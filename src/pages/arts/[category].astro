---
import '../../சிறப்புக்கூறுகள்/படைப்புகள்/படைப்புகள்.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdUnit from '../../components/astro/AdUnit.astro';
import ArtsGalleryIsland from '../../components/islands/ArtsGalleryIsland';
import { getAllArts } from '../../lib/content';
import { UI_TA, UI_EN } from '../../i18n';

const ART_KEYS = ['pencil', 'illustrations', 'poster', 'editing', 'poems', 'quotes', 'painting', 'digital_arts'] as const;
type ArtCategoryKey = (typeof ART_KEYS)[number];

export async function getStaticPaths() {
  return ['pencil', 'illustrations', 'poster', 'editing', 'poems', 'quotes', 'painting', 'digital_arts'].map((category) => ({
    params: { category },
  }));
}

const rawCat = Astro.params.category || 'pencil';
const category: ArtCategoryKey = (ART_KEYS as readonly string[]).includes(rawCat)
  ? (rawCat as ArtCategoryKey)
  : 'pencil';
const metaTa = UI_TA.artCategories[category];
const metaEn = UI_EN.artCategories[category];
const meta = {
  key: category,
  titleTa: metaTa.title,
  titleEn: metaEn.title,
  descTa: metaTa.desc,
  descEn: metaEn.desc,
  editorialTa: metaTa.editorial,
  editorialEn: metaEn.editorial,
};

const allArts = await getAllArts();
const items = allArts.filter((item) => item?.category === category && !item?.is_private);

function resolveArtThumb(rawUrl: string | undefined): string {
  if (!rawUrl) return '/favicon.png';
  const match = rawUrl.match(/(?:drive\.google\.com\/(?:file\/d\/|open\?id=|thumbnail\?id=)|lh3\.googleusercontent\.com\/d\/)([a-zA-Z0-9_-]+)/i);
  if (match && match[1]) {
    return `https://drive.google.com/thumbnail?id=${match[1]}&sz=w600`;
  }
  return rawUrl;
}

function cleanArtTitle(
  rawCaption: string | undefined,
  rawTitle: string | undefined,
  fallback: string,
  index: number
): string {
  const src = (rawTitle || rawCaption || '').replace(/&#064;/g, '@').replace(/&amp;/g, '&');
  const firstLine = src
    .split(/\r?\n/)
    .map((s) => s.trim())
    .find((s) => s.length > 0);
  if (!firstLine) return `${fallback} #${index + 1}`;
  const withoutHashTail = firstLine.replace(/(?:\s+#\S+)+$/g, '').trim();
  const title = withoutHashTail || firstLine;
  return title.length > 72 ? `${title.slice(0, 69).trim()}...` : title;
}
---

<BaseLayout
  title={`${meta.titleTa} | ${meta.titleEn} — Elvan Navil`}
  description={`${meta.descEn} Browse ${items.length} visual works by Elvan Parthasarathy in the Elvan Navil Arts Gallery.`}
  canonicalPath={`/arts/${category}`}
  mobileTitle={`${meta.titleTa}|${meta.titleEn.toLowerCase()}`}
  backUrl="/arts"
>
  <div class="writings-page arts-category-page page-view fadeIn">
    <header class="writings-header animate-entry">
      <div style="flex: 1;">
        <h1 class="writings-title" lang="ta">
          <span data-ui-ta={`artCategories.${category}.title`}>{meta.titleTa}</span>
          {items.length > 0 && <span class="cat-count-badge">{items.length}</span>}
        </h1>
        <div class="writings-title-sub" data-ui-en={`artCategories.${category}.title`}>{meta.titleEn}</div>
        <p class="writings-subtitle" lang="ta" data-ui-ta={`artCategories.${category}.desc`}>{meta.descTa}</p>
        <p class="writings-subtitle writings-subtitle-en" data-ui-en={`artCategories.${category}.desc`}>{meta.descEn}</p>
      </div>
    </header>

    <div class="arts-interactive-shell animate-entry">
      <ArtsGalleryIsland category={category} client:only="react" />
    </div>

    <AdUnit margin="40px 0" />

    <section class="art-collection-guide" aria-label="Collection Overview and Catalog Index">
      <div class="art-guide-intro">
        <h2 lang="ta" data-ui-pair="arts.collectionGuideHeading">{UI_TA.arts.collectionGuideHeading} • {UI_EN.arts.collectionGuideHeading}</h2>
        <p lang="ta" data-ui-ta={`artCategories.${category}.editorial`}>{meta.editorialTa}</p>
        <p class="en-sub-inline" data-ui-en={`artCategories.${category}.editorial`}>{meta.editorialEn}</p>
      </div>

      {items.length > 0 ? (
        <div class="art-archive-grid">
          {items.map((art, index) => {
            const thumbRaw = (Array.isArray(art.images) && art.images[0]) || art.image || art.image_url;
            const artTitle = cleanArtTitle(art.caption, art.title, meta.titleEn, index);
            const artDesc = (art.description || '').trim();
            return (
              <article class="art-archive-card">
                {thumbRaw && (
                  <div class="art-archive-thumb-wrap">
                    <img
                      src={resolveArtThumb(thumbRaw)}
                      alt={artTitle}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                )}
                <div class="art-archive-body">
                  <h3>{artTitle}</h3>
                  {(art.date || art.medium || art.classification) && (
                    <p class="art-archive-meta">
                      {[art.medium, art.classification, art.date].filter(Boolean).join(' • ')}
                    </p>
                  )}
                  {artDesc && <p class="art-archive-desc">{artDesc}</p>}
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <p class="art-archive-empty">
          <span data-ui-ta="common.comingSoonArts">{UI_TA.common.comingSoonArts}</span>{' '}
          <span class="en-sub-inline" data-ui-en="common.comingSoonArts">{UI_EN.common.comingSoonArts}</span>
        </p>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .arts-interactive-shell {
    min-height: 260px;
  }
  .art-collection-guide {
    margin-top: 24px;
    padding-top: 28px;
    border-top: 1px solid var(--border-light);
  }
  .art-guide-intro h2 {
    margin: 0 0 10px;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-main);
  }
  .art-guide-intro p {
    margin: 0 0 8px;
    color: var(--text-muted);
    line-height: 1.65;
  }
  .art-archive-grid {
    margin-top: 24px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 18px;
  }
  .art-archive-card {
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .art-archive-thumb-wrap {
    aspect-ratio: 4 / 3;
    background: var(--bg-soft, rgba(128, 128, 128, 0.08));
    overflow: hidden;
  }
  .art-archive-thumb-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .art-archive-body {
    padding: 14px;
  }
  .art-archive-body h3 {
    margin: 0 0 6px;
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--text-main);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .art-archive-meta {
    margin: 0 0 6px;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .art-archive-desc {
    margin: 0;
    font-size: 0.86rem;
    color: var(--text-muted);
    line-height: 1.5;
  }
  .art-archive-empty {
    margin-top: 16px;
    color: var(--text-muted);
  }
  @media (max-width: 768px) {
    .art-collection-guide {
      padding-inline: 18px;
      box-sizing: border-box;
    }
    .arts-category-page .elvan-ad-slot-wrapper {
      padding-inline: 18px;
      box-sizing: border-box;
    }
  }
</style>
