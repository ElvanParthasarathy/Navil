---
import '../../சிறப்புக்கூறுகள்/படைப்புகள்/படைப்புகள்.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdUnit from '../../components/astro/AdUnit.astro';
import ArtsGalleryIsland from '../../components/islands/ArtsGalleryIsland';
import { getAllArts } from '../../lib/content';

interface ArtCategoryMeta {
  key: string;
  titleTa: string;
  titleEn: string;
  descTa: string;
  descEn: string;
  editorialEn: string;
  editorialTa: string;
}

const ART_CATEGORIES: Record<string, ArtCategoryMeta> = {
  pencil: {
    key: 'pencil',
    titleTa: 'கரிக்கோல் ஓவியங்கள்',
    titleEn: 'Pencil Drawings',
    descTa: 'கையால் வரைந்த பென்சில் ஓவியங்கள் மற்றும் உருவப் படங்கள்.',
    descEn: 'Freehand graphite pencil sketches, shading studies, and portrait artworks.',
    editorialTa:
      'ஒளி-நிழல் நுணுக்கங்களுடன் காகிதத்தில் கையால் வரையப்பட்ட கரிக்கோல் ஓவியத் தொகுப்பு.',
    editorialEn:
      'Explore hand-drawn graphite studies focusing on natural shading, expressive portraiture, and fine line textures.',
