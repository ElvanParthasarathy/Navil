    titleTa: 'தொகுப்புகள்',
    titleEn: 'Editings',
    descTa: 'புகைப்படத் திருத்தங்கள் மற்றும் எண்மக் காட்சிப் படைப்புகள்.',
    descEn: 'Photo manipulations, retouching experiments, and layered visual compositions.',
    editorialTa:
      'வண்ணச் சமநிலையும் ஒளிப்பதிவு நுட்பமும் இணைந்த புகைப்படத் தொகுப்புப் படைப்புகள்.',
    editorialEn:
      'Layered composite edits exploring color grading, atmospheric lighting, and visual storytelling.',
  },
  poems: {
    key: 'poems',
    titleTa: 'நவில் மிழிகள் — காட்சிப் படங்கள்',
    titleEn: 'Visual Poem Cards',
    descTa: 'கவிதை வரிகளைத் தாங்கிய காட்சி வடிவமைப்புகள்.',
    descEn: 'Illustrated poetry cards pairing original Tamil verses with visual typography.',
    editorialTa:
      'இலக்கிய வரிகளையும் அழகிய எழுத்தமைப்பையும் ஒருங்கே கொண்ட கவிதை அட்டைகள்.',
    editorialEn:
      'Typographic cards crafted for sharing bilingual verse snippets alongside minimalist imagery.',
  },
  quotes: {
    key: 'quotes',
    titleTa: 'நவில் மொழிகள் — காட்சிப் படங்கள்',
    titleEn: 'Visual Quote Cards',
    descTa: 'சிந்தனைத் துளிகளின் காட்சி வடிவமைப்புகள்.',
    descEn: 'Typographic quote cards highlighting short Tamil and English reflections.',
    editorialTa:
      'நம் சிந்தனையைத் தூண்டும் சிறு தொடர்களின் காட்சி வடிவப் பகிர்வுகள்.',
    editorialEn:
      'Designed typographic cards featuring original aphorisms and timeless cultural observations.',
  },
  painting: {
    key: 'painting',
    titleTa: 'ஓவியங்கள்',
    titleEn: 'Paintings',
