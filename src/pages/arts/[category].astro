---
import '../../சிறப்புக்கூறுகள்/படைப்புகள்/படைப்புகள்.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdUnit from '../../components/astro/AdUnit.astro';
import ArtsGalleryIsland from '../../components/islands/ArtsGalleryIsland';
import { getAllArts } from '../../lib/content';
import { UI_TA, UI_EN } from '../../i18n';

const ART_KEYS = ['pencil', 'illustrations', 'poster', 'editing', 'poems', 'quotes', 'painting', 'digital_arts'] as const;
type ArtCategoryKey = (typeof ART_KEYS)[number];

export async function getStaticPaths() {
  return ['pencil', 'illustrations', 'poster', 'editing', 'poems', 'quotes', 'painting', 'digital_arts'].map((category) => ({
    params: { category },
  }));
}

const rawCat = Astro.params.category || 'pencil';
const category: ArtCategoryKey = (ART_KEYS as readonly string[]).includes(rawCat)
  ? (rawCat as ArtCategoryKey)
  : 'pencil';
const metaTa = UI_TA.artCategories[category];
const metaEn = UI_EN.artCategories[category];
const meta = {
  key: category,
  titleTa: metaTa.title,
  titleEn: metaEn.title,
  descTa: metaTa.desc,
  descEn: metaEn.desc,
};

const allArts = await getAllArts();
const items = allArts.filter((item) => item?.category === category && !item?.is_private);
---

<BaseLayout
  title={`${meta.titleTa} | ${meta.titleEn} — Elvan Navil`}
  description={`${meta.descEn} Browse ${items.length} visual works by Elvan Parthasarathy in the Elvan Navil Arts Gallery.`}
  canonicalPath={`/arts/${category}`}
  mobileTitle={`${meta.titleTa}|${meta.titleEn.toLowerCase()}`}
  backUrl="/arts"
>
  <div class="writings-page arts-category-page page-view fadeIn">
    <header class="writings-header animate-entry">
      <div style="flex: 1;">
        <h1 class="writings-title" lang="ta">
          <span data-ui-ta={`artCategories.${category}.title`}>{meta.titleTa}</span>
          {items.length > 0 && <span class="cat-count-badge">{items.length}</span>}
        </h1>
        <div class="writings-title-sub" data-ui-en={`artCategories.${category}.title`}>{meta.titleEn}</div>
        <p class="writings-subtitle" lang="ta" data-ui-ta={`artCategories.${category}.desc`}>{meta.descTa}</p>
        <p class="writings-subtitle writings-subtitle-en" data-ui-en={`artCategories.${category}.desc`}>{meta.descEn}</p>
      </div>
    </header>

    <div class="arts-interactive-shell animate-entry">
      <ArtsGalleryIsland category={category} client:only="react" />
    </div>

    <AdUnit margin="40px 0" />
  </div>
</BaseLayout>

<style>
  .arts-interactive-shell {
    min-height: 260px;
  }
  @media (max-width: 768px) {
    .arts-category-page .elvan-ad-slot-wrapper {
      padding-inline: 18px;
      box-sizing: border-box;
    }
  }
</style>
