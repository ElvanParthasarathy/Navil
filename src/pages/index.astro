---
import '../சிறப்புக்கூறுகள்/முகப்பு/முகப்பு.css';
import '../சிறப்புக்கூறுகள்/பதிவிறக்கங்கள்/பதிவிறக்கங்கள்.css';
import '../சிறப்புக்கூறுகள்/படைப்புகள்/படைப்புகள்.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import AdUnit from '../components/astro/AdUnit.astro';
import Icon from '../components/astro/Icon.astro';
import {
  getCategoryPosts,
  getPrimaryTitle,
  getPrimaryExcerpt,
  formatPlayerPoem,
  formatPlayerQuote,
} from '../lib/content';
import { UI_TA, UI_EN } from '../i18n';

const [poems, quotes, articles] = await Promise.all([
  getCategoryPosts('poems'),
  getCategoryPosts('quotes'),
  getCategoryPosts('articles'),
]);

const initialPoem = formatPlayerPoem(poems[0] || null);
const initialQuote = formatPlayerQuote(quotes[0] || null);

const poemsPool = poems.map((p) => formatPlayerPoem(p));
const quotesPool = quotes.map((q) => formatPlayerQuote(q));
const featuredArticles = articles.slice(0, 4);

const CLASSIFICATION_COLORS: Record<string, string> = {
  அகம்: '#e8a0bf',
  புறம்: '#d4af37',
};
function getClassColor(name: string) {
  if (!name) return '#888';
  if (CLASSIFICATION_COLORS[name]) return CLASSIFICATION_COLORS[name];
  let hash = 0;
  for (let i = 0; i < name.length; i++) hash = name.charCodeAt(i) + ((hash << 5) - hash);
  const hue = ((hash % 360) + 360) % 360;
  return `hsl(${hue}, 55%, 60%)`;
}
---

<BaseLayout
  title={`${UI_TA.brand.name} | ${UI_EN.brand.name} — Bilingual Digital Creation Studio`}
  description="Elvan Navil is an independent bilingual Tamil-English digital creation studio crafting thoughtful desktop software (Nammil), linguistic tools, and original literature."
  canonicalPath="/"
  mobileTitle={UI_TA.brand.name}
>
  <div class="home-page company-home-page page-view fadeIn">
    <!-- 1. STUDIO HEADER -->
    <header class="home-brand-header animate-entry">
      <h1 class="home-brand-title" lang="ta" data-ui-ta="brand.name">{UI_TA.brand.name}</h1>
      <div class="home-brand-title-sub" data-ui-en="brand.name">{UI_EN.brand.name}</div>
      <p class="home-brand-subtitle" lang="ta" data-ui-ta="home.welcomeSubtitle">
        {UI_TA.home.welcomeSubtitle}
      </p>
      <p class="home-brand-subtitle home-brand-subtitle-en" data-ui-en="home.welcomeSubtitle">
        {UI_EN.home.welcomeSubtitle}
      </p>
    </header>

    <!-- 2. BRAND DEFINITION & ETYMOLOGY -->
    <div class="dictionary-container animate-entry">
      <div class="dict-card">
        <div class="dict-word-header">
          <span class="dict-word" lang="ta" data-ui-ta="brand.navilWord">{UI_TA.brand.navilWord}</span>
          <span class="dict-meta" data-ui-ta="brand.navilPos">{UI_TA.brand.navilPos}</span>
        </div>
        <p class="dict-definition" lang="ta" data-ui-ta="brand.navilDef">
          {UI_TA.brand.navilDef}
        </p>
      </div>

      <div class="dict-card dict-card-en">
        <div class="dict-word-header">
          <span class="dict-word" data-ui-en="brand.navilWord">{UI_EN.brand.navilWord}</span>
          <span class="dict-meta" data-ui-en="brand.navilPos">{UI_EN.brand.navilPos}</span>
        </div>
        <p class="dict-definition" data-ui-en="brand.navilDef">
          {UI_EN.brand.navilDef}
        </p>
      </div>
    </div>

    <!-- 3. FEATURED PRODUCTS: NAMMIL & NAVIL TRANSLITERATOR -->
    <section class="home-section animate-entry" style="margin-top: 48px;">
      <div class="home-section-header" style="margin: 0 0 20px; padding-bottom: 4px;">
        <h2 class="home-section-title" lang="ta" data-ui-ta="home.creationsTitle">{UI_TA.home.creationsTitle}</h2>
        <div class="home-section-desc" data-ui-en="home.creationsDesc">{UI_EN.home.creationsDesc}</div>
      </div>

      <div class="bento-grid" style="margin-top: 0;">
        <div class="span-6" style="display: flex;">
          <a
            href="/downloads/nammil"
            id="home-nammil-card"
            class="store-app-card"
            style="width: 100%; display: flex; flex-direction: column; justify-content: space-between;"
            title="Nammil — Multi-Account WhatsApp Companion"
          >
            <div>
              <div class="store-card-header">
                <div class="store-card-identity">
                  <img src="/nammil_icon.png" alt="Nammil App Icon" class="store-card-icon" />
                  <div class="store-card-title-wrap">
                    <h2 class="store-card-title">
                      <span class="store-card-name-ta" lang="ta" data-ui-ta="home.nammilName">{UI_TA.home.nammilName}</span>
                      <span class="store-card-name-en" data-ui-en="home.nammilName">{UI_EN.home.nammilName}</span>
                    </h2>
                    <div class="store-card-meta">
                      <span>Social &amp; Productivity • <span data-ui-ta="nammil.categoryTag">{UI_TA.nammil.categoryTag}</span></span>
                    </div>
                  </div>
                </div>
                <div class="store-card-pill">Free</div>
              </div>

              <div class="store-card-desc-wrap" style="margin-top: 16px;">
                <p class="store-card-desc store-card-desc-ta" lang="ta" data-ui-ta="home.nammilShortDesc">
                  {UI_TA.home.nammilShortDesc}
                </p>
                <p class="store-card-desc store-card-desc-en" data-ui-en="home.nammilShortDesc">
                  {UI_EN.home.nammilShortDesc}
                </p>
              </div>
            </div>

            <div class="store-card-banner-frame" style="margin-top: 18px;">
              <img
                src="/nammil/slide_1.webp"
                alt="Nammil Desktop Screenshot Preview"
                class="store-card-banner-img"
                loading="eager"
              />
            </div>
          </a>
        </div>

        <div class="span-6" style="display: flex;">
          <a
            href="/tools/transliterator"
            class="category-card"
            style="width: 100%; display: flex; flex-direction: column; justify-content: space-between; min-height: auto;"
            title="Navil Transliterator — Phonetic Latin-to-Tamil typing engine"
          >
            <div>
              <div class="cat-icon-box">
                <Icon name="Translate" weight="regular" />
              </div>
              <div class="cat-content" style="margin-top: 16px;">
                <div class="cat-title">
                  <span data-ui-ta="home.translitTitle">{UI_TA.home.translitTitle}</span>
                  <span class="cat-beta-badge">BETA</span>
                </div>
                <div class="cat-title-sub" data-ui-en="home.translitTitle">{UI_EN.home.translitTitle}</div>
                <p class="cat-desc" lang="ta" data-ui-ta="home.translitDesc">{UI_TA.home.translitDesc}</p>
                <p class="cat-desc-sub" data-ui-en="home.translitDesc">{UI_EN.home.translitDesc}</p>
              </div>
              <div style="margin-top: 18px; padding-top: 14px; border-top: 1px solid color-mix(in srgb, var(--text-main) 7%, transparent);" data-no-translit>
                <div class="font-sample-ta" lang="ta" style="font-size: 1rem;">தமிழ் → Thamizhi · Vatteluttu · IAST</div>
                <div class="font-sample-en" style="font-size: 0.84rem;">Tolkappiyam positional phonetics · ka / ga · ca / sa · ta / da</div>
              </div>
            </div>
            <div class="cat-footer" style="margin-top: auto; padding-top: 20px;">
              <span data-ui-ta="home.translitCta">{UI_TA.home.translitCta}</span> <Icon name="ArrowRight" weight="regular" />
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- 4. REFLECTIONS & POETRY PLAYERS -->
    <section class="home-section animate-entry" style="margin-top: 48px;">
      <div class="home-section-header" style="margin: 0 0 20px; padding-bottom: 4px;">
        <h2 class="home-section-title" lang="ta" data-ui-ta="home.navilgalTitle">{UI_TA.home.navilgalTitle}</h2>
        <div class="home-section-desc" data-ui-en="home.navilgalDesc">{UI_EN.home.navilgalDesc}</div>
      </div>

      <div class="bento-grid" style="margin-top: 0;">
        <!-- POEM PLAYER -->
        <section class="bento-card span-6 quote-bento clickable-card" id="home-poem-card" data-href={(initialPoem.slug || initialPoem.id) ? `/writings/poems/${encodeURIComponent(initialPoem.slug || initialPoem.id)}` : '/writings/poems'}>
          <div class="quote-header-row">
            <span class="quote-tag-badge" lang="ta" data-ui-pair="home.poemCardBadge">{UI_TA.home.poemCardBadge} • {UI_EN.home.poemCardBadge}</span>
            <button type="button" id="refresh-poem-btn" class="quote-refresh-btn" title="Read another poem" aria-label="Read another poem">
              <Icon name="ArrowClockwise" weight="regular" size={18} />
            </button>
          </div>

          <div class="player-display" id="poem-player-display">
            <p class="player-main-text" id="poem-main-text" lang={initialPoem.main.lang}>{initialPoem.main.text}</p>
            {initialPoem.sub && (
              <div class="player-sub-display" id="poem-sub-wrap">
                <p class="player-sub-text" id="poem-sub-text" lang={initialPoem.sub.lang}>{initialPoem.sub.text}</p>
              </div>
            )}
            <div class="player-read-more-container">
              <a
                id="poem-read-link"
                href={(initialPoem.slug || initialPoem.id) ? `/writings/poems/${encodeURIComponent(initialPoem.slug || initialPoem.id)}` : '/writings/poems'}
                class="player-read-more-btn"
                style="text-decoration: none;"
              >
                Click here to read more <Icon name="ArrowRight" weight="regular" size={14} class="arrow" />
              </a>
              {initialPoem.classification && (
                <span class="classification-badge" id="poem-class-badge" style={`color: ${getClassColor(initialPoem.classification)};`}>
                  {initialPoem.classification}
                </span>
              )}
            </div>
          </div>
          <div style="margin-top: 14px; font-size: 0.78rem; color: var(--text-muted);">
            <span id="poem-theme-label" style="font-weight: 600; color: var(--text-main);">{initialPoem.theme}</span>
          </div>
        </section>

        <!-- QUOTE PLAYER -->
        <section class="bento-card span-6 quote-bento clickable-card" id="home-quote-card" data-href={(initialQuote.slug || initialQuote.id) ? `/writings/quotes/${encodeURIComponent(initialQuote.slug || initialQuote.id)}` : '/writings/quotes'}>
          <div class="quote-header-row">
            <span class="quote-tag-badge" lang="ta" data-ui-pair="home.quoteCardBadge">{UI_TA.home.quoteCardBadge} • {UI_EN.home.quoteCardBadge}</span>
            <button type="button" id="refresh-quote-btn" class="quote-refresh-btn" title="Read another reflection" aria-label="Read another reflection">
              <Icon name="ArrowClockwise" weight="regular" size={18} />
            </button>
          </div>

          <div class="player-display" id="quote-player-display">
            <blockquote class="player-main-text" id="quote-main-text" lang={initialQuote.mainLang}>“{initialQuote.main}”</blockquote>
            {initialQuote.sub && (
              <div class="player-sub-display" id="quote-sub-wrap">
                <p class="player-sub-text" id="quote-sub-text" lang={initialQuote.subLang}>{initialQuote.sub}</p>
              </div>
            )}
            <div class="player-read-more-container">
              <a
                id="quote-read-link"
                href={(initialQuote.slug || initialQuote.id) ? `/writings/quotes/${encodeURIComponent(initialQuote.slug || initialQuote.id)}` : '/writings/quotes'}
                class="player-read-more-btn"
                style="text-decoration: none;"
              >
                Click here to read more <Icon name="ArrowRight" weight="regular" size={14} class="arrow" />
              </a>
              {initialQuote.classification && (
                <span class="classification-badge" id="quote-class-badge" style={`color: ${getClassColor(initialQuote.classification)};`}>
                  {initialQuote.classification}
                </span>
              )}
            </div>
          </div>
          <div style="margin-top: 14px; font-size: 0.78rem; color: var(--text-muted);">
            <span id="quote-tag-label" style="font-weight: 600; color: var(--text-main);">{initialQuote.tag}</span>
          </div>
        </section>
      </div>
    </section>

    <!-- 5. FEATURED ARTICLES (CRAWLABLE SEMANTIC LINKS FOR GOOGLE & READERS) -->
    {featuredArticles.length > 0 && (
      <section class="home-section animate-entry" style="margin-top: 48px;">
        <div class="home-section-header" style="margin: 0 0 20px; padding-bottom: 4px;">
          <h2 class="home-section-title" lang="ta" data-ui-ta="home.articlesTitle">{UI_TA.home.articlesTitle}</h2>
          <div class="home-section-desc" data-ui-en="home.articlesDesc">{UI_EN.home.articlesDesc}</div>
        </div>

        <div class="bento-grid" style="margin-top: 0;">
          {featuredArticles.map((art) => {
            const artTitle = getPrimaryTitle(art, 'articles');
            const artExcerpt = getPrimaryExcerpt(art, 150);
            return (
              <div class="span-6" style="display: flex;">
                <a
                  href={`/writings/articles/${encodeURIComponent(art.slug)}`}
                  class="category-card"
                  style="width: 100%; min-height: auto; justify-content: space-between;"
                >
                  <div class="cat-content">
                    {art.classification && (
                      <div style="font-size: 0.75rem; font-weight: 700; color: var(--text-muted); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px;">
                        {art.classification}
                      </div>
                    )}
                    <h3 class="cat-title" style="font-size: 1.18rem; line-height: 1.45; margin-bottom: 8px;" lang="ta">
                      {artTitle}
                    </h3>
                    <p class="cat-desc-sub" style="margin: 0; line-height: 1.65;">{artExcerpt}</p>
                  </div>
                  <div class="cat-footer">
                    <span data-ui-pair="common.readArticle">{UI_TA.common.readArticle} • {UI_EN.common.readArticle}</span> <Icon name="ArrowRight" weight="regular" />
                  </div>
                </a>
              </div>
            );
          })}
        </div>
      </section>
    )}

    <AdUnit margin="48px 0 0" />
  </div>

  <script is:inline define:vars={{ poemsPool, quotesPool }}>
    (function () {
      function initHomePage() {
        var poemCard = document.getElementById('home-poem-card');
        var quoteCard = document.getElementById('home-quote-card');
        var refreshPoemBtn = document.getElementById('refresh-poem-btn');
        var refreshQuoteBtn = document.getElementById('refresh-quote-btn');
        if (!poemCard || poemCard.dataset.bound) return;
        poemCard.dataset.bound = '1';

        var poemIdx = 0;
        var quoteIdx = 0;

        poemCard.addEventListener('click', function (e) {
          if (e.target.closest('button') || e.target.closest('a')) return;
          var link = document.getElementById('poem-read-link');
          if (link) link.click();
        });

        if (quoteCard) {
          quoteCard.addEventListener('click', function (e) {
            if (e.target.closest('button') || e.target.closest('a')) return;
            var link = document.getElementById('quote-read-link');
            if (link) link.click();
          });
        }

        if (refreshPoemBtn && Array.isArray(poemsPool) && poemsPool.length > 1) {
          refreshPoemBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            var display = document.getElementById('poem-player-display');
            var icon = refreshPoemBtn.querySelector('svg');
            if (icon) icon.classList.add('rotate-icon');
            if (display) display.style.opacity = '0';
            setTimeout(function () {
              poemIdx = (poemIdx + 1) % poemsPool.length;
              var p = poemsPool[poemIdx];
              var mainEl = document.getElementById('poem-main-text');
              var subEl = document.getElementById('poem-sub-text');
              var subWrap = document.getElementById('poem-sub-wrap');
              var linkEl = document.getElementById('poem-read-link');
              var themeEl = document.getElementById('poem-theme-label');
              var badgeEl = document.getElementById('poem-class-badge');
              var pTarget = p.slug || p.id;
              var url = pTarget ? '/writings/poems/' + encodeURIComponent(pTarget) : '/writings/poems';
              if (mainEl) mainEl.textContent = p.main.text;
              if (subEl && subWrap) {
                if (p.sub && p.sub.text) {
                  subWrap.style.display = '';
                  subEl.textContent = p.sub.text;
                } else {
                  subWrap.style.display = 'none';
                }
              }
              if (linkEl) linkEl.setAttribute('href', url);
              poemCard.setAttribute('data-href', url);
              if (themeEl) themeEl.textContent = p.theme;
              if (badgeEl) badgeEl.textContent = p.classification || '';
              if (display) display.style.opacity = '1';
              setTimeout(function () { if (icon) icon.classList.remove('rotate-icon'); }, 450);
            }, 260);
          });
        }

        if (refreshQuoteBtn && Array.isArray(quotesPool) && quotesPool.length > 1) {
          refreshQuoteBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            var display = document.getElementById('quote-player-display');
            var icon = refreshQuoteBtn.querySelector('svg');
            if (icon) icon.classList.add('rotate-icon');
            if (display) display.style.opacity = '0';
            setTimeout(function () {
              quoteIdx = (quoteIdx + 1) % quotesPool.length;
              var q = quotesPool[quoteIdx];
              var mainEl = document.getElementById('quote-main-text');
              var subEl = document.getElementById('quote-sub-text');
              var subWrap = document.getElementById('quote-sub-wrap');
              var linkEl = document.getElementById('quote-read-link');
              var tagEl = document.getElementById('quote-tag-label');
              var badgeEl = document.getElementById('quote-class-badge');
              var qTarget = q.slug || q.id;
              var url = qTarget ? '/writings/quotes/' + encodeURIComponent(qTarget) : '/writings/quotes';
              if (mainEl) mainEl.textContent = '“' + q.main + '”';
              if (subEl && subWrap) {
                if (q.sub) {
                  subWrap.style.display = '';
                  subEl.textContent = q.sub;
                } else {
                  subWrap.style.display = 'none';
                }
              }
              if (linkEl) linkEl.setAttribute('href', url);
              if (quoteCard) quoteCard.setAttribute('data-href', url);
              if (tagEl) tagEl.textContent = q.tag;
              if (badgeEl) badgeEl.textContent = q.classification || '';
              if (display) display.style.opacity = '1';
              setTimeout(function () { if (icon) icon.classList.remove('rotate-icon'); }, 450);
            }, 260);
          });
        }
      }
      initHomePage();
      document.addEventListener('astro:page-load', initHomePage);
    })();
  </script>
</BaseLayout>
