---
import '../சிறப்புக்கூறுகள்/பற்றி/பற்றி.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import AdUnit from '../components/astro/AdUnit.astro';
import Icon from '../components/astro/Icon.astro';
import profilePic from '../வளங்கள்/இன்ஸ்டாகிராம்/தன்னுரு.png';
import profileData from '../தரவு/தன்னுரு.json';
import { getAboutConfig } from '../lib/content';
import { UI_TA, UI_EN } from '../i18n';

const about = await getAboutConfig();

const cards = about.cards || [
  {
    content: `<span lang="ta" style="display: block; margin-bottom: 6px; font-weight: 500;">
    ${UI_TA.about.defaultQuote}
</span>
<span class="en-sub-inline" style="display: block; color: var(--text-muted); font-style: italic; font-weight: 500;">
    ${UI_EN.about.defaultQuote}
</span>`,
  },
  { content: about.identity_text || '' },
  { content: about.education_text || '' },
  { content: about.social_text || '' },
  { content: about.philosophy_lines || '' },
].filter((c) => c.content);

function getSpanClass(index: number) {
  const mod = index % 4;
  if (mod === 0) return 'span-7';
  if (mod === 1) return 'span-5';
  if (mod === 2) return 'span-5';
  return 'span-7';
}
---

<BaseLayout
  title={`${UI_TA.routes.about.title} | ${UI_EN.about.nameTitle}`}
  description="Learn more about Jaiprakash P (Elvan Parthasarathy), engineering student, writer, software developer, and creator behind Elvan Navil."
  canonicalPath="/about"
  ogType="profile"
  mobileTitle={`${UI_TA.routes.about.title}|${UI_EN.routes.about.title}`}
  backUrl="/"
>
  <div class="about-page page-view animate-entry">
    <section class="about-hero animate-entry">
      <div class="hero-avatar-wrapper">
        <div class="hero-avatar-bg"></div>
        <img src={profilePic.src} alt={(profileData as any).name} class="hero-avatar" />
      </div>
      <h1 class="hero-title" lang="ta" data-ui-ta="about.nameTitle">{UI_TA.about.nameTitle}</h1>
      <h2 class="hero-subtitle">{(profileData as any).name} Parthasarathy</h2>
      {about.portfolio_url && (
        <a href={about.portfolio_url} target="_blank" rel="noopener noreferrer" class="explore-portfolio-btn-unique">
          <span data-ui-pair="about.explorePortfolio">{UI_TA.about.explorePortfolio} • {UI_EN.about.explorePortfolio}</span> <Icon name="ArrowRight" weight="regular" />
        </a>
      )}
    </section>

    <div class="about-grid animate-entry" style="animation-delay: 0.1s;">
      {cards.map((card: any, idx: number) => (
        <div class={`about-card ${card.size || getSpanClass(idx)}`}>
          <div class="card-text" set:html={card.content} />
        </div>
      ))}
    </div>

    <AdUnit margin="48px 0" />

    <div class="contact-footer animate-entry" style="animation-delay: 0.2s;">
      <div class="contact-info-block">
        <div class="contact-header">
          <h3 lang="ta">{about.contact_tamil}</h3>
          <div class="contact-divider en-sub-inline"></div>
          <h3 class="en-sub-inline">{about.contact_english}</h3>
        </div>
        <p lang="ta" style="color: #888888; margin: 0;">{about.contact_desc_tamil}</p>
        <p class="en-sub-inline" style="font-size: 0.85rem; color: #888888; margin: 4px 0 0;">{about.contact_desc_english}</p>
      </div>

      <div class="contact-right-side">
        <div class="contact-location">
          <Icon name="MapPin" weight="regular" size={14} />
          <span>{about.location}</span>
        </div>
        <div class="contact-socials">
          <a href="mailto:jaiprakashpartha@gmail.com" class="social-icon-link" aria-label="Email" title="Email">
            <Icon name="EnvelopeSimple" weight="regular" size={20} />
          </a>
          <a href="https://linkedin.com/in/jaiprakashpartha" target="_blank" rel="noreferrer" class="social-icon-link" aria-label="LinkedIn" title="LinkedIn">
            <Icon name="LinkedinLogo" weight="regular" size={20} />
          </a>
          <a href="https://github.com/elvanparthasarathy" target="_blank" rel="noreferrer" class="social-icon-link" aria-label="GitHub" title="GitHub">
            <Icon name="GithubLogo" weight="regular" size={20} />
          </a>
          <a href="https://instagram.com/elvannavil" target="_blank" rel="noreferrer" class="social-icon-link" aria-label="Instagram" title="Instagram: @elvannavil">
            <Icon name="InstagramLogo" weight="regular" size={20} />
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .about-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px 40px;
    position: relative;
  }
  .about-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 56px;
    padding-top: 24px;
  }
  .hero-avatar-wrapper {
    position: relative;
    width: 180px;
    height: 180px;
    margin-bottom: 24px;
  }
  .hero-avatar-bg {
    position: absolute;
    inset: -15px;
    background: linear-gradient(135deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
    border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%;
    filter: blur(30px);
    opacity: 0.25;
    animation: morph 10s linear infinite alternate;
  }
  @keyframes morph {
    0% { border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%; }
    100% { border-radius: 70% 30% 50% 50% / 30% 60% 40% 70%; }
  }
  .hero-avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 6px solid var(--bg-app);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
    position: relative;
    z-index: 2;
  }
  .hero-title {
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 800;
    margin-bottom: 8px;
    letter-spacing: -1px;
    color: var(--text-main);
  }
  .hero-subtitle {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    color: var(--text-muted);
    font-weight: 500;
    margin: 0;
  }
  .explore-portfolio-btn-unique {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 24px;
    padding: 10px 26px;
    background-color: var(--text-main);
    color: var(--bg-app);
    border-radius: 99px;
    font-weight: 700;
    text-decoration: none;
    font-size: 0.95rem;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.2s ease, box-shadow 0.2s ease;
  }
  .explore-portfolio-btn-unique:hover {
    transform: translate3d(0, -1px, 0);
  }
  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-bottom: 40px;
  }
  .about-card {
    background: linear-gradient(145deg, var(--bg-panel), color-mix(in srgb, var(--bg-panel), transparent 20%));
    padding: 32px;
    border-radius: 28px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  }
  :global([data-theme='dark']) .about-card {
    background: linear-gradient(145deg, var(--bg-panel), color-mix(in srgb, var(--bg-panel), transparent 45%));
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
  }
  .card-text {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--text-main);
    font-weight: 500;
  }
  :global(.card-text p) {
    margin: 0 0 8px;
  }
  :global(.card-text p:last-child) {
    margin-bottom: 0;
  }
  .contact-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 32px;
    background: linear-gradient(145deg, var(--bg-panel), color-mix(in srgb, var(--bg-panel), transparent 20%));
    border-radius: 32px;
    flex-wrap: wrap;
    gap: 24px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
  }
  :global([data-theme='dark']) .contact-footer {
    background: linear-gradient(145deg, var(--bg-panel), color-mix(in srgb, var(--bg-panel), transparent 45%));
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
  }
  .contact-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
  }
  .contact-divider {
    width: 2px;
    height: 24px;
    background: var(--border-color);
    opacity: 0.6;
  }
  .contact-info-block h3 {
    font-weight: 800;
    margin: 0;
  }
  .contact-right-side {
    display: flex;
    flex-direction: column-reverse;
    align-items: flex-end;
    gap: 12px;
  }
  .contact-location {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-muted);
    font-size: 0.85rem;
    padding: 8px 16px;
    background: color-mix(in srgb, var(--text-main), transparent 92%);
    border-radius: 99px;
  }
  .contact-socials {
    display: flex;
    gap: 12px;
  }
  .social-icon-link {
    width: 44px;
    height: 44px;
    background: color-mix(in srgb, var(--text-main), transparent 92%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-main);
    text-decoration: none;
    transition: all 0.3s ease;
  }
  .social-icon-link:hover {
    background: var(--text-main);
    color: var(--bg-app);
    transform: translateY(-3px);
  }
  @media (min-width: 1024px) {
    .about-grid {
      grid-template-columns: repeat(12, 1fr);
      gap: 24px;
    }
    .span-12 { grid-column: span 12; }
    .span-7 { grid-column: span 7; }
    .span-5 { grid-column: span 5; }
  }
  @media (max-width: 1023px) {
    .hero-avatar-wrapper { width: 140px; height: 140px; }
    .contact-footer { flex-direction: column; text-align: center; align-items: center; }
    .contact-header { flex-direction: column; gap: 0; align-items: center; }
    .contact-divider { display: none; }
    .contact-right-side { flex-direction: column; align-items: center; }
  }
</style>
