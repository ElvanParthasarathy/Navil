---
import '../../சிறப்புக்கூறுகள்/படைப்புகள்/படைப்புகள்.css';
import '../../சிறப்புக்கூறுகள்/பதிவிறக்கங்கள்/பதிவிறக்கங்கள்.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdUnit from '../../components/astro/AdUnit.astro';
import { UI_TA, UI_EN } from '../../i18n';
---

<BaseLayout
  title={`${UI_TA.downloads.title} | ${UI_EN.downloads.title} — ${UI_EN.brand.name}`}
  description="Official desktop applications by Elvan Navil, including Nammil privacy-first WhatsApp companion for Windows."
  canonicalPath="/downloads"
  mobileTitle={`${UI_TA.routes.downloads.title}|${UI_EN.routes.downloads.title}`}
  backUrl="/"
>
  <div class="writings-page page-view fadeIn">
    <header class="writings-header animate-entry">
      <div style="flex: 1;">
        <h1 class="writings-title" data-ui-ta="downloads.title">{UI_TA.downloads.title}</h1>
        <div class="writings-title-sub" data-ui-en="downloads.title">{UI_EN.downloads.title}</div>
        <p class="writings-subtitle" data-ui-ta="downloads.subtitle">{UI_TA.downloads.subtitle}</p>
        <p class="writings-subtitle writings-subtitle-en" data-ui-en="downloads.subtitle">{UI_EN.downloads.subtitle}</p>
      </div>
    </header>

    <div class="store-app-grid animate-entry">
      <a
        href="/downloads/nammil"
        id="downloads-nammil-card"
        class="store-app-card"
        title="Nammil — Multi-Account WhatsApp Companion"
      >
        <div class="store-card-header">
          <div class="store-card-identity">
            <img src="/nammil_icon.png" alt="Nammil App Icon" class="store-card-icon" />
            <div class="store-card-title-wrap">
              <h2 class="store-card-title">
                <span class="store-card-name-ta" lang="ta" data-ui-ta="home.nammilName">{UI_TA.home.nammilName}</span>
                <span class="store-card-name-en" data-ui-en="home.nammilName">{UI_EN.home.nammilName}</span>
              </h2>
              <div class="store-card-meta">
                <span>Social &amp; Productivity • <span data-ui-ta="nammil.categoryTag">{UI_TA.nammil.categoryTag}</span></span>
              </div>
            </div>
          </div>
          <div class="store-card-pill">Free</div>
        </div>

        <div class="store-card-desc-wrap">
          <p class="store-card-desc store-card-desc-ta" lang="ta" data-ui-ta="home.nammilShortDesc">
            {UI_TA.home.nammilShortDesc}
          </p>
          <p class="store-card-desc store-card-desc-en" data-ui-en="home.nammilShortDesc">
            {UI_EN.home.nammilShortDesc}
          </p>
        </div>

        <div class="store-card-banner-frame">
          <img
            src="/nammil/slide_1.webp"
            alt="Nammil Desktop Screenshot Preview"
            class="store-card-banner-img"
            loading="eager"
          />
        </div>
      </a>
    </div>

    <AdUnit margin="48px 0 0" />
  </div>

  <script is:inline>
    (function () {
      function bindDownloads() {
        var card = document.getElementById('downloads-nammil-card');
        if (!card || card.dataset.bound) return;
        card.dataset.bound = '1';
        card.addEventListener('mousedown', function (e) {
          var rect = card.getBoundingClientRect();
          var ripple = document.createElement('span');
          ripple.className = 'store-card-ripple';
          ripple.style.left = (e.clientX - rect.left) + 'px';
          ripple.style.top = (e.clientY - rect.top) + 'px';
          card.appendChild(ripple);
          setTimeout(function () { ripple.remove(); }, 650);
        });
      }
      bindDownloads();
      document.addEventListener('astro:page-load', bindDownloads);
    })();
  </script>
</BaseLayout>
