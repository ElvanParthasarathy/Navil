---
import '../../சிறப்புக்கூறுகள்/பதிவிறக்கங்கள்/பதிவிறக்கங்கள்.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdUnit from '../../components/astro/AdUnit.astro';
import Icon from '../../components/astro/Icon.astro';
import { BASE_URL } from '../../lib/content';
import { UI_TA, UI_EN } from '../../i18n';

const slides = [
  { src: '/nammil/slide_1.webp', titleTa: 'பல கணக்குகள் • முதன்மை கணக்கு', titleEn: 'Multi Accounts • Primary Session' },
  { src: '/nammil/slide_2.webp', titleTa: 'பல கணக்குகள் • இரண்டாம் கணக்கு', titleEn: 'Multi Accounts • Secondary Session' },
  { src: '/nammil/slide_3.webp', titleTa: 'தானியங்கி கோப்பு வரிசையாக்கம்', titleEn: 'Automated Media Sorter' },
  { src: '/nammil/slide_4.webp', titleTa: 'செயலியில் உடனடி அறிவிப்புகள்', titleEn: 'In-App Notification Feed' },
  { src: '/nammil/slide_5.webp', titleTa: 'அமைப்புகள் & செயலி விவரம்', titleEn: 'Settings & About Nammil' },
  { src: '/nammil/slide_6.webp', titleTa: 'நம்மில் • அடையாள முத்திரை', titleEn: 'Nammil • Brand Identity' },
];

const nammilJsonLd = {
  '@type': 'SoftwareApplication',
  name: 'Nammil (நம்மில்)',
  operatingSystem: 'Windows 10, Windows 11 (64-bit)',
  applicationCategory: 'SocialNetworkingApplication',
  softwareVersion: '1.2.9',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@id': `${BASE_URL}/#organization` },
  description:
    'A privacy-focused desktop companion for WhatsApp featuring up to 5 isolated multi-account sessions, automated media sorting, and native Windows notifications.',
};
---

<BaseLayout
  title={`${UI_TA.nammil.title} • ${UI_EN.nammil.title} — WhatsApp Desktop Companion | ${UI_EN.brand.name}`}
  description="Download Nammil for Windows — a privacy-first WhatsApp desktop companion with 5 isolated accounts, automated media organizer, and bespoke sound notifications."
  canonicalPath="/downloads/nammil"
  ogImage={`${BASE_URL}/nammil_icon.png`}
  favicon="/nammil_icon.png"
  mobileTitle={UI_TA.nammil.title}
  backUrl="/downloads"
  jsonLd={nammilJsonLd}
>
  <div class="ms-store-page page-view fadeIn">
    <div class="ms-ambient-glow" aria-hidden="true"></div>

    <div class="ms-store-container">
      <!-- 1. APP HERO -->
      <header class="ms-hero-card animate-entry">
        <div class="ms-hero-top-row">
          <div class="ms-app-icon-wrap">
            <img src="/nammil_icon.png" alt="Nammil App Icon" class="ms-app-icon-img" />
          </div>

          <div class="ms-hero-title-group">
            <h1 class="ms-app-title">
              <span class="ms-title-main" lang="ta" data-ui-ta="nammil.title">{UI_TA.nammil.title}</span>
              <span class="ms-title-sub" data-ui-en="nammil.title">{UI_EN.nammil.title}</span>
            </h1>
            <div class="ms-developer-link">
              <a href="/about" class="ms-dev-item" data-ui-en="brand.name">{UI_EN.brand.name}</a>
            </div>
            <div class="ms-category-row">
              <span class="ms-category-tag" data-ui-pair="nammil.categoryTag">{UI_TA.nammil.categoryTag} • {UI_EN.nammil.categoryTag}</span>
            </div>
          </div>
        </div>

        <div class="ms-hero-desc-wrap">
          <p class="ms-hero-desc" lang="ta" data-ui-ta="nammil.heroDesc">
            {UI_TA.nammil.heroDesc}
          </p>
          <p class="ms-hero-desc ms-hero-desc-en" data-ui-en="nammil.heroDesc">
            {UI_EN.nammil.heroDesc}
          </p>
        </div>

        <div class="ms-action-row">
          <a
            href="https://github.com/ElvanParthasarathy/Nammil/releases/latest/download/Nammil-Setup.exe"
            class="ms-btn-primary"
            download
            title="Download Nammil (.exe ~114MB)"
          >
            <Icon name="FaWindows" size={18} />
            <div class="ms-btn-text">
              <span class="ms-btn-label" data-ui-ta="nammil.downloadBtn">{UI_TA.nammil.downloadBtn}</span>
              <span class="ms-btn-sublabel" data-ui-en="nammil.downloadBtn">{UI_EN.nammil.downloadBtn}</span>
            </div>
          </a>
          <a
            href="https://github.com/ElvanParthasarathy/Nammil"
            target="_blank"
            rel="noreferrer"
            class="ms-btn-secondary ms-btn-github"
            title="View Source on GitHub"
          >
            <Icon name="GithubLogo" weight="bold" size={20} />
            <div class="ms-btn-text">
              <span class="ms-btn-label" data-ui-ta="nammil.githubBtn">{UI_TA.nammil.githubBtn}</span>
              <span class="ms-btn-sublabel" data-ui-en="nammil.githubBtn">{UI_EN.nammil.githubBtn}</span>
            </div>
          </a>
        </div>
      </header>

      <!-- 2. STORE BODY -->
      <div class="ms-store-body animate-entry">
        <!-- SCREENSHOTS -->
        <section class="ms-section ms-screenshots-section" aria-label="Screenshots">
          <div class="ms-section-header-link" id="nammil-open-lb">
            <h2 class="ms-section-title" data-ui-pair="nammil.screenshotsHeading">{UI_TA.nammil.screenshotsHeading} • {UI_EN.nammil.screenshotsHeading}</h2>
            <Icon name="CaretRight" weight="bold" size={18} class="ms-section-chevron" />
          </div>

          <div class="ms-screenshots-scroller-wrap">
            <button type="button" id="nammil-scroll-left" class="ms-scroll-nav-btn prev" style="display: none;" aria-label="Previous screenshots">
              <Icon name="CaretLeft" weight="bold" size={22} />
            </button>
            <div class="ms-screenshots-scroller" id="nammil-scroller">
              {slides.map((slide, idx) => (
                <div class="ms-shot-frame" data-slide-idx={idx} title="Click to view fullscreen">
                  <img
                    src={slide.src}
                    alt={slide.titleEn}
                    class="ms-shot-img"
                    loading={idx < 2 ? 'eager' : 'lazy'}
                  />
                </div>
              ))}
            </div>
            <button type="button" id="nammil-scroll-right" class="ms-scroll-nav-btn next" aria-label="Next screenshots">
              <Icon name="CaretRight" weight="bold" size={22} />
            </button>
          </div>
        </section>

        <!-- DESCRIPTION -->
        <section class="ms-section ms-desc-section">
          <h2 class="ms-section-title" data-ui-pair="nammil.descriptionHeading">{UI_TA.nammil.descriptionHeading} • {UI_EN.nammil.descriptionHeading}</h2>
          <div class="ms-desc-body">
            <div class="ms-desc-block ms-desc-ta" lang="ta">
              <p>
                வாட்ஸ்அப் கணினிக்கான அதிகாரப்பூர்வ செயலியும் இணையப் பதிப்பும் கடுமையான ஒற்றைக் கணக்குக் கட்டுப்பாட்டைக் கொண்டுள்ளன. தனிப்பட்ட பயன்பாடு, அலுவலகப் பணி, வணிகம் மற்றும் வாடிக்கையாளர் கணக்குகளை நிர்வகிப்போர், பல உலாவி சாளரங்களையும், மறைமுக (incognito) தாவல்களையும் கையாள வேண்டிய கட்டாயத்திற்கு உள்ளாகின்றனர். மேலும், பெறப்படும் படங்கள், குரல் பதிவுகள், மீம்கள், ஆவணங்கள் அனைத்தும் பொதுவான Downloads கோப்புறையில் கலந்து ஒழுங்கின்மையை ஏற்படுத்துகின்றன.
              </p>
              <div class="ms-desc-expanded-content" id="nammil-ta-more" style="display: none;">
                <p>
                  <strong>நம்மில் (Nammil)</strong> இக்குறைபாடுகளை முழுமையாகக் களைய எல்வன் பார்த்தசாரதியால் எல்வன் நவிலில் உருவாக்கப்பட்டது. நவீன எலக்ட்ரான் கட்டமைப்பில் இயங்கும் இச்செயலி, 5 சுயாதீன வாட்ஸ்அப் கணக்குகள் வரை தனித்தனி அமர்வுகளாகப் பிரித்து குக்கீ மற்றும் நற்சான்றிதழ் முரண்பாடின்றி ஒரே மேடையில் இயக்குகிறது.
                </p>
                <p>
                  உள்வரும் கோப்புகளைத் தானாக வகைப்படுத்தி (<code>Documents\Nammil\Media</code>), உள்ளமைக்கப்பட்ட தேடல் மற்றும் Recycle Bin மீட்புடன் நிர்வகிக்கும் ஊடக உலாவி, 6 பிரத்யேக தமிழ்ப் பெயரிலான விண்டோஸ் ஒலி எச்சரிக்கைகள், 7 மொழி மற்றும் மாற்று-எழுத்துரு நுட்பங்கள், எல்வன் சான்ஸ் அச்சுக்கலை மற்றும் 100% உள்ளூர் தனியுரிமையுடன் விண்டோஸிற்கான நேர்த்தியான அனுபவத்தை நம்மில் வழங்குகிறது.
                </p>
              </div>
              <button type="button" class="ms-show-more-btn" id="nammil-ta-btn" aria-expanded="false" data-ui-pair="nammil.showMore">
                {UI_TA.nammil.showMore} • {UI_EN.nammil.showMore}
              </button>
            </div>

            <div class="ms-desc-divider"></div>

            <div class="ms-desc-block ms-desc-en" lang="en">
              <p>
                Official WhatsApp Desktop and Web clients enforce a strict single-account lock. Users managing personal, business, client, or family accounts are forced to juggle multiple browser windows, incognito profiles, or memory-heavy workarounds. Standard web clients dump every received picture, meme, voice note, and document haphazardly into your generic Downloads folder, while browser notifications fail when background tabs sleep.
              </p>
              <div class="ms-desc-expanded-content" id="nammil-en-more" style="display: none;">
                <p>
                  <strong>Nammil</strong> was conceived and developed by Elvan Parthasarathy at Elvan Navil to provide a seamless, native desktop solution. Built on modern Electron technology, it lets you safely run up to 5 independent WhatsApp accounts side-by-side in isolated persistent sessions with zero cookie, session, or credential collisions.
                </p>
                <p>
                  Featuring an automated media organizer (<code>Documents\Nammil\Media</code>) with fast search and safe Recycle Bin recovery, 6 bespoke Windows notification chimes, deep localization across 7 language variants powered by navil-engine, bespoke Elvan Sans typography, and 100% offline privacy with zero external telemetry.
                </p>
              </div>
              <button type="button" class="ms-show-more-btn" id="nammil-en-btn" aria-expanded="false" data-ui-en="nammil.showMore">
                {UI_EN.nammil.showMore}
              </button>
            </div>
          </div>
        </section>

        <!-- FEATURES -->
        <section class="ms-section ms-features-section">
          <h2 class="ms-section-title" data-ui-pair="nammil.featuresHeading">{UI_TA.nammil.featuresHeading} • {UI_EN.nammil.featuresHeading}</h2>
          <div class="ms-features-grid">
            <div class="ms-feature-item">
              <div class="ms-feature-icon-box">
                <Icon name="Users" weight="regular" size={22} />
              </div>
              <div class="ms-feature-text">
                <h3 class="ms-feature-heading">
                  <span class="ms-feature-title-ta" data-ui-ta="nammil.features.sandboxTitle">{UI_TA.nammil.features.sandboxTitle}</span>
                  <span class="ms-feature-title-sep">•</span>
                  <span class="ms-feature-title-en" data-ui-en="nammil.features.sandboxTitle">{UI_EN.nammil.features.sandboxTitle}</span>
                </h3>
                <p class="ms-feature-copy-ta" lang="ta" data-ui-ta="nammil.features.sandboxDesc">
                  {UI_TA.nammil.features.sandboxDesc}
                </p>
                <div class="ms-feature-divider"></div>
                <p class="ms-feature-copy-en" data-ui-en="nammil.features.sandboxDesc">
                  {UI_EN.nammil.features.sandboxDesc}
                </p>
              </div>
            </div>

            <div class="ms-feature-item">
              <div class="ms-feature-icon-box">
                <Icon name="FolderSimple" weight="regular" size={22} />
              </div>
              <div class="ms-feature-text">
                <h3 class="ms-feature-heading">
                  <span class="ms-feature-title-ta" data-ui-ta="nammil.features.mediaTitle">{UI_TA.nammil.features.mediaTitle}</span>
                  <span class="ms-feature-title-sep">•</span>
                  <span class="ms-feature-title-en" data-ui-en="nammil.features.mediaTitle">{UI_EN.nammil.features.mediaTitle}</span>
                </h3>
                <p class="ms-feature-copy-ta" lang="ta" data-ui-ta="nammil.features.mediaDesc">
                  {UI_TA.nammil.features.mediaDesc}
                </p>
                <div class="ms-feature-divider"></div>
                <p class="ms-feature-copy-en" data-ui-en="nammil.features.mediaDesc">
                  {UI_EN.nammil.features.mediaDesc}
                </p>
              </div>
            </div>

            <div class="ms-feature-item">
              <div class="ms-feature-icon-box">
                <Icon name="BellSimpleRinging" weight="regular" size={22} />
              </div>
              <div class="ms-feature-text">
                <h3 class="ms-feature-heading">
                  <span class="ms-feature-title-ta" data-ui-ta="nammil.features.chimesTitle">{UI_TA.nammil.features.chimesTitle}</span>
                  <span class="ms-feature-title-sep">•</span>
                  <span class="ms-feature-title-en" data-ui-en="nammil.features.chimesTitle">{UI_EN.nammil.features.chimesTitle}</span>
                </h3>
                <p class="ms-feature-copy-ta" lang="ta" data-ui-ta="nammil.features.chimesDesc">
                  {UI_TA.nammil.features.chimesDesc}
                </p>
                <div class="ms-feature-divider"></div>
                <p class="ms-feature-copy-en" data-ui-en="nammil.features.chimesDesc">
                  {UI_EN.nammil.features.chimesDesc}
                </p>
              </div>
            </div>

            <div class="ms-feature-item">
              <div class="ms-feature-icon-box">
                <Icon name="Globe" weight="regular" size={22} />
              </div>
              <div class="ms-feature-text">
                <h3 class="ms-feature-heading">
                  <span class="ms-feature-title-ta" data-ui-ta="nammil.features.langTitle">{UI_TA.nammil.features.langTitle}</span>
                  <span class="ms-feature-title-sep">•</span>
                  <span class="ms-feature-title-en" data-ui-en="nammil.features.langTitle">{UI_EN.nammil.features.langTitle}</span>
                </h3>
                <p class="ms-feature-copy-ta" lang="ta" data-ui-ta="nammil.features.langDesc">
                  {UI_TA.nammil.features.langDesc}
                </p>
                <div class="ms-feature-divider"></div>
                <p class="ms-feature-copy-en" data-ui-en="nammil.features.langDesc">
                  {UI_EN.nammil.features.langDesc}
                </p>
              </div>
            </div>
          </div>
        </section>

        <AdUnit margin="32px 0" />

        <!-- ADDITIONAL INFO -->
        <section class="ms-additional-info-section">
          <h2 class="ms-info-main-title" data-ui-pair="nammil.additionalInfoHeading">{UI_TA.nammil.additionalInfoHeading} • {UI_EN.nammil.additionalInfoHeading}</h2>
          <div class="ms-info-grid">
            <div class="ms-info-cell">
              <Icon name="Package" weight="regular" size={20} class="ms-cell-icon" />
              <div class="ms-cell-content">
                <div class="ms-cell-label">Published by</div>
                <div class="ms-cell-val">Elvan Navil</div>
              </div>
            </div>
            <div class="ms-info-cell">
              <Icon name="ArrowsClockwise" weight="regular" size={20} class="ms-cell-icon" />
              <div class="ms-cell-content">
                <div class="ms-cell-label">Last updated date</div>
                <div class="ms-cell-val">9/15/2026</div>
              </div>
            </div>
            <div class="ms-info-cell">
              <Icon name="CalendarBlank" weight="regular" size={20} class="ms-cell-icon" />
              <div class="ms-cell-content">
                <div class="ms-cell-label">Release date</div>
                <div class="ms-cell-val">9/1/2026</div>
              </div>
            </div>
            <div class="ms-info-cell">
              <Icon name="BookmarkSimple" weight="regular" size={20} class="ms-cell-icon" />
              <div class="ms-cell-content">
                <div class="ms-cell-label">Category</div>
                <div class="ms-cell-val">Social &amp; Productivity</div>
              </div>
            </div>
            <div class="ms-info-cell">
              <Icon name="HardDrive" weight="regular" size={20} class="ms-cell-icon" />
              <div class="ms-cell-content">
                <div class="ms-cell-label">Approximate size</div>
                <div class="ms-cell-val">114.2 MB</div>
              </div>
            </div>
            <div class="ms-info-cell">
              <Icon name="FaWindows" size={18} class="ms-cell-icon" />
              <div class="ms-cell-content">
                <div class="ms-cell-label">Installation</div>
                <div class="ms-cell-val">Get this app on Windows 10 and 11 devices (64-bit). Inno Setup per-user installer (Zero UAC prompts).</div>
              </div>
            </div>
            <div class="ms-info-cell">
              <Icon name="ShieldCheck" weight="regular" size={20} class="ms-cell-icon" />
              <div class="ms-cell-content">
                <div class="ms-cell-label">This app can</div>
                <ul class="ms-cell-list">
                  <li>Access your Internet connection</li>
                  <li>Store and organize local media</li>
                  <li>Runs 100% offline with zero telemetry</li>
                </ul>
              </div>
            </div>
            <div class="ms-info-cell">
              <Icon name="Globe" weight="regular" size={20} class="ms-cell-icon" />
              <div class="ms-cell-content">
                <div class="ms-cell-label">Supported languages</div>
                <ul class="ms-cell-list" data-no-translit>
                  <li>தமிழ் (Tamil)</li>
                  <li>Thamizh (Thamizh Latin)</li>
                  <li>തമിഴ് (Tamil in Malayalam Script)</li>
                  <li>English</li>
                  <li>മലയാളம் (Malayalam)</li>
                  <li>Malayalam (Malayalam Latin)</li>
                  <li>மலயாளம் (Malayalam in Tamil Script)</li>
                </ul>
              </div>
            </div>
            <div class="ms-info-cell">
              <Icon name="Buildings" weight="regular" size={20} class="ms-cell-icon" />
              <div class="ms-cell-content">
                <div class="ms-cell-label">Publisher Info</div>
                <ul class="ms-cell-list">
                  <li><a href="https://github.com/ElvanParthasarathy/Nammil" target="_blank" rel="noreferrer">Nammil GitHub support</a></li>
                  <li><a href="/about">Elvan Navil website</a></li>
                  <li><a href="https://jaiprakashpartha.vercel.app" target="_blank" rel="noreferrer">Contact information</a></li>
                </ul>
              </div>
            </div>
            <div class="ms-info-cell">
              <Icon name="FileText" weight="regular" size={20} class="ms-cell-icon" />
              <div class="ms-cell-content">
                <div class="ms-cell-label">Additional terms</div>
                <ul class="ms-cell-list">
                  <li><a href="https://github.com/ElvanParthasarathy/Nammil#%EF%B8%8F-zero-admin--complete-local-privacy" target="_blank" rel="noreferrer">Nammil privacy policy</a></li>
                  <li><a href="https://github.com/ElvanParthasarathy/Nammil/blob/main/LICENSE" target="_blank" rel="noreferrer">MIT License</a></li>
                </ul>
              </div>
            </div>
            <div class="ms-info-cell">
              <Icon name="Flag" weight="regular" size={20} class="ms-cell-icon" />
              <div class="ms-cell-content">
                <div class="ms-cell-label">Report this product</div>
                <ul class="ms-cell-list">
                  <li><a href="https://github.com/ElvanParthasarathy/Nammil/issues" target="_blank" rel="noreferrer">Report a bug or issue</a></li>
                  <li><a href="mailto:jaiprakashpartha@gmail.com" target="_blank" rel="noreferrer">Report security vulnerability</a></li>
                </ul>
              </div>
            </div>
            <div class="ms-info-cell">
              <Icon name="Code" weight="regular" size={20} class="ms-cell-icon" />
              <div class="ms-cell-content">
                <div class="ms-cell-label">Installed version</div>
                <div class="ms-cell-val">1.2.9</div>
              </div>
            </div>
            <div class="ms-info-cell">
              <Icon name="Sparkle" weight="regular" size={20} class="ms-cell-icon" />
              <div class="ms-cell-content">
                <div class="ms-cell-label">Designed &amp; Developed by</div>
                <div class="ms-cell-val">
                  <a href="https://jaiprakashpartha.vercel.app" target="_blank" rel="noreferrer" style="color: inherit; text-decoration: underline;">
                    Elvan Parthasarathy
                  </a>
                </div>
              </div>
            </div>
            <div class="ms-info-cell ms-cell-disclaimer">
              <Icon name="Info" weight="regular" size={20} class="ms-cell-icon" />
              <div class="ms-cell-content">
                <div class="ms-cell-label">Legal disclaimers</div>
                <div class="ms-cell-val">
                  This software is an independent open-source application crafted by Elvan Parthasarathy under MIT License and is not affiliated with, endorsed by, or sponsored by WhatsApp Inc. or Meta Platforms, Inc.
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>

  <!-- LIGHTBOX OVERLAY -->
  <div id="nammil-lightbox" class="nammil-lightbox" style="display: none;">
    <div class="nammil-lb-header">
      <div class="nammil-lb-counter" id="nammil-lb-counter">1 / 6</div>
      <button type="button" class="nammil-lb-close" id="nammil-lb-close" aria-label="Close">
        <Icon name="X" weight="bold" size={20} />
      </button>
    </div>
    <div class="nammil-lb-main-container">
      <button type="button" class="nammil-lb-nav prev" id="nammil-lb-prev" aria-label="Previous screenshot">
        <Icon name="CaretLeft" weight="bold" size={24} />
      </button>
      <button type="button" class="nammil-lb-nav next" id="nammil-lb-next" aria-label="Next screenshot">
        <Icon name="CaretRight" weight="bold" size={24} />
      </button>
      <div class="nammil-lb-img-wrapper">
        <div class="nammil-lb-slide">
          <img id="nammil-lb-img" src="" alt="" class="nammil-lb-img" />
        </div>
      </div>
    </div>
    <div class="nammil-lb-filmstrip">
      {slides.map((s, idx) => (
        <div class="nammil-lb-fs-item" data-lb-thumb={idx} title={s.titleTa}>
          <img src={s.src} alt={s.titleEn} />
        </div>
      ))}
    </div>
  </div>

  <script is:inline define:vars={{ slides }}>
    (function () {
      var nammilAbort = null;
      function initNammil() {
        var scroller = document.getElementById('nammil-scroller');
        if (!scroller || scroller.dataset.bound) return;
        scroller.dataset.bound = '1';

        if (nammilAbort) nammilAbort.abort();
        nammilAbort = new AbortController();
        var sig = { signal: nammilAbort.signal };

        var leftBtn = document.getElementById('nammil-scroll-left');
        var rightBtn = document.getElementById('nammil-scroll-right');
        function updateBtns() {
          if (!scroller) return;
          if (leftBtn) leftBtn.style.display = scroller.scrollLeft > 12 ? 'flex' : 'none';
          if (rightBtn) rightBtn.style.display = scroller.scrollLeft < scroller.scrollWidth - scroller.clientWidth - 12 ? 'flex' : 'none';
        }
        scroller.addEventListener('scroll', updateBtns, sig);
        window.addEventListener('resize', updateBtns, sig);
        updateBtns();

        var isDrag = false, startX = 0, scrollStart = 0, moved = false;
        scroller.addEventListener('mousedown', function (e) {
          isDrag = true; moved = false;
          startX = e.pageX - scroller.offsetLeft;
          scrollStart = scroller.scrollLeft;
        }, sig);
        scroller.addEventListener('mousemove', function (e) {
          if (!isDrag) return;
          e.preventDefault();
          var walk = (e.pageX - scroller.offsetLeft - startX) * 1.1;
          if (Math.abs(walk) > 4) moved = true;
          scroller.scrollLeft = scrollStart - walk;
        }, sig);
        scroller.addEventListener('mouseup', function () { isDrag = false; }, sig);
        scroller.addEventListener('mouseleave', function () { isDrag = false; }, sig);

        if (leftBtn) leftBtn.addEventListener('click', function () { scroller.scrollBy({ left: -420, behavior: 'smooth' }); }, sig);
        if (rightBtn) rightBtn.addEventListener('click', function () { scroller.scrollBy({ left: 420, behavior: 'smooth' }); }, sig);

        function setupToggle(btnId, boxId, attrName, moreKey, lessKey) {
          var btn = document.getElementById(btnId);
          var box = document.getElementById(boxId);
          if (!btn || !box) return;
          btn.addEventListener('click', function () {
            var open = box.style.display !== 'none';
            box.style.display = open ? 'none' : 'block';
            btn.setAttribute(attrName, open ? moreKey : lessKey);
            btn.setAttribute('aria-expanded', String(!open));
            if (typeof window.__elvanApplyLangMode === 'function') {
              window.__elvanApplyLangMode();
            }
          }, sig);
        }
        setupToggle('nammil-ta-btn', 'nammil-ta-more', 'data-ui-pair', 'nammil.showMore', 'nammil.showLess');
        setupToggle('nammil-en-btn', 'nammil-en-more', 'data-ui-en', 'nammil.showMore', 'nammil.showLess');

        var lb = document.getElementById('nammil-lightbox');
        var lbImg = document.getElementById('nammil-lb-img');
        var lbCounter = document.getElementById('nammil-lb-counter');
        var currentIdx = 0;

        function showSlide(idx) {
          currentIdx = Math.max(0, Math.min(slides.length - 1, idx));
          if (lbImg) {
            lbImg.src = slides[currentIdx].src;
            lbImg.alt = slides[currentIdx].titleEn;
          }
          if (lbCounter) lbCounter.textContent = (currentIdx + 1) + ' / ' + slides.length;
          document.querySelectorAll('[data-lb-thumb]').forEach(function (el) {
            el.classList.toggle('active', Number(el.getAttribute('data-lb-thumb')) === currentIdx);
          });
        }
        function openLb(idx) {
          if (!lb) return;
          if (lb.parentElement !== document.body) {
            document.body.appendChild(lb);
          }
          showSlide(idx);
          lb.style.display = 'flex';
          document.body.style.overflow = 'hidden';
        }
        function closeLb() {
          if (!lb) return;
          lb.style.display = 'none';
          document.body.style.overflow = '';
        }
        document.querySelectorAll('[data-slide-idx]').forEach(function (el) {
          el.addEventListener('click', function () {
            if (moved) return;
            openLb(Number(el.getAttribute('data-slide-idx')));
          }, sig);
        });
        var openHeader = document.getElementById('nammil-open-lb');
        if (openHeader) openHeader.addEventListener('click', function () { openLb(0); }, sig);
        var cBtn = document.getElementById('nammil-lb-close');
        var pBtn = document.getElementById('nammil-lb-prev');
        var nBtn = document.getElementById('nammil-lb-next');
        if (cBtn) cBtn.addEventListener('click', closeLb, sig);
        if (pBtn) pBtn.addEventListener('click', function () { showSlide(currentIdx - 1); }, sig);
        if (nBtn) nBtn.addEventListener('click', function () { showSlide(currentIdx + 1); }, sig);
        document.querySelectorAll('[data-lb-thumb]').forEach(function (el) {
          el.addEventListener('click', function () { showSlide(Number(el.getAttribute('data-lb-thumb'))); }, sig);
        });
        if (lb) lb.addEventListener('click', function (e) { if (e.target === lb) closeLb(); }, sig);
        document.addEventListener('keydown', function (e) {
          if (!lb || lb.style.display === 'none') return;
          if (e.key === 'Escape') closeLb();
          if (e.key === 'ArrowRight') showSlide(currentIdx + 1);
          if (e.key === 'ArrowLeft') showSlide(currentIdx - 1);
        }, sig);
      }
      initNammil();
      document.addEventListener('astro:page-load', initNammil);
      document.addEventListener('astro:before-swap', function () {
        if (nammilAbort) { nammilAbort.abort(); nammilAbort = null; }
        var strayLb = document.body.querySelector(':scope > #nammil-lightbox');
        if (strayLb) strayLb.remove();
        document.body.style.overflow = '';
      });
    })();
  </script>
</BaseLayout>
