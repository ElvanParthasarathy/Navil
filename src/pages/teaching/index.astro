---
import '../../சிறப்புக்கூறுகள்/படைப்புகள்/படைப்புகள்.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdUnit from '../../components/astro/AdUnit.astro';
import Icon from '../../components/astro/Icon.astro';
---

<BaseLayout
  title="பயிற்றுவிப்பு | Teaching — Elvan Navil"
  description="Interactive educational teaching modules by Elvan Navil, featuring real-time acoustics and Source-Filter Formant Vocoder demonstrations."
  canonicalPath="/teaching"
  mobileTitle="பயிற்றுவிப்பு|teaching"
  backUrl="/tools"
>
  <div class="writings-page page-view fadeIn">
    <header class="writings-header animate-entry">
      <div style="flex: 1;">
        <h1 class="writings-title" lang="ta">பயிற்றுவிப்பு</h1>
        <div class="writings-title-sub">Teaching &amp; Presentations</div>
        <p class="writings-subtitle" lang="ta">கற்றல் கற்பித்தல் மற்றும் தொழில்நுட்ப விளக்கக்காட்சிகள்.</p>
        <p class="writings-subtitle writings-subtitle-en">
          Interactive teaching materials, slides, and educational resources.
        </p>
      </div>
    </header>

    <div class="category-grid animate-entry">
      <a href="/tools/vocoder" class="category-card">
        <div class="cat-icon-box">
          <Icon name="Monitor" weight="regular" />
        </div>
        <div class="cat-content">
          <div class="cat-title" lang="ta">நவில் குரல்மாற்றி</div>
          <div class="cat-title-sub">Navil Vocoder • Interactive Presentation</div>
          <p class="cat-desc" lang="ta">எனது படைப்பு மற்றும் தொழில் நுட்ப விளக்கக்காட்சி.</p>
          <p class="cat-desc-sub">Modern presentation for Vocoder engine concepts.</p>
        </div>
        <div class="cat-footer">
          விளக்கக்காட்சியைக் காண <Icon name="ArrowRight" weight="regular" />
        </div>
      </a>

      <a href="/tools/arichuvadi/learn" class="category-card">
        <div class="cat-icon-box">
          <Icon name="Scroll" weight="regular" />
        </div>
        <div class="cat-content">
          <div class="cat-title" lang="ta">தமிழி &amp; வட்டெழுத்துப் பாடம்</div>
          <div class="cat-title-sub">Paleography Guided Study</div>
          <p class="cat-desc" lang="ta">
            சங்க கால கல்வெட்டு எழுத்துக்களின் வரிவடிவ வளர்ச்சியைப் படிப்படியாகக் கற்கும் பகுதி.
          </p>
          <p class="cat-desc-sub">
            Step-by-step comparative study of Thamizhi (Tamil-Brahmi) and Vatteluttu glyph structures.
          </p>
        </div>
        <div class="cat-footer">
          பாடத்தைத் திறக்க <Icon name="ArrowRight" weight="regular" />
        </div>
      </a>
    </div>

    <AdUnit margin="48px 0 0" />
  </div>
</BaseLayout>
