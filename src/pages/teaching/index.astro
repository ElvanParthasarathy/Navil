---
import '../../சிறப்புக்கூறுகள்/படைப்புகள்/படைப்புகள்.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdUnit from '../../components/astro/AdUnit.astro';
import Icon from '../../components/astro/Icon.astro';
import { UI_TA, UI_EN } from '../../i18n';
---

<BaseLayout
  title={`${UI_TA.teaching.title} | ${UI_EN.teaching.title} — ${UI_EN.brand.name}`}
  description="Interactive educational teaching modules by Elvan Navil, featuring real-time acoustics and Source-Filter Formant Vocoder demonstrations."
  canonicalPath="/teaching"
  mobileTitle={`${UI_TA.routes.teaching.title}|${UI_EN.routes.teaching.title}`}
  backUrl="/tools"
>
  <div class="writings-page page-view fadeIn">
    <header class="writings-header animate-entry">
      <div style="flex: 1;">
        <h1 class="writings-title" lang="ta" data-ui-ta="teaching.title">{UI_TA.teaching.title}</h1>
        <div class="writings-title-sub" data-ui-en="teaching.title">{UI_EN.teaching.title}</div>
        <p class="writings-subtitle" lang="ta" data-ui-ta="teaching.subtitle">{UI_TA.teaching.subtitle}</p>
        <p class="writings-subtitle writings-subtitle-en" data-ui-en="teaching.subtitle">
          {UI_EN.teaching.subtitle}
        </p>
      </div>
    </header>

    <div class="category-grid animate-entry">
      <a href="/tools/vocoder" class="category-card">
        <div class="cat-icon-box">
          <Icon name="Monitor" weight="regular" />
        </div>
        <div class="cat-content">
          <div class="cat-title" lang="ta" data-ui-ta="teaching.vocoderTitle">{UI_TA.teaching.vocoderTitle}</div>
          <div class="cat-title-sub" data-ui-en="teaching.vocoderSub">{UI_EN.teaching.vocoderSub}</div>
          <p class="cat-desc" lang="ta" data-ui-ta="teaching.vocoderDesc">{UI_TA.teaching.vocoderDesc}</p>
          <p class="cat-desc-sub" data-ui-en="teaching.vocoderDesc">{UI_EN.teaching.vocoderDesc}</p>
        </div>
        <div class="cat-footer">
          <span data-ui-ta="teaching.vocoderCta">{UI_TA.teaching.vocoderCta}</span> <Icon name="ArrowRight" weight="regular" />
        </div>
      </a>

      <a href="/tools/arichuvadi/learn" class="category-card">
        <div class="cat-icon-box">
          <Icon name="Scroll" weight="regular" />
        </div>
        <div class="cat-content">
          <div class="cat-title" lang="ta" data-ui-ta="teaching.paleographyTitle">{UI_TA.teaching.paleographyTitle}</div>
          <div class="cat-title-sub" data-ui-en="teaching.paleographyTitle">{UI_EN.teaching.paleographyTitle}</div>
          <p class="cat-desc" lang="ta" data-ui-ta="teaching.paleographyDesc">
            {UI_TA.teaching.paleographyDesc}
          </p>
          <p class="cat-desc-sub" data-ui-en="teaching.paleographyDesc">
            {UI_EN.teaching.paleographyDesc}
          </p>
        </div>
        <div class="cat-footer">
          <span data-ui-ta="teaching.paleographyCta">{UI_TA.teaching.paleographyCta}</span> <Icon name="ArrowRight" weight="regular" />
        </div>
      </a>
    </div>

    <AdUnit margin="48px 0 0" />
  </div>
</BaseLayout>
