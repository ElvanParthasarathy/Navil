---
import '../வடிவமைப்பு/முகப்புஎண்.css';
import '../வடிவமைப்பு/செயலி.css';
import '../கூறுகள்/கட்டமைப்பு/மேல்பட்டை.css';
import '../கூறுகள்/கட்டமைப்பு/மிதக்கும்பின்பொத்தான்.css';
import profilePic from '../வளங்கள்/இன்ஸ்டாகிராம்/தன்னுரு.png';
import profileData from '../தரவு/தன்னுரு.json';
import Footer from '../components/astro/Footer.astro';
import { getRouteInfo } from '../components/astro/routeMeta';
import { BASE_URL } from '../lib/content';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogType?: string;
  ogImage?: string;
  favicon?: string;
  mobileTitle?: string;
  isBeta?: boolean;
  showBack?: boolean;
  backUrl?: string;
  noindex?: boolean;
  includeAdsense?: boolean;
  hideFooter?: boolean;
  jsonLd?: Record<string, any> | Record<string, any>[] | null;
}

const {
  title,
  description = 'Elvan Navil — A bilingual Tamil-English digital creation studio featuring original poems, quotes, short stories, essays, articles, art gallery, linguistic tools, and the Nammil desktop app.',
  canonicalPath,
  ogType = 'website',
  ogImage = `${BASE_URL}/favicon.png`,
  favicon,
  mobileTitle,
  isBeta,
  showBack,
  backUrl,
  noindex = false,
  includeAdsense = !noindex,
  hideFooter = false,
  jsonLd = null,
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const routeInfo = getRouteInfo(pathname);
const resolvedFavicon = favicon || routeInfo.icon || '/favicon.png';
const resolvedBackUrl = backUrl || routeInfo.backUrl || '/';
const resolvedShowBack = showBack !== undefined ? showBack : routeInfo.showBack;
const resolvedBeta = isBeta !== undefined ? isBeta : Boolean(routeInfo.badge);

const cleanCanonicalPath = (canonicalPath ?? pathname).replace(/\/$/, '') || '/';
const canonicalUrl = `${BASE_URL}${cleanCanonicalPath === '/' ? '/' : cleanCanonicalPath}`;

const mainLevelPaths = [
  '/',
  '/navilgal',
  '/writings',
  '/arts',
  '/about',
  '/portfolio',
  '/settings',
  '/tools',
  '/downloads',
];
const isMainLevel = mainLevelPaths.includes(pathname.toLowerCase());

const isHome = pathname === '/';
const isNavilgalActive =
  pathname.startsWith('/navilgal') ||
  pathname.startsWith('/writings') ||
  pathname.startsWith('/arts');
const isToolsActive = pathname.startsWith('/tools') || pathname.startsWith('/teaching');
const isDownloadsActive = pathname.startsWith('/downloads');
const isAboutActive = pathname === '/about';

const mobileHeaderText = mobileTitle || `${routeInfo.title}|${routeInfo.subtitle}`;
const mobileHasPipe = mobileHeaderText.includes('|');
const mobileMain = mobileHasPipe ? mobileHeaderText.split('|')[0] : mobileHeaderText;
const mobileSub = mobileHasPipe ? mobileHeaderText.split('|')[1] : '';

const siteGraph = [
  {
    '@type': 'Organization',
    '@id': `${BASE_URL}/#organization`,
    name: 'Elvan Navil',
    alternateName: 'எல்வன் நவில்',
    url: BASE_URL,
    logo: `${BASE_URL}/favicon.png`,
    founder: {
      '@type': 'Person',
      name: 'Elvan Parthasarathy',
      alternateName: 'Jaiprakash P',
      jobTitle: 'Software Developer & Bilingual Writer',
      url: `${BASE_URL}/about`,
      sameAs: [
        'https://github.com/ElvanParthasarathy',
        'https://linkedin.com/in/jaiprakashpartha',
        'https://instagram.com/elvannavil',
      ],
    },
    description:
      'An independent bilingual Tamil-English digital creation studio crafting thoughtful desktop software, bespoke typography, and original literature.',
  },
  {
    '@type': 'WebSite',
    '@id': `${BASE_URL}/#website`,
    url: BASE_URL,
    name: 'Elvan Navil',
    description:
      'Bilingual Tamil-English digital creation studio featuring literature, desktop software, and linguistic tools.',
    publisher: { '@id': `${BASE_URL}/#organization` },
    inLanguage: ['ta', 'en'],
  },
];

const extraLd = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const fullJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [...siteGraph, ...extraLd],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={resolvedFavicon} />
    <link rel="apple-touch-icon" href={resolvedFavicon} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Elvan Parthasarathy" />
    <link rel="canonical" href={canonicalUrl} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <meta name="robots" content="index, follow" />
    )}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Elvan Navil" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ta_IN" />
    <meta property="og:locale:alternate" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#000000" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <link rel="preload" href="/fonts/ElvanSans-Regular.woff" as="font" type="font/woff" crossorigin />
    <link rel="preload" href="/fonts/ElvanSans-Medium.woff" as="font" type="font/woff" crossorigin />
    <link rel="preload" href="/fonts/ElvanSans-SemiBold.woff" as="font" type="font/woff" crossorigin />
    <link rel="preload" href="/fonts/ElvanSans-Bold.woff" as="font" type="font/woff" crossorigin />

    {includeAdsense && (
      <>
        <meta name="google-adsense-account" content="ca-pub-5392072917035799" />
        <script
          async
          src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5392072917035799"
          crossorigin="anonymous"
        ></script>
      </>
    )}

    <script type="application/ld+json" set:html={JSON.stringify(fullJsonLd)} />

    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('theme') || 'auto';
          var effective = theme;
          if (theme === 'auto') {
            effective = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', effective);

          if (window.self !== window.top) {
            var style = document.createElement('style');
            style.textContent =
              '::-webkit-scrollbar{width:6px;height:6px;}' +
              '::-webkit-scrollbar-track{background:transparent;}' +
              '::-webkit-scrollbar-thumb{background-color:rgba(156,163,175,0.5);border-radius:10px;}' +
              '::-webkit-scrollbar-thumb:hover{background-color:rgba(156,163,175,0.8);}';
            document.head.appendChild(style);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div id="app-shell" class="app-shell nav-initial" style="display: flex;">
      <!-- DESKTOP TOP BAR -->
      <header class="desktop-topbar" aria-label="Desktop Top Bar">
        <div id="topbar-sidebar-zone" class="desktop-topbar-sidebar-zone">
          <a href="/" class="desktop-topbar-sidebar-brand" lang="ta">
            <span class="desktop-topbar-sidebar-brand-title">எல்வன் நவில்</span>
            <span class="desktop-topbar-sidebar-brand-subtitle">Elvan Navil</span>
          </a>
          <button
            type="button"
            id="topbar-sidebar-toggle"
            class="sidebar-toggle-btn"
            aria-label="Toggle Sidebar"
            title="Toggle Sidebar"
          >
            <svg width="19" height="19" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
              <path d="M216,40H40A16,16,0,0,0,24,56V200a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V56A16,16,0,0,0,216,40ZM40,56H80V200H40ZM216,200H96V56H216V200Z" />
            </svg>
          </button>
        </div>

        <div class="desktop-topbar-content-zone">
          <div class="desktop-topbar-left">
            {resolvedShowBack && (
              <a
                href={resolvedBackUrl}
                class="desktop-topbar-circle-back-btn"
                aria-label="பின்செல்"
                title="முந்தைய பக்கத்திற்குச் செல்"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="15 18 9 12 15 6" />
                </svg>
              </a>
            )}
            <a href={pathname} class="desktop-topbar-brand">
              <div class="desktop-topbar-titles">
                <div class="desktop-topbar-title-row">
                  <span class="desktop-topbar-title" lang="ta">{routeInfo.title}</span>
                  {routeInfo.badge && <span class="desktop-topbar-badge">{routeInfo.badge}</span>}
                </div>
                {routeInfo.subtitle && <span class="desktop-topbar-subtitle">{routeInfo.subtitle}</span>}
              </div>
            </a>
          </div>
          <div class="desktop-topbar-right" id="desktop-topbar-actions"></div>
        </div>
      </header>

      <!-- SIDEBAR / MOBILE BOTTOM BAR -->
      <nav id="app-sidebar" class={`sidebar ${!isMainLevel ? 'mobile-hidden-nav' : ''}`} aria-label="Main navigation">
        <div class="sidebar-backdrop"></div>
        <div class="sidebar-top">
          <div class="sidebar-nav">
            <a href="/" class={`nav-item ${isHome ? 'active' : ''}`}>
              <span class="nav-icon">
                <svg width="21" height="21" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
                  {isHome ? (
                    <path d="M224,115.55V208a16,16,0,0,1-16,16H168a16,16,0,0,1-16-16V168a8,8,0,0,0-8-8H112a8,8,0,0,0-8,8v40a16,16,0,0,1-16,16H48a16,16,0,0,1-16-16V115.55a16,16,0,0,1,5.17-11.78l80-75.48.11-.11a16,16,0,0,1,21.53,0l.11.11,80,75.48A16,16,0,0,1,224,115.55Z" />
                  ) : (
                    <path d="M219.31,108.68l-80-80a16,16,0,0,0-22.62,0l-80,80A15.87,15.87,0,0,0,32,120v96a8,8,0,0,0,8,8h64a8,8,0,0,0,8-8V160h32v56a8,8,0,0,0,8,8h64a8,8,0,0,0,8-8V120A15.87,15.87,0,0,0,219.31,108.68ZM208,208H160V152a8,8,0,0,0-8-8H104a8,8,0,0,0-8,8v56H48V120l80-80,80,80Z" />
                  )}
                </svg>
              </span>
              <div class="nav-text-container">
                <span class="label">முகப்பு</span>
                <span class="sub-label desktop-only">home</span>
              </div>
            </a>

            <a href="/navilgal" class={`nav-item ${isNavilgalActive ? 'active' : ''}`}>
              <span class="nav-icon">
                <svg width="21" height="21" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
                  <path d="M224,48H160a40,40,0,0,0-32,16A40,40,0,0,0,96,48H32A16,16,0,0,0,16,64V192a16,16,0,0,0,16,16H96a24,24,0,0,1,24,24,8,8,0,0,0,16,0,24,24,0,0,1,24-24h64a16,16,0,0,0,16-16V64A16,16,0,0,0,224,48ZM96,192H32V64H96a24,24,0,0,1,24,24V200A39.81,39.81,0,0,0,96,192Zm128,0H160a39.81,39.81,0,0,0-24,8V88a24,24,0,0,1,24-24h64Z" />
                </svg>
              </span>
              <div class="nav-text-container">
                <span class="label">நவில்கள்</span>
                <span class="sub-label desktop-only">navilgal</span>
              </div>
            </a>

            <a href="/tools" class={`nav-item ${isToolsActive ? 'active' : ''}`}>
              <span class="nav-icon">
                <svg width="21" height="21" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
                  <path d="M226.76,69a8,8,0,0,0-12.84-2.88l-40.3,37.19-17.23-3.7-3.7-17.23,37.19-40.3A8,8,0,0,0,187,29.24,72,72,0,0,0,88,96,72.34,72.34,0,0,0,94,124.94L33.79,177.26a24,24,0,0,0,33.94,33.94l52.32-60.21A72,72,0,0,0,226.76,69ZM159.4,151.31a56.08,56.08,0,0,1-44.78-12.16,8,8,0,0,0-11,.5L56.4,193.94a8,8,0,0,1-11.31-11.31l54.29-47.21a8,8,0,0,0,.5-11A56,56,0,0,1,170.51,46.63l-31.94,34.6a8,8,0,0,0-1.95,7.09l5.18,24.16a8,8,0,0,0,6.14,6.14l24.16,5.18a8,8,0,0,0,7.09-1.95l34.6-31.94A56.11,56.11,0,0,1,159.4,151.31Z" />
                </svg>
              </span>
              <div class="nav-text-container">
                <span class="label" style="display: flex; align-items: center;">
                  கருவிகள்
                  <span
                    class="nav-badge desktop-only"
                    style={`font-size: 0.6rem; background: ${isToolsActive ? 'var(--text-main)' : 'color-mix(in srgb, var(--text-main) 15%, transparent)'}; color: ${isToolsActive ? 'var(--bg-app)' : 'var(--text-main)'}; padding: 1px 5px; border-radius: 100px; margin-left: 6px; font-weight: 700; letter-spacing: 0.5px; display: inline-block; line-height: 1;`}
                  >
                    BETA
                  </span>
                </span>
                <span class="sub-label desktop-only">tools</span>
              </div>
            </a>

            <a href="/downloads" class={`nav-item ${isDownloadsActive ? 'active' : ''}`}>
              <span class="nav-icon">
                <svg width="21" height="21" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
                  <path d="M224,144v64a16,16,0,0,1-16,16H48a16,16,0,0,1-16-16V144a8,8,0,0,1,16,0v64H208V144a8,8,0,0,1,16,0Zm-101.66,5.66a8,8,0,0,0,11.32,0l40-40a8,8,0,0,0-11.32-11.32L136,124.69V32a8,8,0,0,0-16,0v92.69L93.66,98.34a8,8,0,0,0-11.32,11.32Z" />
                </svg>
              </span>
              <div class="nav-text-container">
                <span class="label">பதிவிறக்கங்கள்</span>
                <span class="sub-label desktop-only">downloads</span>
              </div>
            </a>

            <a href="/about" class={`nav-item desktop-only ${isAboutActive ? 'active' : ''}`}>
              <span class="nav-icon">
                <svg width="21" height="21" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
                  <path d="M230.92,212c-15.23-26.33-38.7-45.21-66.09-54.16a72,72,0,1,0-73.66,0C63.78,166.78,40.31,185.66,25.08,212a8,8,0,1,0,13.85,8c18.84-32.56,52.14-52,89.07-52s70.23,19.44,89.07,52a8,8,0,1,0,13.85-8ZM72,96a56,56,0,1,1,56,56A56.06,56.06,0,0,1,72,96Z" />
                </svg>
              </span>
              <div class="nav-text-container">
                <span class="label">பற்றி</span>
                <span class="sub-label desktop-only">about</span>
              </div>
            </a>

            <a href="/about" class={`nav-item mobile-only-nav-item ${isAboutActive ? 'active' : ''}`}>
              <span class="nav-icon">
                <img src={profilePic.src} alt="Profile" class="nav-profile-avatar" style="width:100%;height:100%;object-fit:cover;border-radius:50%;pointer-events:auto;" />
              </span>
              <div class="nav-text-container">
                <span class="label">Profile</span>
              </div>
            </a>
          </div>
        </div>

        <div class="sidebar-bottom" id="settings-zone">
          <div class="settings-profile-container">
            <button type="button" id="settings-trigger-btn" class="settings-trigger">
              <div class="settings-avatar">
                <img src={profilePic.src} alt="Profile" style="width:100%;height:100%;object-fit:cover;pointer-events:auto;" />
              </div>
              <div class="settings-text">
                <span class="settings-name">{(profileData as any)?.fullName || 'Elvan Parthasarathy'}</span>
                <span class="settings-brand-tag">Elvan Navil</span>
              </div>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="settings-theme-icon" style="width:16px;height:16px;">
                <circle cx="12" cy="12" r="10" />
                <path d="M12 2a10 10 0 0 0 0 20z" fill="currentColor" />
              </svg>
            </button>

            <div id="settings-popup" class="settings-popup" style="display: none;">
              <div class="popup-theme-section">
                <span class="popup-theme-label">Appearance</span>
                <div class="theme-slider-container">
                  <div class="slider-thumb" id="desktop-slider-thumb" style="transform: translateX(100%);"></div>
                  <div class="slider-option" data-theme-choice="light" title="Light">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="4" />
                      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
                    </svg>
                  </div>
                  <div class="slider-option" data-theme-choice="auto" title="Auto">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10" />
                      <path d="M12 2a10 10 0 0 0 0 20z" fill="currentColor" />
                    </svg>
                  </div>
                  <div class="slider-option" data-theme-choice="dark" title="Dark">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
                    </svg>
                  </div>
                </div>
                <div style="margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--border-light); display: flex; flex-direction: column; gap: 8px; font-size: 0.8rem;">
                  <a href="/about" style="color: var(--text-muted); text-decoration: none;">பற்றி • About</a>
                  <a href="/contact" style="color: var(--text-muted); text-decoration: none;">தொடர்பு • Contact</a>
                  <a href="/privacy" style="color: var(--text-muted); text-decoration: none;">தனியுரிமை • Privacy Policy</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </nav>

      <!-- MOBILE TOP BAR -->
      <header class={`mobile-topbar ${!isHome ? 'is-centered' : ''} ${resolvedShowBack ? 'has-back' : ''}`}>
        <div class="mobile-topbar-left">
          {resolvedShowBack && (
            <a href={resolvedBackUrl} class="mobile-back-btn" aria-label="Go back">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6" />
              </svg>
            </a>
          )}
        </div>

        <div class="brand">
          <div class="brand-main" lang="ta">
            {mobileMain}
            {resolvedBeta && (
              <span style="margin-left: 8px; font-size: 0.65rem; background: color-mix(in srgb, var(--text-main) 14%, transparent); color: var(--text-main); padding: 2px 7px; border-radius: 100px; vertical-align: middle; font-weight: 700; letter-spacing: 0.5px;">
                BETA
              </span>
            )}
          </div>
          {mobileSub && <div class="brand-sub">{mobileSub}</div>}
        </div>

        <div class="top-bar-actions">
          <div class="mobile-menu-zone" id="mobile-menu-zone">
            <button type="button" id="mobile-dot-btn" class="top-dot-btn" aria-label="More options">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <circle cx="5" cy="12" r="2" />
                <circle cx="12" cy="12" r="2" />
                <circle cx="19" cy="12" r="2" />
              </svg>
            </button>
            <div id="mobile-menu-backdrop" class="menu-backdrop" style="display: none;"></div>
            <div id="mobile-menu-dropdown" class="top-menu-dropdown" style="display: none; height: 56px;">
              <div id="mobile-menu-track" class="menu-slider-track" style="transform: translateX(0%);">
                <div class="menu-view">
                  <button type="button" id="mobile-appearance-btn" class="menu-item space-between">
                    <span style="display: flex; align-items: center; gap: 12px;">
                      <svg class="menu-icon" viewBox="0 0 24 24" fill="currentColor">
                        <path fill-rule="evenodd" d="M12 2.25c5.385 0 9.75 4.365 9.75 9.75s-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12 6.615 2.25 12 2.25Zm0 1.5v16.5c4.557 0 8.25-3.693 8.25-8.25 0-4.557-3.693-8.25-8.25-8.25Z" clip-rule="evenodd" />
                      </svg>
                      <span>Appearance</span>
                    </span>
                    <svg style="width: 18px; height: 18px; opacity: 0.4;" viewBox="0 0 24 24" fill="currentColor">
                      <path fill-rule="evenodd" d="M16.28 11.47a.75.75 0 0 1 0 1.06l-7.5 7.5a.75.75 0 0 1-1.06-1.06L14.69 12 7.72 5.03a.75.75 0 0 1 1.06-1.06l7.5 7.5Z" clip-rule="evenodd" />
                    </svg>
                  </button>
                </div>
                <div class="menu-view">
                  <button type="button" id="mobile-menu-back-btn" class="menu-item back-btn">
                    <svg style="width: 20px; height: 20px;" viewBox="0 0 24 24" fill="currentColor">
                      <path fill-rule="evenodd" d="M7.72 12.53a.75.75 0 0 1 0-1.06l7.5-7.5a.75.75 0 1 1 1.06 1.06L9.31 12l6.97 6.97a.75.75 0 1 1-1.06 1.06l-7.5-7.5Z" clip-rule="evenodd" />
                    </svg>
                    Back
                  </button>
                  <button type="button" class="menu-item" data-theme-choice="auto">Auto System</button>
                  <button type="button" class="menu-item" data-theme-choice="light">Light Mode</button>
                  <button type="button" class="menu-item" data-theme-choice="dark">Dark Mode</button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </header>

      <!-- MAIN CONTENT -->
      <main id="app-main-content" class={`main-content ${!isMainLevel ? 'no-bottom-nav mobile-full-width' : ''}`} style="flex-grow: 1; min-height: 100vh;">
        <div class="main-content-body">
          <slot />
          {!hideFooter && <Footer />}
        </div>
      </main>
    </div>

    <script is:inline>
      (function () {
        // Sidebar collapse state
        var sidebar = document.getElementById('app-sidebar');
        var main = document.getElementById('app-main-content');
        var topZone = document.getElementById('topbar-sidebar-zone');
        var shell = document.getElementById('app-shell');
        var toggleBtn = document.getElementById('topbar-sidebar-toggle');
        var settingsTrigger = document.getElementById('settings-trigger-btn');
        var settingsPopup = document.getElementById('settings-popup');

        function applySidebarState(collapsed) {
          if (!sidebar || !main || !topZone || !shell) return;
          sidebar.classList.toggle('collapsed', collapsed);
          main.classList.toggle('sidebar-collapsed', collapsed);
          topZone.classList.toggle('collapsed', collapsed);
          shell.classList.toggle('sidebar-collapsed', collapsed);
          if (settingsTrigger) settingsTrigger.classList.toggle('collapsed-trigger', collapsed);
          if (settingsPopup) settingsPopup.classList.toggle('side-popup', collapsed);
          var brandEl = topZone.querySelector('.desktop-topbar-sidebar-brand');
          if (brandEl) brandEl.style.display = collapsed ? 'none' : '';
          var stText = settingsTrigger ? settingsTrigger.querySelector('.settings-text') : null;
          var stIcon = settingsTrigger ? settingsTrigger.querySelector('.settings-theme-icon') : null;
          if (stText) stText.style.display = collapsed ? 'none' : '';
          if (stIcon) stIcon.style.display = collapsed ? 'none' : '';
          document.querySelectorAll('#app-sidebar .nav-text-container').forEach(function (el) {
            el.style.display = collapsed ? 'none' : '';
          });
        }

        var isCollapsed = false;
        try {
          isCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
        } catch (e) {}
        applySidebarState(isCollapsed);

        if (toggleBtn) {
          toggleBtn.addEventListener('click', function () {
            isCollapsed = !isCollapsed;
            shell.classList.add('animate-layout');
            setTimeout(function () { shell.classList.remove('animate-layout'); }, 450);
            try { localStorage.setItem('sidebarCollapsed', String(isCollapsed)); } catch (e) {}
            applySidebarState(isCollapsed);
          });
        }

        // Theme management
        function getSavedTheme() {
          try { return localStorage.getItem('theme') || 'auto'; } catch (e) { return 'auto'; }
        }
        function applyTheme(next) {
          try { localStorage.setItem('theme', next); } catch (e) {}
          var effective = next === 'auto'
            ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
            : next;
          document.documentElement.setAttribute('data-theme', effective);

          if (window.parent && window.parent !== window) {
            window.parent.postMessage({ type: 'IFRAMETHEMECHANGE', appId: 'elvan', isDark: effective === 'dark' }, '*');
          }

          var thumb = document.getElementById('desktop-slider-thumb');
          if (thumb) {
            thumb.style.transform = 'translateX(' + (next === 'light' ? '0%' : next === 'auto' ? '100%' : '200%') + ')';
          }
          document.querySelectorAll('[data-theme-choice]').forEach(function (el) {
            var choice = el.getAttribute('data-theme-choice');
            el.classList.toggle('active', choice === next);
            el.classList.toggle('selected', choice === next);
          });
        }

        applyTheme(getSavedTheme());
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function () {
          if (getSavedTheme() === 'auto') applyTheme('auto');
        });

        document.querySelectorAll('[data-theme-choice]').forEach(function (el) {
          el.addEventListener('click', function (e) {
            e.stopPropagation();
            var choice = el.getAttribute('data-theme-choice');
            if (choice) applyTheme(choice);
          });
        });

        // Desktop settings popup
        var settingsZone = document.getElementById('settings-zone');
        if (settingsTrigger && settingsPopup) {
          settingsTrigger.addEventListener('click', function (e) {
            e.stopPropagation();
            var open = settingsPopup.style.display !== 'none';
            settingsPopup.style.display = open ? 'none' : 'block';
            settingsTrigger.classList.toggle('active-trigger', !open);
          });
          document.addEventListener('mousedown', function (e) {
            if (settingsZone && !settingsZone.contains(e.target)) {
              settingsPopup.style.display = 'none';
              settingsTrigger.classList.remove('active-trigger');
            }
          });
        }

        // Mobile 3-dot menu
        var dotBtn = document.getElementById('mobile-dot-btn');
        var backdrop = document.getElementById('mobile-menu-backdrop');
        var dropdown = document.getElementById('mobile-menu-dropdown');
        var track = document.getElementById('mobile-menu-track');
        var appBtn = document.getElementById('mobile-appearance-btn');
        var backBtn = document.getElementById('mobile-menu-back-btn');

        function closeMobileMenu() {
          if (dropdown) {
            dropdown.classList.remove('is-open');
            dropdown.style.display = 'none';
            dropdown.style.height = '56px';
          }
          if (backdrop) {
            backdrop.classList.remove('is-open');
            backdrop.style.display = 'none';
          }
          if (track) track.style.transform = 'translateX(0%)';
        }
        if (dotBtn && dropdown && backdrop) {
          dotBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            var isOpen = dropdown.classList.contains('is-open');
            if (isOpen) {
              closeMobileMenu();
            } else {
              dropdown.classList.add('is-open');
              backdrop.classList.add('is-open');
              dropdown.style.display = 'block';
              backdrop.style.display = 'block';
              if (track) track.style.transform = 'translateX(0%)';
              dropdown.style.height = '56px';
            }
          });
          backdrop.addEventListener('click', closeMobileMenu);
        }
        if (appBtn && track && dropdown) {
          appBtn.addEventListener('click', function () {
            track.style.transform = 'translateX(-50%)';
            dropdown.style.height = '220px';
          });
        }
        if (backBtn && track && dropdown) {
          backBtn.addEventListener('click', function () {
            track.style.transform = 'translateX(0%)';
            dropdown.style.height = '56px';
          });
        }

        // Unregister legacy SPA service worker if installed in visitor's browser
        if ('serviceWorker' in navigator) {
          navigator.serviceWorker.getRegistrations().then(function (regs) {
            regs.forEach(function (reg) {
              reg.unregister();
            });
          }).catch(function () {});
        }
      })();
    </script>

    <script>
      import { inject } from '@vercel/analytics';
      inject();
    </script>

    <style is:global>
      html,
      body,
      .app-shell {
        max-width: 100%;
        overflow-x: clip;
      }
      .main-content {
        min-width: 0;
        max-width: 100%;
      }
      #mobile-menu-dropdown:not(.is-open),
      #mobile-menu-backdrop:not(.is-open) {
        display: none !important;
      }
      .astro-island-root .mobile-topbar,
      .astro-island-root .back-pill.bp-fixed {
        display: none !important;
      }
      .main-content-body:has(.ms-store-page) .global-site-footer {
        padding-inline: 24px;
      }
    </style>
  </body>
</html>
