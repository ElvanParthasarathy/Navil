        }

        #app-shell > .mobile-dot-glass {
          right: var(--mobile-header-gutter);
        }

        #app-shell > .mobile-back-glass {
          left: var(--mobile-header-gutter);
        }

        #app-shell > #mobile-menu-dropdown {
          position: fixed;
          top: calc(env(safe-area-inset-top, 0px) + (var(--mobile-header-height) - var(--mobile-dot-size)) / 2 - 2px);
          right: calc(var(--mobile-header-gutter) - 2px);
          z-index: 1102;
          transform-origin: top right !important;
          transform: scale(1);
          opacity: 1;
          animation: none !important;
          background: var(--bg-panel) !important;
          border: none !important;
          box-shadow: var(--mobile-glass-shadow);
          transition:
            transform 170ms cubic-bezier(0.2, 0.9, 0.25, 1),
            opacity 150ms cubic-bezier(0.2, 0.9, 0.25, 1),
            height 200ms cubic-bezier(0.2, 0.9, 0.25, 1);
          will-change: transform, opacity;
        }

        @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
          #app-shell > #mobile-menu-dropdown {
            background: var(--mobile-glass-fill) !important;
            backdrop-filter: blur(26px) saturate(180%);
            -webkit-backdrop-filter: blur(26px) saturate(180%);
          }
        }

        #app-shell > #mobile-menu-dropdown.is-entering,
        #app-shell > #mobile-menu-dropdown.is-closing {
          transform: scale(0.24) !important;
          opacity: 0 !important;
          pointer-events: none;
        }

        #app-shell > #mobile-menu-dropdown.is-closing {
          transition-duration: 135ms;
          transition-timing-function: cubic-bezier(0.4, 0, 1, 1);
        }

        #app-shell :is(.mobile-back-btn, #mobile-menu-dropdown .menu-item) {
          position: relative;
        }

        #app-shell > .mobile-dot-glass,
        #app-shell #mobile-dot-btn,
        #app-shell :is(.mobile-back-btn, .mobile-back-glass, #mobile-menu-dropdown .menu-item) {
          transition:
            opacity 120ms ease,
            scale 200ms cubic-bezier(0.22, 1, 0.36, 1),
            background-color 150ms ease;
        }

        #app-shell:has(#mobile-menu-dropdown:is(.is-entering, .is-open)) > .mobile-dot-glass,
        #app-shell:has(#mobile-menu-dropdown:is(.is-entering, .is-open)) #mobile-dot-btn {
          opacity: 0 !important;
          pointer-events: none;
        }

        #app-shell :is(#mobile-dot-btn, .mobile-back-btn):active,
        #app-shell:has(#mobile-dot-btn:active) > .mobile-dot-glass,
        #app-shell:has(.mobile-back-btn:active) > .mobile-back-glass {
          scale: 0.96;
          transition-duration: 120ms;
        }

        #app-shell > .mobile-topbar .mobile-back-btn:active {
          transform: none;
          background: transparent;
        }

        #app-shell > #mobile-menu-dropdown .menu-item {
          border-radius: 999px;
          background: transparent !important;
          -webkit-tap-highlight-color: transparent;
        }

        @media (hover: hover) and (pointer: fine) {
          #app-shell > #mobile-menu-dropdown .menu-item:hover {
            background: color-mix(in srgb, var(--text-main) 6%, transparent) !important;
          }
        }

        #app-shell > #mobile-menu-dropdown .menu-item:active {
          scale: 0.985;
          transition-duration: 100ms;
          background: color-mix(in srgb, var(--text-main) 8%, transparent) !important;
        }

        #app-shell > #mobile-menu-dropdown .menu-item.selected {
          font-weight: 650;
        }

        #app-shell > #mobile-menu-dropdown .menu-item:focus:not(:focus-visible) {
          outline: none;
        }

        #app-shell :is(#mobile-dot-btn, .mobile-back-btn, #mobile-menu-dropdown .menu-item):focus-visible {
          outline: 2px solid var(--text-main);
          outline-offset: -3px;
        }

        #app-sidebar {
          left: max(12px, env(safe-area-inset-left));
          right: max(12px, env(safe-area-inset-right));
          bottom: calc(10px + env(safe-area-inset-bottom, 0px));
          width: auto !important;
          max-width: 420px;
          height: 60px;
          margin-inline: auto;
          padding: 4px !important;
          box-sizing: border-box;
          border-radius: 999px !important;
          box-shadow: var(--mobile-glass-shadow) !important;
        }

        #app-main-content {
          padding-top: calc(64px + env(safe-area-inset-top, 0px)) !important;
        }

        #app-shell > #app-main-content:has(.ms-store-page) {
          padding-top: 0 !important;
        }

        #app-main-content:not(.no-bottom-nav) {
          padding-bottom: calc(84px + env(safe-area-inset-bottom, 0px)) !important;
        }

        #app-main-content.no-bottom-nav {
          padding-bottom: calc(52px + env(safe-area-inset-bottom, 0px)) !important;
        }

        #app-sidebar .sidebar-nav {
          position: relative;
          isolation: isolate;
          touch-action: pan-y pinch-zoom;
          -webkit-tap-highlight-color: transparent;
        }

        #app-sidebar .nav-item:not(.active) .nav-icon {
          opacity: 0.76;
        }

        #app-sidebar .nav-item .nav-icon {
          transform: none !important;
        }

        #app-sidebar .nav-item[data-tip]::after {
          content: attr(data-tip);
          position: absolute;
          inset-block-end: calc(100% + 12px);
          left: 50%;
          translate: -50% 4px;
          padding: 5px 9px;
          border-radius: 999px;
          background: var(--text-main);
          color: var(--bg-app);
          font-size: 0.72rem;
          font-weight: 600;
          white-space: nowrap;
          pointer-events: none;
          opacity: 0;
          transition: opacity 130ms ease, translate 130ms ease;
          z-index: 2;
        }

        #app-sidebar .nav-item[data-nav-key='home'],
        #app-sidebar .nav-item[data-nav-key='about-mobile'] {
          --nav-tip-translate: 0px;
        }

        #app-sidebar .nav-item[data-nav-key='home']::after { left: 0; translate: 0 4px; }
        #app-sidebar .nav-item[data-nav-key='about-mobile']::after { left: auto; right: 0; translate: 0 4px; }

        #app-sidebar .nav-item[data-tip]:focus-visible:not(:active)::after {
          opacity: 1;
          translate: var(--nav-tip-translate, -50%) 0;
        }

        @media (hover: hover) and (pointer: fine) {
          #app-sidebar .nav-item[data-tip]:not([data-tip-suppressed]):hover:not(:active)::after {
            opacity: 1;
            translate: var(--nav-tip-translate, -50%) 0;
            transition-delay: 250ms;
          }
        }

        #app-sidebar .nav-item:focus-visible {
          outline: 2px solid var(--text-main);
          outline-offset: -4px;
          border-radius: 999px !important;
        }

        .mobile-nav-pill {
          display: block;
          position: absolute;
          pointer-events: none;
          z-index: -1;
          inset: 2px auto 2px 0;
          width: var(--pill-width, 0);
          border-radius: 999px;
          background: color-mix(in srgb, var(--text-main) 12%, transparent);
          opacity: 0;
          transform: translate3d(var(--pill-x, 0px), 0, 0) scale(var(--pill-scale, 1));
          transition: transform 420ms cubic-bezier(0.22, 1.32, 0.36, 1), opacity 150ms ease;
        }

        .mobile-nav-pill[data-ready] {
          opacity: 1;
        }

        #app-sidebar .sidebar-nav[data-pressing] {
          --pill-scale: 1.045;
        }

        #app-sidebar .sidebar-nav[data-dragging] .mobile-nav-pill {
          transition-duration: 65ms, 150ms;
          transition-timing-function: ease-out, ease;
        }

      }

      @media (prefers-reduced-motion: reduce) {
        #app-shell > #mobile-menu-dropdown {
          animation: none;
        }

        #app-shell :is(#mobile-dot-btn, .mobile-back-btn, .mobile-dot-glass, .mobile-back-glass, #mobile-menu-dropdown .menu-item) {
          transition: none !important;
          scale: none !important;
        }

        #app-shell > .mobile-topbar > .brand {
          translate: none;
        }

        #app-sidebar .mobile-nav-pill,
        #app-sidebar .sidebar-nav[data-dragging] .mobile-nav-pill,
        #app-sidebar .nav-icon {
          transition: none !important;
        }
      }

      #mobile-menu-dropdown:not(.is-open):not(.is-entering):not(.is-closing),
      #mobile-menu-backdrop:not(.is-open):not(.is-entering):not(.is-closing) {
        display: none !important;
      }
      .astro-island-root .mobile-topbar,
      .astro-island-root .back-pill.bp-fixed,
      .astro-island-root .arts-gallery-header {
        display: none !important;
      }
      .astro-island-root .arts-gallery-page {
        padding: 0 !important;
      }
      .main-content-body:has(.ms-store-page) .global-site-footer {
        padding-inline: 24px;
      }

      /* Dynamic Script Mode Switcher (தமிழ் + Eng / Ta+En Tanglish + Eng) */
      .slider-thumb.lang-slider-thumb {
        width: calc((100% - 4px) / 2);
      }
      .lang-slider-opt {
        font-size: 11px;
        font-weight: 700;
        color: var(--text-muted);
        letter-spacing: normal;
        white-space: nowrap;
      }
      .lang-slider-opt.active {
        color: var(--accent-text);
      }

      [data-lang-mode="tanglish-en"] .store-card-name-en,
      [data-lang-mode="tanglish-en"] .home-brand-title-sub,
      [data-lang-mode="tanglish-en"] .desktop-topbar-sidebar-brand-subtitle,
      [data-lang-mode="tanglish-en"] .footer-brand-ta {
        display: none !important;
      }
    </style>
  </body>
</html>
