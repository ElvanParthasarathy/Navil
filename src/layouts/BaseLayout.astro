---
import { ClientRouter } from 'astro:transitions';
import '../வடிவமைப்பு/முகப்புஎண்.css';
import '../வடிவமைப்பு/செயலி.css';
import '../கூறுகள்/கட்டமைப்பு/மேல்பட்டை.css';
import '../கூறுகள்/கட்டமைப்பு/மிதக்கும்பின்பொத்தான்.css';
import profilePic from '../வளங்கள்/இன்ஸ்டாகிராம்/தன்னுரு.png';
import profileData from '../தரவு/தன்னுரு.json';
import Footer from '../components/astro/Footer.astro';
import Icon from '../components/astro/Icon.astro';
import { getRouteInfo } from '../components/astro/routeMeta';
import { BASE_URL } from '../lib/content';
import { UI_TA, UI_EN } from '../i18n';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogType?: string;
  ogImage?: string;
  favicon?: string;
  mobileTitle?: string;
  isBeta?: boolean;
  showBack?: boolean;
  backUrl?: string;
  noindex?: boolean;
  includeAdsense?: boolean;
  hideFooter?: boolean;
  jsonLd?: Record<string, any> | Record<string, any>[] | null;
}

const {
  title,
  description = 'Elvan Navil — A bilingual Tamil-English digital creation studio featuring original poems, quotes, short stories, essays, articles, art gallery, linguistic tools, and the Nammil desktop app.',
  canonicalPath,
  ogType = 'website',
  ogImage = `${BASE_URL}/favicon.png`,
  favicon,
  mobileTitle,
  isBeta,
  showBack,
  backUrl,
  noindex = false,
  includeAdsense = !noindex,
  hideFooter = false,
  jsonLd = null,
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const routeInfo = getRouteInfo(pathname);
const resolvedFavicon = favicon || routeInfo.icon || '/favicon.png';
const resolvedBackUrl = backUrl || routeInfo.backUrl || '/';
const resolvedShowBack = showBack !== undefined ? showBack : routeInfo.showBack;
const resolvedBeta = isBeta !== undefined ? isBeta : Boolean(routeInfo.badge);

const cleanCanonicalPath = (canonicalPath ?? pathname).replace(/\/$/, '') || '/';
const canonicalUrl = `${BASE_URL}${cleanCanonicalPath === '/' ? '/' : cleanCanonicalPath}`;

const mainLevelPaths = [
  '/',
  '/navilgal',
  '/writings',
  '/arts',
  '/about',
  '/portfolio',
  '/settings',
  '/tools',
  '/downloads',
];
const isMainLevel = mainLevelPaths.includes(pathname.toLowerCase());

const isHome = pathname === '/';
const isNavilgalActive =
  pathname.startsWith('/navilgal') ||
  pathname.startsWith('/writings') ||
  pathname.startsWith('/arts');
const isToolsActive = pathname.startsWith('/tools') || pathname.startsWith('/teaching');
const isDownloadsActive = pathname.startsWith('/downloads');
const isAboutActive = pathname === '/about';

const mobileHeaderText = mobileTitle || `${routeInfo.title}|${routeInfo.subtitle}`;
const mobileHasPipe = mobileHeaderText.includes('|');
const mobileMain = mobileHasPipe ? mobileHeaderText.split('|')[0] : mobileHeaderText;
const mobileSub = mobileHasPipe ? mobileHeaderText.split('|')[1] : '';

const siteGraph = [
  {
    '@type': 'Organization',
    '@id': `${BASE_URL}/#organization`,
    name: 'Elvan Navil',
    alternateName: 'எல்வன் நவில்',
    url: BASE_URL,
    logo: `${BASE_URL}/favicon.png`,
    founder: {
      '@type': 'Person',
      name: 'Elvan Parthasarathy',
      alternateName: 'Jaiprakash P',
      jobTitle: 'Software Developer & Bilingual Writer',
      url: `${BASE_URL}/about`,
      sameAs: [
        'https://github.com/ElvanParthasarathy',
        'https://linkedin.com/in/jaiprakashpartha',
        'https://instagram.com/elvannavil',
      ],
    },
    description:
      'An independent bilingual Tamil-English digital creation studio crafting thoughtful desktop software, bespoke typography, and original literature.',
  },
  {
    '@type': 'WebSite',
    '@id': `${BASE_URL}/#website`,
    url: BASE_URL,
    name: 'Elvan Navil',
    description:
      'Bilingual Tamil-English digital creation studio featuring literature, desktop software, and linguistic tools.',
    publisher: { '@id': `${BASE_URL}/#organization` },
    inLanguage: ['ta', 'en'],
  },
];

const extraLd = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const fullJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [...siteGraph, ...extraLd],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={resolvedFavicon} />
    <link rel="apple-touch-icon" href={resolvedFavicon} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Elvan Parthasarathy" />
    <link rel="canonical" href={canonicalUrl} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <meta name="robots" content="index, follow" />
    )}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Elvan Navil" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ta_IN" />
    <meta property="og:locale:alternate" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#000000" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <link rel="preload" href="/fonts/ElvanSans-Regular.woff" as="font" type="font/woff" crossorigin />
    <link rel="preload" href="/fonts/ElvanSans-Medium.woff" as="font/woff" crossorigin />
    <link rel="preload" href="/fonts/ElvanSans-SemiBold.woff" as="font/woff" crossorigin />
    <link rel="preload" href="/fonts/ElvanSans-Bold.woff" as="font/woff" crossorigin />

    {includeAdsense && (
      <>
        <meta name="google-adsense-account" content="ca-pub-5392072917035799" />
        <script
          async
          src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5392072917035799"
          crossorigin="anonymous"
        ></script>
      </>
    )}

    <script type="application/ld+json" set:html={JSON.stringify(fullJsonLd)} />

    <ClientRouter fallback="swap" />

    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('theme') || 'auto';
          var effective = theme;
          if (theme === 'auto') {
            effective = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', effective);
          document.documentElement.setAttribute('data-theme-mode', theme);

          var langMode = localStorage.getItem('langMode') || 'bilingual';
          if (langMode !== 'bilingual' && langMode !== 'tanglish-en') {
            langMode = 'bilingual';
          }
          document.documentElement.setAttribute('data-lang-mode', langMode);

          if (localStorage.getItem('sidebarCollapsed') === 'true') {
            document.documentElement.classList.add('sidebar-collapsed-init');
          }

          if (window.self !== window.top) {
            var style = document.createElement('style');
            style.textContent =
              '::-webkit-scrollbar{width:6px;height:6px;}' +
              '::-webkit-scrollbar-track{background:transparent;}' +
              '::-webkit-scrollbar-thumb{background-color:rgba(156,163,175,0.5);border-radius:10px;}' +
              '::-webkit-scrollbar-thumb:hover{background-color:rgba(156,163,175,0.8);}';
            document.head.appendChild(style);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div id="app-shell" class="app-shell nav-initial" style="display: flex;">
      <!-- DESKTOP TOP BAR -->
      <header class="desktop-topbar" aria-label="Desktop Top Bar">
        <div id="topbar-sidebar-zone" class="desktop-topbar-sidebar-zone" transition:persist="topbar-sidebar-zone">
          <a href="/" class="desktop-topbar-sidebar-brand" lang="ta">
            <span class="desktop-topbar-sidebar-brand-title" data-ui-ta="brand.name">{UI_TA.brand.name}</span>
            <span class="desktop-topbar-sidebar-brand-subtitle" data-ui-en="brand.name">{UI_EN.brand.name}</span>
          </a>
          <button
            type="button"
            id="topbar-sidebar-toggle"
            class="sidebar-toggle-btn"
            aria-label="Collapse Sidebar"
            title="Collapse Sidebar"
          >
            <Icon name="SidebarSimple" weight="regular" size={19} />
          </button>
        </div>

        <div class="desktop-topbar-content-zone" transition:animate="none">
          <div class="desktop-topbar-left">
            {resolvedShowBack && (
              <a
                href={resolvedBackUrl}
                class="desktop-topbar-circle-back-btn"
                aria-label={UI_TA.nav.backAria}
                data-ui-title="nav.backTitle"
                title={UI_TA.nav.backTitle}
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="15 18 9 12 15 6" />
                </svg>
              </a>
            )}
            <a href={pathname} class="desktop-topbar-brand">
              <div class="desktop-topbar-titles">
                <div class="desktop-topbar-title-row">
                  <span class="desktop-topbar-title" lang="ta" data-ui-ta={`routes.${routeInfo.key}.title`}>{routeInfo.title}</span>
                  {routeInfo.badge && <span class="desktop-topbar-badge">{routeInfo.badge}</span>}
                </div>
                {routeInfo.subtitle && <span class="desktop-topbar-subtitle" data-ui-en={`routes.${routeInfo.key}.title`}>{routeInfo.subtitle}</span>}
              </div>
            </a>
          </div>
          <div class="desktop-topbar-right" id="desktop-topbar-actions"></div>
        </div>
      </header>

      <!-- PERSISTENT VANILLA SIDEBAR / MOBILE BOTTOM BAR -->
      <nav
        id="app-sidebar"
        class={`sidebar ${!isMainLevel ? 'mobile-hidden-nav' : ''}`}
        aria-label="Main navigation"
        transition:persist="app-sidebar"
      >
        <div class="sidebar-backdrop"></div>
        <div class="sidebar-top">
          <div class="sidebar-nav">
            <span class="mobile-nav-pill" aria-hidden="true"></span>
            <a href="/" data-nav-key="home" data-ui-tip="nav.home" data-tip={`${UI_TA.nav.home} (${UI_EN.nav.home})`} class={`nav-item ${isHome ? 'active' : ''}`}>
              <span class="nav-icon" aria-hidden="true">
                <Icon name="House" weight="regular" size="100%" class="nav-svg-reg" />
                <Icon name="House" weight="fill" size="100%" class="nav-svg-fill" />
              </span>
              <div class="nav-text-container">
                <span class="label" data-ui-ta="nav.home">{UI_TA.nav.home}</span>
                <span class="sub-label desktop-only" data-ui-en="nav.home">{UI_EN.nav.home}</span>
              </div>
            </a>

            <a href="/navilgal" data-nav-key="navilgal" data-ui-tip="nav.navilgal" data-tip={`${UI_TA.nav.navilgal} (${UI_EN.nav.navilgal})`} class={`nav-item ${isNavilgalActive ? 'active' : ''}`}>
              <span class="nav-icon" aria-hidden="true">
                <Icon name="BookOpen" weight="regular" size="100%" class="nav-svg-reg" />
                <Icon name="BookOpen" weight="fill" size="100%" class="nav-svg-fill" />
              </span>
              <div class="nav-text-container">
                <span class="label" data-ui-ta="nav.navilgal">{UI_TA.nav.navilgal}</span>
                <span class="sub-label desktop-only" data-ui-en="nav.navilgal">{UI_EN.nav.navilgal}</span>
              </div>
            </a>

            <a href="/tools" data-nav-key="tools" data-ui-tip="nav.tools" data-ui-tip-badge="BETA" data-tip={`${UI_TA.nav.tools} (${UI_EN.nav.tools} • BETA)`} class={`nav-item ${isToolsActive ? 'active' : ''}`}>
              <span class="nav-icon" aria-hidden="true">
                <Icon name="Wrench" weight="regular" size="100%" class="nav-svg-reg" />
                <Icon name="Wrench" weight="fill" size="100%" class="nav-svg-fill" />
              </span>
              <div class="nav-text-container">
                <span class="label" style="display: flex; align-items: center;">
                  <span data-ui-ta="nav.tools">{UI_TA.nav.tools}</span>
                  <span class={`nav-badge desktop-only ${isToolsActive ? 'is-active-badge' : ''}`}>
                    BETA
                  </span>
                </span>
                <span class="sub-label desktop-only" data-ui-en="nav.tools">{UI_EN.nav.tools}</span>
              </div>
            </a>

            <a href="/downloads" data-nav-key="downloads" data-ui-tip="nav.downloads" data-tip={`${UI_TA.nav.downloads} (${UI_EN.nav.downloads})`} class={`nav-item ${isDownloadsActive ? 'active' : ''}`}>
              <span class="nav-icon" aria-hidden="true">
                <Icon name="DownloadSimple" weight="regular" size="100%" class="nav-svg-reg" />
                <Icon name="DownloadSimple" weight="fill" size="100%" class="nav-svg-fill" />
              </span>
              <div class="nav-text-container">
                <span class="label" data-ui-ta="nav.downloads">{UI_TA.nav.downloads}</span>
                <span class="sub-label desktop-only" data-ui-en="nav.downloads">{UI_EN.nav.downloads}</span>
              </div>
            </a>

            <a href="/about" data-nav-key="about" data-ui-tip="nav.about" data-tip={`${UI_TA.nav.about} (${UI_EN.nav.about})`} class={`nav-item desktop-only ${isAboutActive ? 'active' : ''}`}>
              <span class="nav-icon" aria-hidden="true">
                <Icon name="User" weight="regular" size="100%" class="nav-svg-reg" />
                <Icon name="User" weight="fill" size="100%" class="nav-svg-fill" />
              </span>
              <div class="nav-text-container">
                <span class="label" data-ui-ta="nav.about">{UI_TA.nav.about}</span>
                <span class="sub-label desktop-only" data-ui-en="nav.about">{UI_EN.nav.about}</span>
              </div>
            </a>

            <a href="/about" data-nav-key="about-mobile" data-tip="Profile" class={`nav-item mobile-only-nav-item ${isAboutActive ? 'active' : ''}`}>
              <span class="nav-icon">
                <img src={profilePic.src} alt="Profile" class="nav-profile-avatar" style="width:100%;height:100%;object-fit:cover;border-radius:50%;pointer-events:auto;" />
              </span>
              <div class="nav-text-container">
                <span class="label">Profile</span>
              </div>
            </a>
          </div>
        </div>

        <div class="sidebar-bottom" id="settings-zone">
          <div class="settings-profile-container">
            <button type="button" id="settings-trigger-btn" class="settings-trigger" aria-label="Appearance and settings">
              <div class="settings-avatar">
                <img src={profilePic.src} alt="Profile" style="width:100%;height:100%;object-fit:cover;pointer-events:auto;" />
              </div>
              <div class="settings-text">
                <span class="settings-name">{(profileData as any)?.fullName || 'Elvan Parthasarathy'}</span>
                <span class="settings-brand-tag" data-ui-en="brand.name">{UI_EN.brand.name}</span>
              </div>
              <span class="settings-theme-icon" aria-hidden="true">
                <Icon name="Sun" weight="regular" size={16} class="theme-ind theme-ind-light" />
                <Icon name="Moon" weight="regular" size={16} class="theme-ind theme-ind-dark" />
                <svg class="theme-ind theme-ind-auto" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10" />
                  <path d="M12 2a10 10 0 0 0 0 20z" fill="currentColor" />
                </svg>
              </span>
            </button>

            <div id="settings-popup" class="settings-popup" style="display: none;">
              <div class="popup-theme-section">
                <span class="popup-theme-label">Appearance</span>
                <div class="theme-slider-container">
                  <div class="slider-thumb" id="desktop-slider-thumb" style="transform: translateX(100%);"></div>
                  <div class="slider-option" data-theme-choice="light" title={UI_EN.settingsMenu.light}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="4" />
                      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
                    </svg>
                  </div>
                  <div class="slider-option" data-theme-choice="auto" title={UI_EN.settingsMenu.auto}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10" />
                      <path d="M12 2a10 10 0 0 0 0 20z" fill="currentColor" />
                    </svg>
                  </div>
                  <div class="slider-option" data-theme-choice="dark" title={UI_EN.settingsMenu.dark}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
                    </svg>
                  </div>
                </div>

                <span class="popup-theme-label" style="display: block; margin-top: 14px;">Script Mode</span>
                <div class="theme-slider-container" id="desktop-lang-slider" data-no-translit>
                  <div class="slider-thumb lang-slider-thumb" id="desktop-lang-thumb" style="transform: translateX(0%);"></div>
                  <div class="slider-option lang-slider-opt" data-lang-choice="bilingual" title={UI_EN.settingsMenu.modeBilingual}>
                    தமிழ் + En
                  </div>
                  <div class="slider-option lang-slider-opt" data-lang-choice="tanglish-en" title={UI_EN.settingsMenu.modeTanglishEn}>
                    Ta+En
                  </div>
                </div>

                <div style="margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--border-light); display: flex; flex-direction: column; gap: 8px; font-size: 0.8rem;">
                  <a href="/settings" style="color: var(--text-muted); text-decoration: none;">Settings</a>
                  <a href="/about" data-ui-pair="settingsMenu.aboutLink" style="color: var(--text-muted); text-decoration: none;">{UI_TA.settingsMenu.aboutLink} • {UI_EN.settingsMenu.aboutLink}</a>
                  <a href="/privacy" data-ui-pair="settingsMenu.privacyLink" style="color: var(--text-muted); text-decoration: none;">{UI_TA.settingsMenu.privacyLink} • {UI_EN.settingsMenu.privacyLink}</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </nav>

      <!-- MOBILE TOP BAR -->
      <div class="mobile-edge-fade mobile-edge-fade--top" aria-hidden="true"></div>
      <div class="mobile-edge-fade mobile-edge-fade--bottom" aria-hidden="true"></div>
      <div class="mobile-dot-glass" aria-hidden="true"></div>
      {resolvedShowBack && <div class="mobile-back-glass" aria-hidden="true"></div>}
      <header class={`mobile-topbar ${isHome ? 'is-home' : 'is-centered'} ${resolvedShowBack ? 'has-back' : ''}`} transition:animate="none">
        <div class="mobile-topbar-left">
          {resolvedShowBack && (
            <a href={resolvedBackUrl} class="mobile-back-btn" aria-label={UI_EN.nav.backAria}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="15 18 9 12 15 6" />
              </svg>
            </a>
          )}
        </div>

        <div class="brand">
          <div class="brand-main" lang="ta">
            <span data-ui-ta={mobileMain === routeInfo.title ? `routes.${routeInfo.key}.title` : undefined}>{mobileMain}</span>
            {resolvedBeta && (
              <span style="margin-left: 8px; font-size: 0.65rem; background: color-mix(in srgb, var(--text-main) 14%, transparent); color: var(--text-main); padding: 2px 7px; border-radius: 100px; vertical-align: middle; font-weight: 700; letter-spacing: 0.5px;">
                BETA
              </span>
            )}
          </div>
          {mobileSub && (
            <div class="brand-sub" data-ui-en={mobileSub === routeInfo.subtitle ? `routes.${routeInfo.key}.title` : undefined}>{mobileSub}</div>
          )}
        </div>

        <div class="top-bar-actions">
          <div class="mobile-menu-zone" id="mobile-menu-zone">
            <button type="button" id="mobile-dot-btn" class="top-dot-btn" aria-label="More options" aria-controls="mobile-menu-dropdown" aria-expanded="false">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <circle cx="5" cy="12" r="2" />
                <circle cx="12" cy="12" r="2" />
                <circle cx="19" cy="12" r="2" />
              </svg>
            </button>
          </div>
        </div>
      </header>
      <div id="mobile-menu-backdrop" class="menu-backdrop" style="display: none;"></div>
      <div id="mobile-menu-dropdown" class="top-menu-dropdown" style="display: none; height: 112px;">
              <div id="mobile-menu-track" class="menu-slider-track" style="transform: translateX(0%);">
                <div class="menu-view">
                  <button type="button" id="mobile-appearance-btn" class="menu-item space-between">
                    <span style="display: flex; align-items: center; gap: 12px;">
                      <svg class="menu-icon" viewBox="0 0 24 24" fill="currentColor">
                        <path fill-rule="evenodd" d="M12 2.25c5.385 0 9.75 4.365 9.75 9.75s-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12 6.615 2.25 12 2.25Zm0 1.5v16.5c4.557 0 8.25-3.693 8.25-8.25 0-4.557-3.693-8.25-8.25-8.25Z" clip-rule="evenodd" />
                      </svg>
                      <span>Appearance</span>
                    </span>
                    <svg style="width: 18px; height: 18px; opacity: 0.4;" viewBox="0 0 24 24" fill="currentColor">
                      <path fill-rule="evenodd" d="M16.28 11.47a.75.75 0 0 1 0 1.06l-7.5 7.5a.75.75 0 0 1-1.06-1.06L14.69 12 7.72 5.03a.75.75 0 0 1 1.06-1.06l7.5 7.5Z" clip-rule="evenodd" />
                    </svg>
                  </button>
                  <button type="button" id="mobile-lang-btn" class="menu-item space-between">
                    <span style="display: flex; align-items: center; gap: 12px;">
                      <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m5 8 6 6" />
                        <path d="m4 14 6-6 2-3" />
                        <path d="M2 5h12" />
                        <path d="M7 2h1" />
                        <path d="m22 22-5-10-5 10" />
                        <path d="M14 18h6" />
                      </svg>
                      <span>Script Mode</span>
                    </span>
                    <svg style="width: 18px; height: 18px; opacity: 0.4;" viewBox="0 0 24 24" fill="currentColor">
                      <path fill-rule="evenodd" d="M16.28 11.47a.75.75 0 0 1 0 1.06l-7.5 7.5a.75.75 0 0 1-1.06-1.06L14.69 12 7.72 5.03a.75.75 0 0 1 1.06-1.06l7.5 7.5Z" clip-rule="evenodd" />
                    </svg>
                  </button>
                </div>
                <div class="menu-view">
                  <button type="button" id="mobile-menu-back-btn" class="menu-item back-btn">
                    <svg style="width: 20px; height: 20px;" viewBox="0 0 24 24" fill="currentColor">
                      <path fill-rule="evenodd" d="M7.72 12.53a.75.75 0 0 1 0-1.06l7.5-7.5a.75.75 0 1 1 1.06 1.06L9.31 12l6.97 6.97a.75.75 0 1 1-1.06 1.06l-7.5-7.5Z" clip-rule="evenodd" />
                    </svg>
                    Back
                  </button>
                  <button type="button" class="menu-item" data-theme-choice="auto">Auto System</button>
                  <button type="button" class="menu-item" data-theme-choice="light">Light Mode</button>
                  <button type="button" class="menu-item" data-theme-choice="dark">Dark Mode</button>
                </div>
                <div class="menu-view" data-no-translit>
                  <button type="button" id="mobile-lang-back-btn" class="menu-item back-btn">
                    <svg style="width: 20px; height: 20px;" viewBox="0 0 24 24" fill="currentColor">
                      <path fill-rule="evenodd" d="M7.72 12.53a.75.75 0 0 1 0-1.06l7.5-7.5a.75.75 0 1 1 1.06 1.06L9.31 12l6.97 6.97a.75.75 0 1 1-1.06 1.06l-7.5-7.5Z" clip-rule="evenodd" />
                    </svg>
                    Back
                  </button>
                  <button type="button" class="menu-item" data-lang-choice="bilingual">{UI_TA.settingsMenu.modeBilingual}</button>
                  <button type="button" class="menu-item" data-lang-choice="tanglish-en">Ta+En</button>
                </div>
              </div>
      </div>

      <!-- MAIN CONTENT -->
      <main id="app-main-content" class={`main-content ${!isMainLevel ? 'no-bottom-nav mobile-full-width' : ''}`} style="flex-grow: 1; min-height: 100vh;" transition:animate="none">
        <div class="main-content-body">
          <slot />
          {!hideFooter && <Footer />}
        </div>
      </main>
    </div>

    <script is:inline>
      (function () {
        if (window.__elvanShellInit) return;
        window.__elvanShellInit = true;

        var MAIN_LEVEL_PATHS = [
          '/',
          '/navilgal',
          '/writings',
          '/arts',
          '/about',
          '/portfolio',
          '/settings',
          '/tools',
          '/downloads',
        ];
        var CATEGORIES = ['stories', 'poems', 'quotes', 'blog', 'articles', 'diary', 'thoughts'];

        function normPath(p) {
          return (p || '/').toLowerCase().replace(/\/$/, '') || '/';
        }

        function isBottomTab(p) {
          var n = normPath(p);
          return n === '/' || n === '/navilgal' || n === '/tools' || n === '/downloads' || n === '/about';
        }

        function getTabIndex(p) {
          var n = normPath(p);
          if (n === '/') return 0;
          if (n.indexOf('/navilgal') === 0 || n.indexOf('/writings') === 0 || n.indexOf('/arts') === 0) return 1;
          if (n.indexOf('/tools') === 0 || n.indexOf('/teaching') === 0) return 2;
          if (n.indexOf('/downloads') === 0) return 3;
          if (n.indexOf('/about') === 0) return 4;
          return 99;
        }

        function getPathDepth(p) {
          var n = normPath(p);
          if (n === '/') return 0;
          if (isBottomTab(n)) return 1;
          var hub = ['/writings', '/arts', '/teaching', '/portfolio', '/settings'];
          if (hub.indexOf(n) !== -1) return 2;
          var segs = n.split('/').filter(Boolean);
          if (n.indexOf('/writings') !== -1 || n.indexOf('/arts') !== -1) {
            if (n.indexOf('/series/') !== -1) return 4;
            var last = segs[segs.length - 1];
            var prev = segs[segs.length - 2];
            if (CATEGORIES.indexOf(last) !== -1) return 3;
            if (prev && CATEGORIES.indexOf(prev) !== -1) return 5;
          }
          return segs.length + 1;
        }

        function computeNavClass(fromPath, toPath, directionHint) {
          var f = normPath(fromPath);
          var t = normPath(toPath);
          if (f === t) return 'nav-none';
          if (isBottomTab(f) && isBottomTab(t)) return 'nav-none';
          if (directionHint === 'back') return 'nav-pop';
          var dTo = getPathDepth(t);
          var dFrom = getPathDepth(f);
          if (dTo < dFrom) return 'nav-pop';
          if (dTo > dFrom) return 'nav-push';
          return getTabIndex(t) < getTabIndex(f) ? 'nav-pop' : 'nav-push';
        }

        function getSavedTheme() {
          try { return localStorage.getItem('theme') || 'auto'; } catch (e) { return 'auto'; }
        }

        function getSidebarCollapsed() {
          try { return localStorage.getItem('sidebarCollapsed') === 'true'; } catch (e) { return false; }
        }

        function syncSidebarUiState(collapsed, rootDoc) {
          collapsed = collapsed && window.matchMedia('(min-width: 769px)').matches;
          var doc = rootDoc || document;
          var sidebar = doc.getElementById('app-sidebar');
          var main = doc.getElementById('app-main-content');
          var topZone = doc.getElementById('topbar-sidebar-zone');
          var shell = doc.getElementById('app-shell');
          var toggleBtn = doc.getElementById('topbar-sidebar-toggle');
          var settingsTrigger = doc.getElementById('settings-trigger-btn');
          var settingsPopup = doc.getElementById('settings-popup');

          if (doc.documentElement) {
            doc.documentElement.classList.toggle('sidebar-collapsed-init', collapsed);
          }
          if (sidebar) sidebar.classList.toggle('collapsed', collapsed);
          if (main) main.classList.toggle('sidebar-collapsed', collapsed);
          if (topZone) topZone.classList.toggle('collapsed', collapsed);
          if (shell) shell.classList.toggle('sidebar-collapsed', collapsed);
          if (toggleBtn) {
            var toggleLabel = collapsed ? 'Expand Sidebar' : 'Collapse Sidebar';
            toggleBtn.setAttribute('aria-label', toggleLabel);
            toggleBtn.setAttribute('title', toggleLabel);
          }
          if (settingsTrigger) settingsTrigger.classList.toggle('collapsed-trigger', collapsed);
          if (settingsPopup) settingsPopup.classList.toggle('side-popup', collapsed);

          doc.querySelectorAll('#app-sidebar .nav-item').forEach(function (link) {
            link.classList.toggle('collapsed', collapsed);
          });
        }

        function syncActiveNavItems(pathname, rootDoc) {
          var doc = rootDoc || document;
          var p = normPath(pathname);
          var isHome = p === '/';
          var isNavilgal = p.indexOf('/navilgal') === 0 || p.indexOf('/writings') === 0 || p.indexOf('/arts') === 0;
          var isTools = p.indexOf('/tools') === 0 || p.indexOf('/teaching') === 0;
          var isDownloads = p.indexOf('/downloads') === 0;
          var isAbout = p === '/about';
          var isMain = MAIN_LEVEL_PATHS.indexOf(p) !== -1;

          var sidebar = doc.getElementById('app-sidebar');
          if (sidebar) sidebar.classList.toggle('mobile-hidden-nav', !isMain);
          var main = doc.getElementById('app-main-content');
          if (main) {
            main.classList.toggle('no-bottom-nav', !isMain);
            main.classList.toggle('mobile-full-width', !isMain);
          }

          var map = {
            home: isHome,
            navilgal: isNavilgal,
            tools: isTools,
            downloads: isDownloads,
            about: isAbout,
            'about-mobile': isAbout,
          };
          doc.querySelectorAll('#app-sidebar [data-nav-key]').forEach(function (link) {
            var key = link.getAttribute('data-nav-key');
            var active = Boolean(map[key]);
            link.classList.toggle('active', active);
            if (active) link.setAttribute('aria-current', 'page');
            else link.removeAttribute('aria-current');
            if (key === 'tools') {
              var badge = link.querySelector('.nav-badge');
              if (badge) badge.classList.toggle('is-active-badge', active);
            }
          });
          if (sidebar) sidebar.dispatchEvent(new CustomEvent('elvan:nav-change', { detail: p }));
        }

        function applyTheme(next, rootDoc) {
          var doc = rootDoc || document;
          try { localStorage.setItem('theme', next); } catch (e) {}
          var effective = next === 'auto'
            ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
            : next;
          doc.documentElement.setAttribute('data-theme', effective);
          doc.documentElement.setAttribute('data-theme-mode', next);

          if (doc === document && window.parent && window.parent !== window) {
            window.parent.postMessage({ type: 'IFRAMETHEMECHANGE', appId: 'elvan', isDark: effective === 'dark' }, '*');
          }

          var thumb = doc.getElementById('desktop-slider-thumb');
          if (thumb) {
            thumb.style.transform = 'translateX(' + (next === 'light' ? '0%' : next === 'auto' ? '100%' : '200%') + ')';
          }
          doc.querySelectorAll('[data-theme-choice]').forEach(function (el) {
            var choice = el.getAttribute('data-theme-choice');
            el.classList.toggle('active', choice === next);
            el.classList.toggle('selected', choice === next);
          });
        }

        function bindFloatingNav() {
          var sidebar = document.getElementById('app-sidebar');
          var pill = sidebar?.querySelector('.mobile-nav-pill');
          var track = pill?.parentElement;
          if (!track || track.dataset.floatingNavBound) return;
          track.dataset.floatingNavBound = '1';

          var mobile = window.matchMedia('(max-width: 768px)');
          var links = Array.from(track.querySelectorAll('a[data-nav-key]'));
          var gesture = null;
          var pendingLink = null;
          var activePath = normPath(window.location.pathname);
          var suppressClickUntil = 0;

          links.forEach(function (link) {
            var label = link.querySelector('.label');
            if (!label) return;
            label.id = 'nav-label-' + link.dataset.navKey;
            link.setAttribute('aria-labelledby', label.id);
            link.addEventListener('pointerleave', function () {
              delete link.dataset.tipSuppressed;
            });
          });

          function visibleLinks() {
            return links.filter(function (link) { return link.offsetWidth > 0; });
          }

          function positionPill(link, fingerX) {
            if (!mobile.matches || !track.offsetWidth || !link) return;
            var trackRect = track.getBoundingClientRect();
            var linkRect = link.getBoundingClientRect();
            var width = Math.max(1, linkRect.width - 6);
            var left = linkRect.left - trackRect.left + 3;
            if (fingerX !== undefined) {
              left = Math.max(3, Math.min(trackRect.width - width - 3, fingerX - trackRect.left - width / 2));
            }
            pill.style.setProperty('--pill-width', width + 'px');
            pill.style.setProperty('--pill-x', left + 'px');
            pill.dataset.ready = 'true';
          }

          function syncPill() {
            if (gesture) return;
            var visible = visibleLinks();
            var selected = visible.includes(pendingLink)
              ? pendingLink
              : visible.find(function (link) { return link.classList.contains('active'); });
            if (!selected) delete pill.dataset.ready;
            else positionPill(selected);
          }

          function nearestLink(clientX) {
            return visibleLinks().reduce(function (nearest, link) {
              var rect = link.getBoundingClientRect();
              var distance = Math.abs(clientX - rect.left - rect.width / 2);
              return !nearest || distance < nearest.distance ? { link: link, distance: distance } : nearest;
            }, null)?.link;
          }

          function endGesture(event, cancelled) {
            if (!gesture || gesture.id !== event.pointerId) return;
            var destination = !cancelled && gesture.dragging ? nearestLink(event.clientX) : null;
            gesture = null;
            delete track.dataset.pressing;
            delete track.dataset.dragging;
            if (destination) {
              suppressClickUntil = performance.now() + 400;
              destination.click();
            } else syncPill();
          }

          track.addEventListener('pointerdown', function (event) {
            if (!mobile.matches || !event.isPrimary || event.button !== 0 || event.ctrlKey ||
                event.metaKey || event.shiftKey || event.altKey) return;
            var link = event.target.closest('a[data-nav-key]');
            if (!link) return;
            link.dataset.tipSuppressed = 'true';
            suppressClickUntil = 0;
            gesture = { id: event.pointerId, startX: event.clientX, dragging: false };
            track.dataset.pressing = 'true';
          });
          track.addEventListener('pointermove', function (event) {
            if (!gesture || gesture.id !== event.pointerId) return;
            if (!gesture.dragging) {
              if (Math.abs(event.clientX - gesture.startX) < 8) return;
              gesture.dragging = true;
              track.dataset.dragging = 'true';
              track.setPointerCapture(event.pointerId);
            }
            positionPill(nearestLink(event.clientX), event.clientX);
          });
          window.addEventListener('pointerup', function (event) { endGesture(event, false); });
          window.addEventListener('pointercancel', function (event) { endGesture(event, true); });
          track.addEventListener('lostpointercapture', function (event) {
            if (event.target === track) endGesture(event, true);
          });
          track.addEventListener('dragstart', function (event) {
            if (mobile.matches) event.preventDefault();
          });
          track.addEventListener('click', function (event) {
            if (event.detail && performance.now() < suppressClickUntil) {
              event.preventDefault();
              event.stopPropagation();
              return;
            }
            if (!mobile.matches || event.defaultPrevented || event.button !== 0 ||
                event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
            var link = event.target.closest('a[data-nav-key]');
            if (!link) return;
            pendingLink = link.classList.contains('active') ? null : link;
            positionPill(link);
          }, true);

          sidebar.addEventListener('elvan:nav-change', function (event) {
            if (event.detail !== activePath) pendingLink = null;
            activePath = event.detail;
            syncPill();
          });
          new ResizeObserver(syncPill).observe(track);
          mobile.addEventListener('change', syncPill);
          syncPill();
        }

        function bindPersistentShellEvents() {
          bindFloatingNav();
          var toggleBtn = document.getElementById('topbar-sidebar-toggle');
          if (toggleBtn && !toggleBtn.dataset.bound) {
            toggleBtn.dataset.bound = '1';
            toggleBtn.addEventListener('click', function () {
              var next = !getSidebarCollapsed();
              var shell = document.getElementById('app-shell');
              if (shell) {
                shell.classList.add('animate-layout');
                setTimeout(function () {
                  var s = document.getElementById('app-shell');
                  if (s) s.classList.remove('animate-layout');
                }, 450);
              }
              try { localStorage.setItem('sidebarCollapsed', String(next)); } catch (e) {}
              syncSidebarUiState(next, document);
            });
          }

          var settingsTrigger = document.getElementById('settings-trigger-btn');
          var settingsPopup = document.getElementById('settings-popup');
          var settingsZone = document.getElementById('settings-zone');
          if (settingsTrigger && settingsPopup && !settingsTrigger.dataset.bound) {
            settingsTrigger.dataset.bound = '1';
            settingsTrigger.addEventListener('click', function (e) {
              e.stopPropagation();
              var open = settingsPopup.style.display !== 'none';
              settingsPopup.style.display = open ? 'none' : 'block';
              settingsTrigger.classList.toggle('active-trigger', !open);
            });
            document.addEventListener('mousedown', function (e) {
              if (settingsZone && !settingsZone.contains(e.target)) {
                settingsPopup.style.display = 'none';
                settingsTrigger.classList.remove('active-trigger');
              }
            });
            settingsPopup.querySelectorAll('a').forEach(function (a) {
              a.addEventListener('click', function () {
                settingsPopup.style.display = 'none';
                settingsTrigger.classList.remove('active-trigger');
              });
            });
          }

          document.querySelectorAll('#app-sidebar [data-theme-choice]').forEach(function (el) {
            if (el.dataset.themeBound) return;
            el.dataset.themeBound = '1';
            el.addEventListener('click', function (e) {
              e.stopPropagation();
              var choice = el.getAttribute('data-theme-choice');
              if (choice) applyTheme(choice, document);
            });
          });
        }

        function bindPerPageMobileMenuAndThemes() {
          document.querySelectorAll('main [data-theme-choice], #mobile-menu-dropdown [data-theme-choice]').forEach(function (el) {
            if (el.dataset.themeBound) return;
            el.dataset.themeBound = '1';
            el.addEventListener('click', function (e) {
              e.stopPropagation();
              var choice = el.getAttribute('data-theme-choice');
              if (choice) applyTheme(choice, document);
            });
          });

          var dotBtn = document.getElementById('mobile-dot-btn');
          var backdrop = document.getElementById('mobile-menu-backdrop');
          var dropdown = document.getElementById('mobile-menu-dropdown');
          var track = document.getElementById('mobile-menu-track');
          var appBtn = document.getElementById('mobile-appearance-btn');
          var langBtn = document.getElementById('mobile-lang-btn');
          var backBtn = document.getElementById('mobile-menu-back-btn');
          var langBackBtn = document.getElementById('mobile-lang-back-btn');

          function closeMobileMenu() {
            if (dotBtn) dotBtn.setAttribute('aria-expanded', 'false');
            if (!dropdown) {
              if (backdrop) {
                backdrop.classList.remove('is-entering', 'is-open', 'is-closing');
                backdrop.style.display = 'none';
              }
              return;
            }
            if (dropdown._elvanCloseTimer) {
              clearTimeout(dropdown._elvanCloseTimer);
              dropdown._elvanCloseTimer = 0;
            }
            var wasActive = dropdown.classList.contains('is-open') || dropdown.classList.contains('is-entering');
            if (!wasActive) {
              dropdown.classList.remove('is-closing');
              dropdown.style.display = 'none';
              dropdown.style.height = '112px';
              if (backdrop) {
                backdrop.classList.remove('is-entering', 'is-open', 'is-closing');
                backdrop.style.display = 'none';
              }
              if (track) track.style.transform = 'translateX(0%)';
              return;
            }
            dropdown.classList.remove('is-entering', 'is-open');
            dropdown.classList.add('is-closing');
            if (backdrop) {
              backdrop.classList.remove('is-entering', 'is-open');
              backdrop.classList.add('is-closing');
            }
            dropdown._elvanCloseTimer = window.setTimeout(function () {
              dropdown._elvanCloseTimer = 0;
              dropdown.classList.remove('is-closing', 'is-entering', 'is-open');
              dropdown.style.display = 'none';
              dropdown.style.height = '112px';
              if (backdrop) {
                backdrop.classList.remove('is-closing', 'is-entering', 'is-open');
                backdrop.style.display = 'none';
              }
              if (track) track.style.transform = 'translateX(0%)';
            }, 145);
          }

          if (dotBtn && dropdown && backdrop && !dotBtn.dataset.bound) {
            dotBtn.dataset.bound = '1';
            dotBtn.addEventListener('click', function (e) {
              e.stopPropagation();
              var isOpen = dropdown.classList.contains('is-open') || dropdown.classList.contains('is-entering');
              if (isOpen) {
                closeMobileMenu();
              } else {
                if (dropdown._elvanCloseTimer) {
                  clearTimeout(dropdown._elvanCloseTimer);
                  dropdown._elvanCloseTimer = 0;
                }
                dotBtn.setAttribute('aria-expanded', 'true');
                dropdown.classList.remove('is-closing', 'is-open');
                dropdown.classList.add('is-entering');
                backdrop.classList.remove('is-closing', 'is-open');
                backdrop.classList.add('is-entering');
                dropdown.style.display = 'block';
                backdrop.style.display = 'block';
                if (track) track.style.transform = 'translateX(0%)';
                dropdown.style.height = '112px';
                void dropdown.offsetWidth;
                requestAnimationFrame(function () {
                  if (!dropdown.classList.contains('is-entering')) return;
                  dropdown.classList.remove('is-entering');
                  dropdown.classList.add('is-open');
                  backdrop.classList.remove('is-entering');
                  backdrop.classList.add('is-open');
                });
              }
            });
            backdrop.addEventListener('click', closeMobileMenu);
          }
          if (appBtn && track && dropdown && !appBtn.dataset.bound) {
            appBtn.dataset.bound = '1';
            appBtn.addEventListener('click', function () {
              track.style.transform = 'translateX(-33.3333%)';
              dropdown.style.height = '220px';
            });
          }
          if (langBtn && track && dropdown && !langBtn.dataset.bound) {
            langBtn.dataset.bound = '1';
            langBtn.addEventListener('click', function () {
              track.style.transform = 'translateX(-66.6667%)';
              dropdown.style.height = '168px';
            });
          }
          if (backBtn && track && dropdown && !backBtn.dataset.bound) {
            backBtn.dataset.bound = '1';
            backBtn.addEventListener('click', function () {
              track.style.transform = 'translateX(0%)';
              dropdown.style.height = '112px';
            });
          }
          if (langBackBtn && track && dropdown && !langBackBtn.dataset.bound) {
            langBackBtn.dataset.bound = '1';
            langBackBtn.addEventListener('click', function () {
              track.style.transform = 'translateX(0%)';
              dropdown.style.height = '112px';
            });
          }

          document.querySelectorAll('[data-lang-choice]').forEach(function (el) {
            if (el.dataset.langChoiceBound) return;
            el.dataset.langChoiceBound = '1';
            el.addEventListener('click', function (e) {
              e.stopPropagation();
              var choice = el.getAttribute('data-lang-choice');
              if (choice && window.__elvanSetLangMode) {
                window.__elvanSetLangMode(choice);
              }
            });
          });
        }

        function pushUnloadedAds() {
          document.querySelectorAll('ins.adsbygoogle:not([data-adsbygoogle-status])').forEach(function () {
            try {
              (window.adsbygoogle = window.adsbygoogle || []).push({});
            } catch (e) {}
          });
        }

        var mobileChrome = window.matchMedia('(max-width: 768px)');
        var chromeFrame = 0;

        function hasContentUnderTopHeader(shell) {
          if (window.scrollY <= 4) return false;
          var header = shell.querySelector(':scope > .mobile-topbar');
          var cutoff = (header ? header.getBoundingClientRect().bottom : 64) - 2;
          var body = document.querySelector('#app-main-content .main-content-body');
          if (!body) return false;
          var root = body.firstElementChild || body;
          var targets = root.querySelectorAll('h1, h2, h3, p, blockquote, img, .bento-card, .category-card, .store-app-card, .store-project-card, .dict-card, .about-card, .ms-hero-icon, .ms-hero-title, .variant-header-slot, .expand-pill, .quote-card, .art-card, .poem-card');
          for (var i = 0; i < targets.length; i++) {
            var el = targets[i];
            if (el.offsetHeight <= 0) continue;
            var r = el.getBoundingClientRect();
            if (r.height > 0 && r.bottom > 4 && r.top < cutoff) {
              return true;
            }
          }
          return false;
        }

        function hasContentUnderBottomChrome(shell, main) {
          var hasBottom = (main && !main.classList.contains('no-bottom-nav')) ||
            Boolean(shell.querySelector(':scope > .writing-list-dock'));
          if (!hasBottom) return false;
          var moreBelow = (window.scrollY + window.innerHeight) < (document.documentElement.scrollHeight - 10);
          return moreBelow;
        }

        function syncMobileChrome() {
          chromeFrame = 0;
          var shell = document.getElementById('app-shell');
          if (!shell || !mobileChrome.matches) return;
          var header = shell.querySelector(':scope > .mobile-topbar');
          if (header) {
            var progress = Math.min(1, Math.max(0, (window.scrollY - 12) / 64));
            header.style.setProperty('--mobile-title-opacity', String(1 - progress));
            header.style.setProperty('--mobile-title-offset', (-8 * progress) + 'px');
          }
          var main = document.getElementById('app-main-content');
          var scrolledTop = hasContentUnderTopHeader(shell);
          var bottomNeeded = hasContentUnderBottomChrome(shell, main);
          shell.toggleAttribute('data-mobile-scrolled', scrolledTop);
          shell.toggleAttribute('data-mobile-bottom-fade', bottomNeeded);
        }

        function queueMobileChrome() {
          if (mobileChrome.matches && !chromeFrame) {
            chromeFrame = window.requestAnimationFrame(syncMobileChrome);
          }
        }

        window.addEventListener('scroll', queueMobileChrome, { passive: true });
        window.addEventListener('scrollend', syncMobileChrome, { passive: true });
        window.addEventListener('resize', syncMobileChrome);
        mobileChrome.addEventListener('change', syncMobileChrome);
        mobileChrome.addEventListener('change', function () {
          syncSidebarUiState(getSidebarCollapsed(), document);
        });
        window.addEventListener('pageshow', syncMobileChrome);

        // Initial hydration/load state
        syncSidebarUiState(getSidebarCollapsed(), document);
        syncActiveNavItems(window.location.pathname, document);
        applyTheme(getSavedTheme(), document);
        bindPersistentShellEvents();
        bindPerPageMobileMenuAndThemes();
        syncMobileChrome();
        pushUnloadedAds();

        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function () {
          if (getSavedTheme() === 'auto') applyTheme('auto', document);
        });

        var executedScriptKeys = new Set();
        try {
